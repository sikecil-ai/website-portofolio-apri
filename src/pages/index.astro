---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import Articles from '../components/Articles.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Testimonials from '../components/Testimonials.astro';
import Pricing from '../components/Pricing.astro';
import Skills from '../components/Skills.astro';
import Experience from '../components/Experience.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
import { siteConfig } from '../data/siteConfig';
---

<Layout>
  <!-- 1. Hero Section -->
  <Hero />

  <!-- 2. About / Philosophy Section -->
  <section id="tentang" class="py-20 border-t border-slate-200/60 dark:border-slate-800/60 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-5">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-cyan-50 dark:bg-cyan-950/60 border border-cyan-200 dark:border-cyan-800 text-cyan-600 dark:text-cyan-400 text-xs font-semibold uppercase tracking-wider mb-4">
            👨‍💻 Tentang Kang Apri (@madebyaapri)
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-slate-50 tracking-tight mb-4">
            Dedikasi pada <span class="text-gradient-cyan">Otomasi Nyata &amp; Hasil Terukur</span>
          </h2>
          <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
            {siteConfig.bio}
          </p>
          <p class="text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
            Saya percaya bahwa teknologi terbaik adalah teknologi yang <strong class="text-slate-900 dark:text-slate-100">langsung memangkas beban kerja manual</strong> tanpa membebani keuangan bisnis Anda dengan biaya langganan server bulanan.
          </p>
        </div>

        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <div class="p-6 rounded-3xl glass-card border border-slate-200/80 dark:border-slate-800/80 bg-white/80 dark:bg-slate-900/60">
            <div class="w-10 h-10 rounded-2xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center font-bold text-xl mb-4">
              💰
            </div>
            <h3 class="font-bold text-slate-900 dark:text-slate-100 text-base mb-2">Rp 0 Biaya Server</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              Memanfaatkan kekuatan Google Workspace &amp; Google Apps Script secara maksimal untuk sistem bisnis tangguh tanpa biaya sewa cloud bulanan.
            </p>
          </div>

          <div class="p-6 rounded-3xl glass-card border border-slate-200/80 dark:border-slate-800/80 bg-white/80 dark:bg-slate-900/60">
            <div class="w-10 h-10 rounded-2xl bg-amber-500/10 text-amber-500 flex items-center justify-center font-bold text-xl mb-4">
              ⚡
            </div>
            <h3 class="font-bold text-slate-900 dark:text-slate-100 text-base mb-2">Tabulasi Real-time 0 Detik</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              Sistem penilaian lomba digital KOMANDO yang memangkas waktu rekapitulasi juri LKBB dari hitungan jam menjadi hitungan detik.
            </p>
          </div>

          <div class="p-6 rounded-3xl glass-card border border-slate-200/80 dark:border-slate-800/80 bg-white/80 dark:bg-slate-900/60">
            <div class="w-10 h-10 rounded-2xl bg-blue-500/10 text-blue-500 flex items-center justify-center font-bold text-xl mb-4">
              📊
            </div>
            <h3 class="font-bold text-slate-900 dark:text-slate-100 text-base mb-2">Visual Dashboard Interaktif</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              Integrasi Looker Studio BI untuk memantau tren omset kasir, laba kotor, dan stok bahan baku harian dari layar smartphone Anda.
            </p>
          </div>

          <div class="p-6 rounded-3xl glass-card border border-slate-200/80 dark:border-slate-800/80 bg-white/80 dark:bg-slate-900/60">
            <div class="w-10 h-10 rounded-2xl bg-purple-500/10 text-purple-500 flex items-center justify-center font-bold text-xl mb-4">
              🤖
            </div>
            <h3 class="font-bold text-slate-900 dark:text-slate-100 text-base mb-2">Integrasi AI Cerdas</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              Otomasi pembuatan copywriting dan distribusi konten otomatis ke media sosial menggunakan Python dan Gemini AI API.
            </p>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- 3. Project & System Showcase Section -->
  <ProjectGallery />

  <!-- 4. Articles & Case Studies Section (8 Real Stories) -->
  <Articles />

  <!-- 5. How It Works (3 Langkah Mudah) Section -->
  <HowItWorks />

  <!-- 6. Testimonials & Social Proof Section -->
  <Testimonials />

  <!-- 7. Pricing & Investment Tiers Section -->
  <Pricing />

  <!-- 8. Skills & Tech Stack Section -->
  <Skills />

  <!-- 9. Experience & Living Lab Section -->
  <Experience />

  <!-- 10. FAQ Section -->
  <FAQ />

  <!-- 11. Contact & Direct WhatsApp Section -->
  <Contact />
</Layout>
