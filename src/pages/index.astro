  <Testimonials />

  <!-- Babak 5: The Field Case Studies (Articles & Deep Field Stories) -->
  <Articles />

  <!-- Babak 6: The VIP Closing & Investment (How It Works + Pricing + FAQ + Contact) -->
  <HowItWorks />
  <Pricing />
  <FAQ />
  <Contact />

  <!-- Floating Mobile VIP HUD Bar (Quick Action Shortcut on Smartphone) -->
  <MobileBottomBar />
</Layout>
