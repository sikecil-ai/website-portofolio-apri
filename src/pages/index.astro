---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PainPoints from '../components/PainPoints.astro';
import Comparison from '../components/Comparison.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import AboutSection from '../components/AboutSection.astro';
import Testimonials from '../components/Testimonials.astro';
import Articles from '../components/Articles.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Pricing from '../components/Pricing.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
import MobileBottomBar from '../components/MobileBottomBar.astro';
---

<Layout>
  <!-- Babak 1: The Executive Hero -->
  <Hero />

  <!-- Babak 2: The Radical Contrast (Pain Points & Value Comparison Matrix) -->
  <PainPoints />
  <div class="cv-auto"><Comparison /></div>

  <!-- Babak 3: The Crown Jewels Showroom (5 Flagship Systems Showcase) -->
  <div class="cv-auto"><ProjectGallery /></div>

  <!-- Babak 4: The Verifiable Authority (About INKARSA & Kang Apri + Real Testimonials) -->
  <div class="cv-auto"><AboutSection /></div>
  <div class="cv-auto"><Testimonials /></div>

  <!-- Babak 5: The Field Case Studies (Articles & Deep Field Stories) -->
  <div class="cv-auto"><Articles /></div>

  <!-- Babak 6: The VIP Closing, Onboarding FAQ & Contact -->
  <div class="cv-auto"><HowItWorks /></div>
  <div class="cv-auto"><Pricing /></div>
  <div class="cv-auto"><FAQ /></div>
  <div class="cv-auto"><Contact /></div>

  <!-- Floating Mobile VIP HUD Bar (Quick Action Shortcut on Smartphone) -->
  <MobileBottomBar />
</Layout>
