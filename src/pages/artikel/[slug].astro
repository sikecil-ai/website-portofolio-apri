---
import Layout from '../../layouts/Layout.astro';
import { articles } from '../../data/articles';
import { siteConfig } from '../../data/siteConfig';
import { marked } from 'marked';

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;

const seoProps = {
  title: `${article.title} | Kang Apri (@madebyaapri)`,
  description: article.excerpt,
  canonicalURL: `${siteConfig.url}/artikel/${article.slug}`,
  type: 'article',
};

// Convert markdown to clean semantic HTML
const parsedContent = marked.parse(article.content);

// Filter related articles
const relatedArticles = articles.filter((a) => a.id !== article.id).slice(0, 3);
---

<Layout seo={seoProps}>
  <div class="pt-28 pb-24 relative overflow-hidden">
    <!-- Ambient Glows -->
    <div class="ambient-glow bg-purple-500/15 top-20 -left-20 w-96 h-96 animate-pulse-glow"></div>
    <div class="ambient-glow bg-brand-500/10 top-1/2 -right-20 w-96 h-96 animate-pulse-glow" style="animation-delay: 2s;"></div>

    <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Back Navigation Link -->
      <div class="mb-8">
        <a
          href="/#artikel"
          class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-slate-500 hover:text-brand-600 dark:hover:text-brand-400 transition-colors"
        >
          <span>← Kembali ke Semua Artikel &amp; Sistem</span>
        </a>
      </div>

      <!-- Article Header -->
      <header class="mb-10 pb-8 border-b border-slate-200 dark:border-slate-800">
        <div class="flex items-center gap-2.5 mb-4 flex-wrap">
          <span class="text-3xl">{article.coverEmoji}</span>
          <span class="px-3 py-1 text-xs font-semibold rounded-full bg-purple-50 dark:bg-purple-950/70 text-purple-600 dark:text-purple-400 border border-purple-200 dark:border-purple-800">
            {article.category}
          </span>
          <span class="text-xs text-slate-500 dark:text-slate-400 font-mono">• {article.readTime}</span>
          <span class="text-xs text-slate-500 dark:text-slate-400 font-mono">• Tahun {article.date}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-slate-50 tracking-tight leading-[1.2] mb-6">
          {article.title}
        </h1>

        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed italic mb-6">
          "{article.excerpt}"
        </p>

        <!-- Author Byline -->
        <div class="flex items-center gap-3.5 pt-4">
          <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-brand-600 via-purple-600 to-cyan-500 p-0.5 shadow-md flex-shrink-0">
            <div class="w-full h-full bg-slate-950 rounded-[14px] flex items-center justify-center text-white font-bold text-xs font-mono">
              mba
            </div>
          </div>
          <div>
            <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">Muhammad Apriyanto Wijaya (Kang Apri)</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">@madebyaapri • Workflow Automation Specialist &amp; 17 Th. Pembina Paskibra Cimahi</p>
          </div>
        </div>
      </header>

      <!-- Article Main Body (Rendered Clean Semantic HTML) -->
      <div
        class="article-body prose dark:prose-invert max-w-none text-slate-700 dark:text-slate-300 text-base sm:text-lg leading-relaxed font-sans mb-12"
        set:html={parsedContent}
      />

      <!-- Tags -->
      <div class="pt-6 border-t border-slate-200 dark:border-slate-800 mb-12">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Kata Kunci &amp; Topik</h4>
        <div class="flex flex-wrap gap-2">
          {article.tags.map((tag) => (
            <span class="px-3 py-1 text-xs font-medium rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700/80">
              #{tag}
            </span>
          ))}
        </div>
      </div>

      <!-- Bottom WhatsApp CTA Box -->
      <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-br from-brand-600/15 via-purple-600/10 to-emerald-600/15 border border-brand-500/30 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left mb-16">
        <div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-2">
            Ingin Menerapkan Solusi Ini di Bisnis / Organisasi Anda?
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-md">
            Konsultasikan alur kerja unik Anda langsung dengan Kang Apri. Bebas biaya sewa server, pengerjaan cepat 3-7 hari.
          </p>
        </div>
        <a
          href={`https://wa.me/6282118313655?text=${encodeURIComponent(`Halo Kang Apri, saya baru saja membaca artikel "${article.title}" dan tertarik berkonsultasi mengenai solusi ini.`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary py-3.5 px-6 whitespace-nowrap shadow-lg shadow-brand-500/25"
        >
          <span class="text-base">💬</span>
          <span>Konsultasi via WhatsApp</span>
        </a>
      </div>

      <!-- Related Articles Section -->
      {relatedArticles.length > 0 && (
        <div class="pt-10 border-t border-slate-200 dark:border-slate-800">
          <h3 class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-6">Cerita Studi Kasus Lainnya</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedArticles.map((rel) => (
              <a
                href={`/artikel/${rel.slug}`}
                class="glass-card rounded-2xl p-5 border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/60 block group hover:border-purple-500/50 transition-all"
              >
                <span class="text-2xl block mb-2">{rel.coverEmoji}</span>
                <span class="text-[10px] font-semibold text-purple-600 dark:text-purple-400 block mb-1">{rel.category}</span>
                <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors line-clamp-2 mb-2">
                  {rel.title}
                </h4>
                <span class="text-[11px] text-brand-600 font-semibold">Baca Cerita →</span>
              </a>
            ))}
          </div>
        </div>
      )}

    </article>
  </div>
</Layout>

<style is:global>
  .article-body h2 {
    font-size: 1.5rem;
    font-weight: 800;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: inherit;
    line-height: 1.3;
  }
  .article-body h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    color: inherit;
    line-height: 1.3;
  }
  .article-body p {
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }
  .article-body strong {
    font-weight: 700;
    color: inherit;
  }
  .article-body ol, .article-body ul {
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .article-body ol {
    list-style-type: decimal;
  }
  .article-body ul {
    list-style-type: disc;
  }
  .article-body li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }
  .article-body hr {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid rgba(148, 163, 184, 0.2);
  }
  .article-body blockquote {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-left: 4px solid #8b5cf6;
    background: rgba(139, 92, 246, 0.08);
    border-radius: 0 1rem 1rem 0;
    font-style: normal;
  }
</style>
