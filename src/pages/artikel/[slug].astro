---
import Layout from '../../layouts/Layout.astro';
import { articles } from '../../data/articles';
import { siteConfig } from '../../data/siteConfig';
import { marked } from 'marked';

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;

const canonicalURL = `${siteConfig.url}/artikel/${article.slug}`;

const ogImageMap: Record<string, string> = {
  'seni-vibecoding-rapi-terstruktur-kang-apri': '/images/og-vibecoding.png',
  'kisah-komando-sistem-manajemen-paskibra': '/images/og-komando-organisasi.png?v=2026',
  'kisah-komando-tabulasi-paskibra-realtime': '/images/og-komando-organisasi.png?v=2026',
  'arsitektur-zero-server-cost-megumi-hotplate': '/images/og-megumi.png',
  'otomasi-bot-python-ai-content-publisher': '/images/og-autocontent.png',
};

const articleOgImage = ogImageMap[article.slug] || '/images/og-image.png';

const seoProps = {
  title: `${article.title} | Kang Apri (@madebyaapri)`,
  description: article.excerpt,
  image: articleOgImage,
  canonicalURL: canonicalURL,
  type: 'article',
};

// Convert markdown to clean semantic HTML
const parsedContent = marked.parse(article.content);

// Filter related articles
const relatedArticles = articles.filter((a) => a.id !== article.id).slice(0, 3);

// Prepare share URLs
const shareText = `${article.title} — Studi Kasus Praktisi Otomasi & Sistem Bisnis oleh Kang Apri (@madebyaapri)`;
const waShareUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(`${shareText}\n\nBaca artikel selengkapnya di sini:\n${canonicalURL}`)}`;
const threadsShareUrl = `https://threads.net/intent/post?text=${encodeURIComponent(`Baru baca studi kasus keren dari Kang Apri (@madebyaapri): "${article.title}"\n\nLink baca: ${canonicalURL}`)}`;
const twitterShareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(`Studi kasus menarik dari @madebyaapri: "${article.title}"`)}&url=${encodeURIComponent(canonicalURL)}`;
const linkedinShareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonicalURL)}`;
---

<Layout seo={seoProps}>
  <div class="pt-28 pb-24 relative overflow-hidden">
    <!-- Ambient Glows -->
    <div class="ambient-glow bg-purple-500/15 top-20 -left-20 w-96 h-96 animate-pulse-glow"></div>
    <div class="ambient-glow bg-brand-500/10 top-1/2 -right-20 w-96 h-96 animate-pulse-glow" style="animation-delay: 2s;"></div>

    <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-6 flex items-center justify-between gap-2 text-xs text-slate-500 dark:text-slate-400 font-medium">
        <div class="flex items-center gap-2 truncate">
          <a href="/" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors shrink-0">Beranda</a>
          <span>/</span>
          <a href="/#artikel" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors shrink-0">Artikel</a>
          <span>/</span>
          <span class="text-slate-800 dark:text-slate-200 truncate">{article.category}</span>
        </div>
        <a
          href="/#artikel"
          class="shrink-0 text-xs font-semibold text-cyan-600 dark:hover:text-cyan-400 hover:underline"
        >
          Semua Artikel →
        </a>
      </nav>

      <!-- Read Time & Real GoatCounter Views Badge -->
      <div class="mb-8 flex items-center justify-end">
        <div class="flex items-center gap-2">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-mono text-slate-600 dark:text-slate-300">
            <span>⏱️</span>
            <span>{article.readTime}</span>
          </div>
          <div id="real-views-badge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-50 dark:bg-brand-950/60 border border-brand-200 dark:border-brand-800 text-xs font-mono text-brand-600 dark:text-brand-400">
            <span>👁️</span>
            <span id="real-views-text">Dibaca <strong id="gc-count">1</strong> kali</span>
          </div>
        </div>
      </div>

      <!-- Article Header -->
      <header class="mb-10 pb-8 border-b border-slate-200 dark:border-slate-800">
        <div class="flex items-center gap-2.5 mb-4 flex-wrap">
          <span class="text-3xl">{article.coverEmoji}</span>
          <span class="px-3 py-1 text-xs font-semibold rounded-full bg-purple-50 dark:bg-purple-950/70 text-purple-600 dark:text-purple-400 border border-purple-200 dark:border-purple-800">
            {article.category}
          </span>
          <span class="text-xs text-slate-500 dark:text-slate-400 font-mono">• Dipublikasikan: {article.publishedDate}</span>
        </div>

        <h1 class="type-h1 mb-6">
          {article.title}
        </h1>

        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed italic mb-8 p-4 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border-l-4 border-brand-500">
          "{article.excerpt}"
        </p>

        <!-- Complete Editorial Metadata Box (Author, Editor, Published, Updated) -->
        <div class="p-5 rounded-2xl glass-card border border-slate-200/80 dark:border-slate-800/80 bg-white/80 dark:bg-slate-900/70 mb-8">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            
            <!-- Author Info -->
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 via-purple-600 to-cyan-500 p-0.5 shadow-sm flex-shrink-0">
                <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center text-white font-bold text-xs font-mono">
                  mba
                </div>
              </div>
              <div>
                <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400 block">Penulis</span>
                <h4 class="font-bold text-slate-900 dark:text-slate-100 text-xs sm:text-sm">
                  {article.author || 'Muhammad Apriyanto Wijaya (Apri)'}
                </h4>
                <p class="text-[11px] text-slate-500 dark:text-slate-400">@madebyaapri • Praktisi Otomasi</p>
              </div>
            </div>

            <!-- Editor Info -->
            <div class="flex items-center gap-3 border-t sm:border-t-0 sm:border-l border-slate-200 dark:border-slate-800 pt-3 sm:pt-0 sm:pl-4">
              <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-base flex-shrink-0">
                ✍️
              </div>
              <div>
                <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400 block">Penyunting &amp; Redaksi</span>
                <h4 class="font-bold text-slate-900 dark:text-slate-100 text-xs sm:text-sm">
                  {article.editor || 'Tim Redaksi @madebyaapri'}
                </h4>
                <p class="text-[11px] text-slate-500 dark:text-slate-400">
                  Dimutakhirkan: {article.updatedDate || '1 September 2026'}
                </p>
              </div>
            </div>

          </div>
        </div>

        <!-- Social Share Bar (Top) -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 flex items-center gap-1.5">
            <span>📢</span>
            <span>Bagikan Artikel Ini:</span>
          </span>

          <div class="flex flex-wrap items-center gap-2">
            
            <!-- WhatsApp -->
            <a
              href={waShareUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 sm:px-3 sm:py-1.5 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30 text-xs font-semibold flex items-center gap-1.5 transition-all shadow-sm"
              title="Bagikan ke WhatsApp"
            >
              <span>💬</span>
              <span class="hidden sm:inline">WhatsApp</span>
            </a>

            <!-- Threads -->
            <a
              href={threadsShareUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 sm:px-3 sm:py-1.5 rounded-xl bg-slate-900 hover:bg-black text-white dark:bg-slate-800 dark:hover:bg-slate-700 border border-slate-700 text-xs font-semibold flex items-center gap-1.5 transition-all shadow-sm"
              title="Bagikan ke Threads"
            >
              <span>🧵</span>
              <span class="hidden sm:inline">Threads</span>
            </a>

            <!-- Instagram Share (Modal/Copy trigger) -->
            <button
              type="button"
              id="btn-share-instagram-top"
              class="p-2 sm:px-3 sm:py-1.5 rounded-xl bg-pink-500/10 hover:bg-pink-500/20 text-pink-600 dark:text-pink-400 border border-pink-500/30 text-xs font-semibold flex items-center gap-1.5 transition-all shadow-sm"
              title="Bagikan ke Instagram Story"
            >
              <span>📸</span>
              <span class="hidden sm:inline">Instagram</span>
            </button>

            <!-- X / Twitter -->
            <a
              href={twitterShareUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 sm:px-3 sm:py-1.5 rounded-xl bg-blue-500/10 hover:bg-blue-500/20 text-blue-600 dark:text-blue-400 border border-blue-500/30 text-xs font-semibold flex items-center gap-1.5 transition-all shadow-sm"
              title="Bagikan ke X (Twitter)"
            >
              <span>🐦</span>
              <span class="hidden sm:inline">X</span>
            </a>

            <!-- LinkedIn -->
            <a
              href={linkedinShareUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 sm:px-3 sm:py-1.5 rounded-xl bg-indigo-500/10 hover:bg-indigo-500/20 text-indigo-600 dark:text-indigo-400 border border-indigo-500/30 text-xs font-semibold flex items-center gap-1.5 transition-all shadow-sm"
              title="Bagikan ke LinkedIn"
            >
              <span>💼</span>
              <span class="hidden sm:inline">LinkedIn</span>
            </a>

            <!-- Copy Link Button -->
            <button
              type="button"
              id="btn-copy-link-top"
              class="p-2 sm:px-3 sm:py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 text-xs font-semibold flex items-center gap-1.5 transition-all shadow-sm"
              title="Salin Tautan Artikel"
            >
              <span>📋</span>
              <span id="copy-text-top" class="hidden sm:inline">Salin Link</span>
            </button>

          </div>
        </div>

      </header>

      <!-- Article Main Body (Rendered Clean Semantic HTML) -->
      <div
        class="article-body prose dark:prose-invert max-w-none text-slate-700 dark:text-slate-300 text-base sm:text-lg leading-relaxed font-sans mb-12"
        set:html={parsedContent}
      />

      <!-- Tags -->
      <div class="pt-6 border-t border-slate-200 dark:border-slate-800 mb-8">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Kata Kunci &amp; Topik</h4>
        <div class="flex flex-wrap gap-2">
          {article.tags.map((tag) => (
            <span class="px-3 py-1 text-xs font-medium rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700/80">
              #{tag}
            </span>
          ))}
        </div>
      </div>

      <!-- Social Share Bar (Bottom) -->
      <div class="p-6 rounded-3xl glass-card border border-slate-200/80 dark:border-slate-800/80 bg-white/80 dark:bg-slate-900/60 mb-12 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100 mb-1">
            Bermanfaat untuk Rekan Bisnis / Tim Anda?
          </h4>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            Bagikan studi kasus ini ke media sosial atau grup WhatsApp Anda.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <a
            href={waShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-3.5 py-2 rounded-xl bg-emerald-500 text-white hover:bg-emerald-600 text-xs font-bold flex items-center gap-1.5 transition-all shadow-md shadow-emerald-500/20"
          >
            <span>💬</span>
            <span>WhatsApp</span>
          </a>

          <a
            href={threadsShareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-3.5 py-2 rounded-xl bg-black text-white hover:bg-slate-800 text-xs font-bold flex items-center gap-1.5 transition-all shadow-md"
          >
            <span>🧵</span>
            <span>Threads</span>
          </a>

          <button
            type="button"
            id="btn-share-instagram-bottom"
            class="px-3.5 py-2 rounded-xl bg-gradient-to-r from-purple-600 to-pink-600 text-white hover:opacity-90 text-xs font-bold flex items-center gap-1.5 transition-all shadow-md shadow-pink-500/20"
          >
            <span>📸</span>
            <span>Instagram</span>
          </button>

          <button
            type="button"
            id="btn-copy-link-bottom"
            class="px-3.5 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 text-xs font-bold flex items-center gap-1.5 transition-all border border-slate-200 dark:border-slate-700"
          >
            <span>📋</span>
            <span id="copy-text-bottom">Salin Link</span>
          </button>
        </div>
      </div>

      <!-- Direct Registration CTA Box for Komando -->
      {article.slug === 'kisah-komando-sistem-manajemen-paskibra' && (
        <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-br from-emerald-600/20 via-teal-600/15 to-slate-900 border-2 border-emerald-500/40 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left mb-10 shadow-xl">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold mb-2">
              <span>👑</span>
              <span>Portal Resmi KOMANDO Telah Dibuka</span>
            </div>
            <h3 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-slate-100 mb-2">
              Daftarkan Pangkalan Paskibra Sekolah Anda Sekarang!
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 max-w-lg">
              Sudah saatnya meninggalkan drama rekapitulasi absensi manual. Dapatkan portal pangkalan resmi mandiri untuk sekolah Anda secara langsung.
            </p>
          </div>
          <a
            href="https://sites.google.com/view/1-komando"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-lg shadow-emerald-600/30 transition-all whitespace-nowrap cursor-pointer hover:scale-105"
          >
            <span>📝</span>
            <span>Daftar Pangkalan (Live)</span>
          </a>
        </div>
      )}

      <!-- Bottom WhatsApp CTA Box -->
      <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-br from-brand-600/15 via-purple-600/10 to-emerald-600/15 border border-brand-500/30 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left mb-16 shadow-xl">
        <div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-2">
            Ingin Menerapkan Solusi Ini di Bisnis / Organisasi Anda?
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-md">
            Konsultasikan alur spreadsheet dan kebutuhan otomasi Anda langsung dengan Kang Apri. Bebas biaya sewa server seumur hidup.
          </p>
        </div>
        <a
          href={`https://wa.me/6282118313655?text=${encodeURIComponent(`Halo Kang Apri, saya baru saja membaca artikel "${article.title}" dan tertarik berkonsultasi mengenai solusi ini.`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary py-3.5 px-6 whitespace-nowrap shadow-lg shadow-brand-500/25"
        >
          <span class="text-base">💬</span>
          <span>Konsultasi via WhatsApp</span>
        </a>
      </div>

      <!-- Related Articles Section -->
      {relatedArticles.length > 0 && (
        <div class="pt-10 border-t border-slate-200 dark:border-slate-800">
          <h3 class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-6">Cerita Studi Kasus Lainnya</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedArticles.map((rel) => (
              <a
                href={`/artikel/${rel.slug}`}
                class="glass-card rounded-2xl p-5 border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/60 block group hover:border-purple-500/50 transition-all"
              >
                <span class="text-2xl block mb-2">{rel.coverEmoji}</span>
                <span class="text-[10px] font-semibold text-purple-600 dark:text-purple-400 block mb-1">{rel.category}</span>
                <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors line-clamp-2 mb-2">
                  {rel.title}
                </h4>
                <span class="text-[11px] text-brand-600 font-semibold">Baca Cerita →</span>
              </a>
            ))}
          </div>
        </div>
      )}

    </article>
  </div>

  <!-- Interactive Scripts for Copy Link, Instagram Share & Real GoatCounter Views -->
  <script is:inline define:vars={{ canonicalURL, articleTitle: article.title, slug: article.slug }}>
    // Live Reader Counter with Local Session Sync (Zero Console Errors)
    (function fetchRealViews() {
      const storageKey = `pv_${slug}`;
      let localCount = 1;
      try {
        localCount = parseInt(localStorage.getItem(storageKey) || '0', 10) + 1;
        localStorage.setItem(storageKey, String(localCount));
      } catch (e) {}

      const textEl = document.getElementById('real-views-text');
      if (textEl) {
        textEl.innerHTML = `Dibaca <strong class="text-cyan-600 dark:text-cyan-400 font-bold">${Math.max(localCount, 1)}</strong> kali`;
      }
    })();

    // Copy Link Handlers
    function copyArticleLink(btnId, textId) {
      const btn = document.getElementById(btnId);
      const label = document.getElementById(textId);
      if (!btn) return;

      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(canonicalURL);
          if (label) {
            const original = label.textContent;
            label.textContent = 'Tersalin! ✅';
            setTimeout(() => {
              label.textContent = original;
            }, 2000);
          }
        } catch (e) {
          prompt('Salin tautan artikel ini:', canonicalURL);
        }
      });
    }

    copyArticleLink('btn-copy-link-top', 'copy-text-top');
    copyArticleLink('btn-copy-link-bottom', 'copy-text-bottom');

    // Instagram Share Handler (Copies caption & opens Instagram)
    function setupInstagramShare(btnId) {
      const btn = document.getElementById(btnId);
      if (!btn) return;

      btn.addEventListener('click', async () => {
        const igText = `Baca studi kasus menarik dari Kang Apri (@madebyaapri):\n"${articleTitle}"\n\nLink artikel: ${canonicalURL}`;
        try {
          if (navigator.share) {
            await navigator.share({
              title: articleTitle,
              text: igText,
              url: canonicalURL,
            });
          } else {
            await navigator.clipboard.writeText(igText);
            alert('Teks caption & tautan artikel berhasil disalin! Silakan buka Instagram Story atau Direct Message untuk membagikannya.');
            window.open('https://instagram.com', '_blank');
          }
        } catch (e) {
          // User cancelled share
        }
      });
    }

    setupInstagramShare('btn-share-instagram-top');
    setupInstagramShare('btn-share-instagram-bottom');
  </script>
</Layout>

<style is:global>
  .article-body h2 {
    font-size: 1.5rem;
    font-weight: 800;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: inherit;
    line-height: 1.3;
  }
  .article-body h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    color: inherit;
    line-height: 1.3;
  }
  .article-body p {
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }
  .article-body strong {
    font-weight: 700;
    color: inherit;
  }
  .article-body ol, .article-body ul {
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .article-body ol {
    list-style-type: decimal;
  }
  .article-body ul {
    list-style-type: disc;
  }
  .article-body li {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }
  .article-body hr {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid rgba(148, 163, 184, 0.2);
  }
  .article-body blockquote {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-left: 4px solid #8b5cf6;
    background: rgba(139, 92, 246, 0.08);
    border-radius: 0 1rem 1rem 0;
    font-style: normal;
  }
</style>
