---
import Layout from '../../layouts/Layout.astro';
import { komandoDocs } from '../../data/komandoDocs';
import { siteConfig } from '../../data/siteConfig';

const canonicalURL = `${siteConfig.url}/dokumentasi/komando`;

const seoProps = {
  title: 'Dokumentasi Resmi & Panduan Lengkap Sistem KOMANDO | Kang Apri (@madebyaapri)',
  description: 'Pusat panduan teknis operasional KOMANDO: alur pendaftaran pangkalan, onboarding 4 tingkat hak akses, 16 modul fitur lapangan, dan solusi mandiri kendala (troubleshooting).',
  image: '/images/og-komando-organisasi.png?v=2026',
  canonicalURL: canonicalURL,
  type: 'article',
};
---

<Layout seo={seoProps}>
  <!-- Print Only Header (Visible only when user clicks Cetak/Simpan PDF) -->
  <div class="hidden print:block mb-8 pb-4 border-b-2 border-slate-900 text-slate-900">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-xl font-black uppercase tracking-tight">Dokumen Panduan Resmi Sistem KOMANDO</h1>
        <p class="text-xs text-slate-600 font-medium">Buku Manual Operasional Pangkalan Satuan Paskibra • Multi-Tenant SSOT Edition</p>
      </div>
      <div class="text-right text-xs">
        <p class="font-bold">Versi: {komandoDocs.meta.version}</p>
        <p class="text-slate-500">Terbit: {komandoDocs.meta.lastUpdated}</p>
      </div>
    </div>
    <div class="mt-2 text-[10px] text-slate-500 italic">
      Dokumen ini dicetak otomatis dari portal dokumentasi resmi: madebyaapri.vercel.app/dokumentasi/komando
    </div>
  </div>

  <div class="pt-20 sm:pt-24 pb-20 relative bg-[#fafcff] dark:bg-[#070b14] print:bg-white print:pt-0 print:pb-0">
    <!-- Ambient Background Glows (Disimpan dalam layer terisolasi agar tidak merusak position:sticky) -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none z-0 no-print" aria-hidden="true">
      <div class="ambient-glow bg-cyan-500/10 top-20 -left-20 w-80 h-80 sm:w-96 sm:h-96 animate-pulse-glow"></div>
      <div class="ambient-glow bg-amber-500/10 top-1/2 -right-20 w-96 h-96 animate-pulse-glow" style="animation-delay: 2s;"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Breadcrumb & Top Bar -->
      <div class="no-print mb-6">
        <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 font-medium mb-4 flex-wrap">
          <a href="/" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Beranda</a>
          <span>/</span>
          <a href="/#proyek" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Etalase Sistem</a>
          <span>/</span>
          <a href="/sistem/komando-sistem-manajemen-paskibra" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">KOMANDO</a>
          <span>/</span>
          <span class="text-slate-900 dark:text-slate-100 font-bold truncate">Pusat Dokumentasi Resmi</span>
        </nav>

        <!-- Header Card -->
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900/90 border-2 border-slate-200/90 dark:border-slate-800 shadow-sm relative overflow-hidden">
          <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
            <div class="space-y-2.5 max-w-3xl">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider bg-amber-100 dark:bg-amber-950/80 text-amber-800 dark:text-amber-300 border border-amber-300 dark:border-amber-800">
                  {komandoDocs.meta.version}
                </span>
                <span class="px-3 py-1 rounded-full text-xs font-bold bg-cyan-100 dark:bg-cyan-950/80 text-cyan-800 dark:text-cyan-300 border border-cyan-300 dark:border-cyan-800">
                  {komandoDocs.meta.totalModules} Modul Terintegrasi
                </span>
                <span class="px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800">
                  Pembaruan: {komandoDocs.meta.lastUpdated}
                </span>
              </div>
              <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 dark:text-slate-100 tracking-tight leading-tight">
                Pusat Dokumentasi &amp; Buku Manual Resmi KOMANDO
              </h1>
              <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
                Panduan komprehensif mulai dari pendaftaran pangkalan, tata kelola 4 tingkat akun, cara pakai seluruh 16 modul operasional, hingga pemecahan masalah teknis mandiri.
              </p>
            </div>

            <!-- Action Buttons Toolbar -->
            <div class="flex flex-col sm:flex-row lg:flex-col gap-2.5 shrink-0">
              <button
                type="button"
                id="btn-print-docs"
                class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl font-bold text-xs sm:text-sm text-slate-950 bg-amber-400 hover:bg-amber-300 shadow-[0_4px_0_#d97706] transition-transform active:translate-y-[1px] active:shadow-none cursor-pointer text-center"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                </svg>
                <span>Cetak / Unduh PDF Panduan</span>
              </button>

              <a
                href="/sistem/komando-sistem-manajemen-paskibra"
                class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-2xl font-bold text-xs sm:text-sm text-cyan-700 dark:text-cyan-300 bg-cyan-50 dark:bg-cyan-950/50 border border-cyan-300 dark:border-cyan-800 hover:bg-cyan-100 dark:hover:bg-cyan-900/50 transition-colors text-center"
              >
                <span>← Kembali ke Showcase Sistem</span>
              </a>
            </div>
          </div>

          <!-- Quick Search Filter Bar -->
          <div class="mt-6 pt-5 border-t border-slate-200 dark:border-slate-800">
            <div class="relative max-w-2xl">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </div>
              <input
                type="text"
                id="docs-search-input"
                placeholder="Cari topik atau modul (contoh: 'presensi', 'nra', 'kuota', 'surat', 'buku hitam')..."
                class="w-full pl-10 pr-10 py-2.5 rounded-xl text-xs sm:text-sm bg-slate-50 dark:bg-slate-800/80 border border-slate-300 dark:border-slate-700 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-transparent transition-all"
              />
              <button
                type="button"
                id="docs-search-clear"
                class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
            <div id="search-status" class="mt-2 text-xs text-slate-500 dark:text-slate-400 hidden"></div>
          </div>
        </div>
      </div>

      <!-- Mobile Sticky Chapter Nav Bar (Muncul di layar HP agar daftar isi tidak hilang saat scroll) -->
      <div class="no-print lg:hidden sticky top-16 z-30 -mx-4 px-4 py-2 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-y border-slate-200 dark:border-slate-800 shadow-sm mb-6">
        <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5">
          <span class="text-[10px] font-bold text-slate-400 shrink-0 uppercase tracking-wider pl-1">Bab:</span>
          {komandoDocs.chapters.map((ch) => (
            <a
              href={`#${ch.id}`}
              class="mobile-toc-link shrink-0 inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 hover:bg-cyan-50 dark:hover:bg-cyan-950/60 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors whitespace-nowrap"
              data-target={ch.id}
            >
              <span>{ch.icon}</span>
              <span>{ch.badge}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Main Layout: Sidebar Navigation + Content Pane -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left Column: Sticky Table of Contents (Desktop Permanent Stay) -->
        <aside class="no-print hidden lg:block lg:col-span-4 xl:col-span-3 sticky top-24 self-start max-h-[calc(100vh-7rem)] overflow-y-auto rounded-3xl bg-white dark:bg-slate-900/90 border-2 border-slate-200/90 dark:border-slate-800 p-5 shadow-sm space-y-4 z-20">
          <div class="flex items-center justify-between pb-3 border-b border-slate-200 dark:border-slate-800">
            <span class="text-xs font-black uppercase tracking-wider text-slate-500 dark:text-slate-400">Daftar Isi Bab</span>
            <span class="text-[11px] font-bold text-cyan-600 dark:text-cyan-400">{komandoDocs.chapters.length} Bab</span>
          </div>

          <nav class="space-y-1.5" id="toc-nav">
            {komandoDocs.chapters.map((ch) => (
              <a
                href={`#${ch.id}`}
                class="toc-link group flex items-start gap-2.5 p-2.5 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-cyan-600 dark:hover:text-cyan-400 hover:bg-slate-50 dark:hover:bg-slate-800/80 transition-all"
                data-target={ch.id}
              >
                <span class="text-base shrink-0 group-hover:scale-110 transition-transform">{ch.icon}</span>
                <div class="min-w-0">
                  <span class="block truncate font-bold text-slate-900 dark:text-slate-100 group-hover:text-cyan-600 dark:group-hover:text-cyan-400">{ch.title}</span>
                  <span class="block text-[10px] text-slate-400 dark:text-slate-500 truncate">{ch.badge}</span>
                </div>
              </a>
            ))}
          </nav>

          <div class="pt-4 border-t border-slate-200 dark:border-slate-800">
            <div class="p-3 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900/60 text-center">
              <span class="text-base block mb-1">💡</span>
              <p class="text-[11px] font-bold text-amber-900 dark:text-amber-200 mb-1">Prinsip Mandiri</p>
              <p class="text-[10px] text-amber-700 dark:text-amber-400">
                Cari solusi kendala di Bab 5 sebelum menghubungi layanan teknis pengembang.
              </p>
            </div>
          </div>
        </aside>

        <!-- Right Column: Comprehensive Content Sections -->
        <main class="lg:col-span-8 xl:col-span-9 space-y-12">
          
          <!-- ============================================================ -->
          <!-- BAB 1: ARSITEKTUR & IKHTISAR SISTEM                         -->
          <!-- ============================================================ -->
          <section id="arsitektur" class="doc-section rounded-3xl bg-white dark:bg-slate-900/80 border-2 border-slate-200/90 dark:border-slate-800 p-6 sm:p-8 shadow-sm relative scroll-mt-24">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-black uppercase tracking-wider bg-cyan-100 dark:bg-cyan-950 text-cyan-800 dark:text-cyan-300 border border-cyan-300 dark:border-cyan-800">
                Bab 1
              </span>
              <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Dasar Arsitektur</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-slate-100 tracking-tight mb-3">
              🏛️ Ikhtisar Sistem &amp; Arsitektur Cloud Multi-Tenant
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
              KOMANDO dirancang khusus untuk mendigitalkan seluruh siklus hidup ekstrakurikuler Paskibra sekolah dan organisasi kepemudaan. Berbeda dengan aplikasi konvensional yang membutuhkan server VPS bulanan mahal, KOMANDO berjalan di atas komputasi awan Google Cloud tanpa biaya server selamanya (Rp 0).
            </p>

            <!-- 3 Pillars Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
              <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700">
                <div class="text-cyan-500 font-black text-lg mb-1">01. Google Cloud</div>
                <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-slate-100 mb-1">Google Apps Script Engine</h3>
                <p class="text-[11px] text-slate-600 dark:text-slate-400 leading-normal">
                  Logika serverless backend terdistribusi yang mengeksekusi routing, autentikasi multi-tenant, dan kalkulasi rapor secara otomatis.
                </p>
              </div>

              <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700">
                <div class="text-emerald-500 font-black text-lg mb-1">02. Relational SSOT</div>
                <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-slate-100 mb-1">Google Sheets Database</h3>
                <p class="text-[11px] text-slate-600 dark:text-slate-400 leading-normal">
                  Penyimpanan 16 tab data terelasi langsung di Google Drive milik pangkalan sekolah, sehingga kepemilikan data 100% mandiri dan aman.
                </p>
              </div>

              <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700">
                <div class="text-amber-500 font-black text-lg mb-1">03. Dual Display</div>
                <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-slate-100 mb-1">Mobile PWA &amp; Desktop Hub</h3>
                <p class="text-[11px] text-slate-600 dark:text-slate-400 leading-normal">
                  Aplikasi mobile ringan untuk siswa dan pelatih di lapangan, disandingkan dengan Command Center Desktop untuk sekretariat dan pembina.
                </p>
              </div>
            </div>

            <!-- Callout Note -->
            <div class="p-4 rounded-2xl bg-cyan-50 dark:bg-cyan-950/40 border border-cyan-200 dark:border-cyan-800/70 text-cyan-900 dark:text-cyan-200 text-xs leading-relaxed flex items-start gap-3">
              <span class="text-lg shrink-0">💡</span>
              <div>
                <strong class="font-bold">Keunggulan Zero Server Fee:</strong> Pangkalan tidak perlu menganggarkan biaya sewa domain, database hosting, atau tagihan cloud bulanan. Cukup menggunakan 1 akun Google resmi pangkalan sekolah.
              </div>
            </div>
          </section>

          <!-- ============================================================ -->
          <!-- BAB 2: PENDAFTARAN & REGISTRASI PANGKALAN                   -->
          <!-- ============================================================ -->
          <section id="pendaftaran" class="doc-section rounded-3xl bg-white dark:bg-slate-900/80 border-2 border-slate-200/90 dark:border-slate-800 p-6 sm:p-8 shadow-sm relative scroll-mt-24">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-black uppercase tracking-wider bg-amber-100 dark:bg-amber-950 text-amber-800 dark:text-amber-300 border border-amber-300 dark:border-amber-800">
                Bab 2
              </span>
              <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Setup Awal Pangkalan</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-slate-100 tracking-tight mb-3">
              📝 Alur Pendaftaran &amp; Inisialisasi Pangkalan Baru
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
              Ikuti 3 tahapan resmi ini saat pangkalan sekolah atau madrasah Anda pertama kali mengadopsi sistem KOMANDO:
            </p>

            <!-- Steps Accordion / Cards -->
            <div class="space-y-4">
              {komandoDocs.registrationSteps.map((step) => (
                <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700">
                  <div class="flex items-center justify-between gap-4 mb-2">
                    <div class="flex items-center gap-3">
                      <span class="w-7 h-7 rounded-full bg-amber-500 text-slate-950 font-black text-xs flex items-center justify-center shrink-0">
                        {step.number}
                      </span>
                      <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-slate-100">
                        {step.title}
                      </h3>
                    </div>
                    {step.badge && (
                      <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300">
                        {step.badge}
                      </span>
                    )}
                  </div>
                  <p class="text-xs text-slate-600 dark:text-slate-300 mb-3 pl-10">
                    {step.description}
                  </p>
                  {step.detail && (
                    <ul class="pl-10 space-y-1.5 list-disc list-inside text-[11px] text-slate-500 dark:text-slate-400">
                      {step.detail.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  )}
                  {step.image && (
                    <div class="mt-4 pl-10">
                      <div class="rounded-xl overflow-hidden border border-slate-200 dark:border-slate-700 max-w-sm">
                        <img src={step.image} alt={step.title} class="w-full h-auto object-cover" loading="lazy" />
                      </div>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </section>

          <!-- ============================================================ -->
          <!-- BAB 3: ONBOARDING & 4 TINGKAT HAK AKSES                     -->
          <!-- ============================================================ -->
          <section id="onboarding-roles" class="doc-section rounded-3xl bg-white dark:bg-slate-900/80 border-2 border-slate-200/90 dark:border-slate-800 p-6 sm:p-8 shadow-sm relative scroll-mt-24">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-black uppercase tracking-wider bg-indigo-100 dark:bg-indigo-950 text-indigo-800 dark:text-indigo-300 border border-indigo-300 dark:border-indigo-800">
                Bab 3
              </span>
              <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Manajemen Peran &amp; Akun</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-slate-100 tracking-tight mb-3">
              🛡️ Onboarding &amp; Matriks 4 Tingkat Hak Akses
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
              Sistem KOMANDO menerapkan prinsip pembagian tugas berjenjang (*Least Privilege*) agar seluruh operasional organisasi terdokumentasi rapi tanpa risiko kebocoran data sensitif:
            </p>

            <!-- Roles Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {komandoDocs.rolePermissions.map((rp) => (
                <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between mb-2">
                      <h3 class="text-sm sm:text-base font-black text-slate-900 dark:text-slate-100">
                        {rp.role}
                      </h3>
                      <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300">
                        {rp.level}
                      </span>
                    </div>
                    <p class="text-xs text-slate-600 dark:text-slate-300 mb-3 leading-normal">
                      {rp.description}
                    </p>
                    <div class="space-y-1.5 pt-3 border-t border-slate-200 dark:border-slate-700">
                      <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-1">
                        Kewenangan Utama:
                      </span>
                      {rp.allowedAccess.map((acc) => (
                        <div class="flex items-start gap-2 text-[11px] text-slate-600 dark:text-slate-300">
                          <span class="text-emerald-500 font-bold shrink-0">✓</span>
                          <span>{acc}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <!-- ============================================================ -->
          <!-- BAB 4: PANDUAN ANDROID (APK/PWA) & COMMAND CENTER DESKTOP   -->
          <!-- ============================================================ -->
          <section id="platform-mode" class="doc-section rounded-3xl bg-white dark:bg-slate-900/80 border-2 border-slate-200/90 dark:border-slate-800 p-6 sm:p-8 shadow-sm relative scroll-mt-24">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-black uppercase tracking-wider bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800">
                Bab 4
              </span>
              <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Dukungan Multi-Perangkat</span>
            </div>
            
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-slate-100 tracking-tight mb-3">
              📱 Panduan Instalasi Android (APK &amp; PWA) &amp; Command Center Desktop
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
              Sistem KOMANDO dirancang fleksibel: berjalan sebagai <strong>Aplikasi Android Asli (Native APK)</strong> di smartphone siswa/pelatih saat di lapangan, sekaligus menyediakan <strong>Command Center Desktop</strong> di laptop pembina untuk tata usaha markas besar.
            </p>

            <!-- Dual Android Method Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
              <!-- Metode 1: APK Native -->
              <div class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/70 border-2 border-cyan-300/80 dark:border-cyan-800/80 flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between mb-3">
                    <span class="px-2.5 py-1 rounded-full text-xs font-black bg-cyan-600 text-white shadow-xs">
                      Metode 1: File Komando.apk
                    </span>
