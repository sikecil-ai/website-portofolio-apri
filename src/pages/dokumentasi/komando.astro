    if (btnPrint) {
      btnPrint.addEventListener('click', () => {
        window.print();
      });
    }

    // 2. Live Search Filter
    const searchInput = document.getElementById('docs-search-input');
    const searchClear = document.getElementById('docs-search-clear');
    const searchStatus = document.getElementById('search-status');
    const moduleCards = document.querySelectorAll('.module-card');
    const faqCards = document.querySelectorAll('.faq-card');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();

        if (query.length > 0) {
          searchClear?.classList.remove('hidden');
        } else {
          searchClear?.classList.add('hidden');
        }

        let visibleModules = 0;
        let visibleFaqs = 0;

        // Filter modules
        moduleCards.forEach((card) => {
          const name = card.getAttribute('data-name') || '';
          const code = card.getAttribute('data-code') || '';
          const summary = card.getAttribute('data-summary') || '';
          const textContent = card.textContent?.toLowerCase() || '';
          const match = textContent.includes(query) || name.includes(query) || code.includes(query) || summary.includes(query) || category.includes(query);

          if (match || query === '') {
            card.classList.remove('hidden');
            visibleModules++;
          } else {
            card.classList.add('hidden');
          }
        });

        // Filter FAQs
        faqCards.forEach((card) => {
          const text = card.textContent?.toLowerCase() || '';
          if (text.includes(query) || query === '') {
            card.classList.remove('hidden');
            visibleFaqs++;
          } else {
            card.classList.add('hidden');
          }
        });

        // Update search status message
        if (searchStatus) {
          if (query.length > 0) {
            searchStatus.classList.remove('hidden');
            searchStatus.textContent = `Menemukan ${visibleModules} modul dan ${visibleFaqs} FAQ sesuai kata kunci "${query}".`;
          } else {
            searchStatus.classList.add('hidden');
          }
        }
      });

      // Clear search button
      if (searchClear) {
        searchClear.addEventListener('click', () => {
          searchInput.value = '';
          searchInput.dispatchEvent(new Event('input'));
          searchInput.focus();
        });
      }
    }

    // 3. ScrollSpy for TOC Links (Desktop Aside & Mobile Sticky Bar)
    const sections = document.querySelectorAll('.doc-section');
    const tocLinks = document.querySelectorAll('.toc-link');
    const mobileTocLinks = document.querySelectorAll('.mobile-toc-link');

    const updateActiveSection = () => {
      let currentSectionId = '';
      sections.forEach((section) => {
        const rect = section.getBoundingClientRect();
        if (rect.top <= 180) {
          currentSectionId = section.getAttribute('id') || '';
        }
      });

      if (currentSectionId) {
        // Desktop aside links
        tocLinks.forEach((link) => {
          const target = link.getAttribute('data-target');
          if (target === currentSectionId) {
            link.classList.add('bg-cyan-50', 'dark:bg-cyan-950/60', 'text-cyan-600', 'dark:text-cyan-400', 'font-black');
            link.classList.remove('text-slate-700', 'dark:text-slate-300');
          } else {
            link.classList.remove('bg-cyan-50', 'dark:bg-cyan-950/60', 'text-cyan-600', 'dark:text-cyan-400', 'font-black');
            link.classList.add('text-slate-700', 'dark:text-slate-300');
          }
        });

        // Mobile sticky bar links
        mobileTocLinks.forEach((link) => {
          const target = link.getAttribute('data-target');
          if (target === currentSectionId) {
            link.classList.add('bg-cyan-600', 'text-white', 'shadow-xs');
            link.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
          } else {
            link.classList.remove('bg-cyan-600', 'text-white', 'shadow-xs');
            link.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
          }
        });
      }
    };

    window.addEventListener('scroll', updateActiveSection, { passive: true });
    updateActiveSection();
  });
</script>

