---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
import { siteConfig } from '../../data/siteConfig';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const canonicalURL = `${siteConfig.url}/sistem/${project.slug}`;

const ogImageMap: Record<string, string> = {
  'komando-sistem-manajemen-paskibra': '/images/og-komando-organisasi.png?v=2026',
  'g7kaih-sistem-kebiasaan-anak-hebat': '/images/og-g7kaih.png?v=2026',
  'si-paling-rekap-tabulasi-kejuaraan': '/images/og-si-paling-rekap.png',
  'si-paling-kasir-fnb-pos-inventory': '/images/og-si-paling-kasir.png',
  'si-paling-threads-auto-publisher': '/images/og-si-paling-threads.png',
};

const projectOgImage = ogImageMap[project.slug] || project.image || '/images/og-image.png';

const seoProps = {
  title: `${project.title} | Solusi Sistem Otomasi Kang Apri (@madebyaapri)`,
  description: project.description,
  image: projectOgImage,
  canonicalURL: canonicalURL,
  type: 'website',
};

// Filter other projects for cross-selling
const otherProjects = projects.filter((p) => p.id !== project.id).slice(0, 3);

// Dynamic wa message
const waClosingText = `Halo Kang Apri, saya tertarik mengadopsi sistem ${project.title} untuk sekolah / organisasi / bisnis saya. Boleh konsultasikan alur kerjanya?`;
const waClosingUrl = `https://wa.me/6282118313655?text=${encodeURIComponent(waClosingText)}`;
---

<Layout seo={seoProps}>
  <div class="pt-16 sm:pt-20 pb-16 relative overflow-hidden bg-[#fafcff] dark:bg-[#070b14]">
    <!-- Ambient Glows -->
    <div class="ambient-glow bg-cyan-500/10 top-20 -left-20 w-80 h-80 sm:w-96 sm:h-96 animate-pulse-glow"></div>
    <div class="ambient-glow bg-blue-500/10 top-1/3 -right-20 w-96 h-96 animate-pulse-glow" style="animation-delay: 2s;"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="mb-3 sm:mb-4 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 font-medium">
        <a href="/" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/#proyek" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Etalase Sistem</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200 truncate max-w-xs">{project.title.split('—')[0].trim()}</span>
      </nav>

      <!-- ============================================================ -->
      <!-- 1. HERO SECTION: DUAL-DEVICE SHOWCASE (Benchmark AgenSoal)   -->
      <!-- ============================================================ -->
      <section class="rounded-2xl sm:rounded-3xl bg-white dark:bg-slate-900/80 border-2 border-slate-200/90 dark:border-slate-800 p-5 sm:p-7 lg:p-7 shadow-sm mb-8 relative overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
          
          <!-- Left Column: Copywriting & High-Converting CTA (lg:col-span-7) -->
          <div class="lg:col-span-7 space-y-3.5 sm:space-y-4">
            
            <!-- Badges Row -->
            <div class="flex items-center gap-2 flex-wrap">
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-black uppercase tracking-wider bg-cyan-100 dark:bg-cyan-950/80 text-cyan-800 dark:text-cyan-300 border border-cyan-300 dark:border-cyan-800">
                {project.category}
              </span>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-300 dark:border-emerald-800/80">
                <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                {project.verifiedBadge || 'Aplikasi Resmi Terverifikasi'}
              </span>
            </div>

            <!-- Title & Value Prop -->
            <div>
              <h1 class="text-2xl sm:text-3xl lg:text-[28px] xl:text-[32px] font-black text-slate-900 dark:text-slate-100 tracking-tight leading-[1.15] mb-1.5">
                {project.title}
              </h1>
              <p class="text-xs sm:text-sm font-semibold text-slate-600 dark:text-slate-300 leading-normal">
                {project.tagline}
              </p>
            </div>

            <!-- Play Store Key Metrics Strip -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 py-2 px-3 rounded-xl bg-slate-50 dark:bg-slate-800/70 border border-slate-200 dark:border-slate-700 text-center">
              <div>
                <div class="text-amber-500 font-black text-base sm:text-lg">
                  {project.rating || '5.0'} ★
                </div>
                <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block truncate">
                  {project.reviewCount || 'Audit Lapangan'}
                </span>
              </div>
              <div class="border-l border-slate-200 dark:border-slate-700">
                <div class="text-slate-900 dark:text-slate-100 font-black text-base sm:text-lg">
                  {project.stats?.[1]?.value || '871+'}
                </div>
                <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block truncate">
                  {project.stats?.[1]?.label || 'Siswa Terdata'}
                </span>
              </div>
              <div class="border-l border-slate-200 dark:border-slate-700">
                <div class="text-cyan-600 dark:text-cyan-400 font-black text-base sm:text-lg">
                  {project.stats?.[2]?.value || '1 Menit'}
                </div>
                <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block truncate">
                  {project.stats?.[2]?.label || 'Kecepatan Input'}
                </span>
              </div>
              <div class="border-l border-slate-200 dark:border-slate-700">
                <div class="text-emerald-600 dark:text-emerald-400 font-black text-base sm:text-lg">
                  Rp 0
                </div>
                <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400 block truncate">
                  Biaya Server
                </span>
              </div>
            </div>

            <!-- Tactile Action Buttons (1-Line Compact & Proportional) -->
            <div class="flex flex-wrap items-center gap-2 pt-1">
              <a
                href={project.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl font-bold text-xs text-white bg-cyan-600 hover:bg-cyan-500 shadow-[0_3px_0_#0891b2] transition-transform active:translate-y-[1px] active:shadow-none cursor-pointer text-center whitespace-nowrap"
              >
                <span>{project.slug === 'komando-sistem-manajemen-paskibra' ? '📝 Portal Pangkalan (Live)' : project.slug === 'g7kaih-sistem-kebiasaan-anak-hebat' ? '🚀 Buka Portal & Registrasi (Live)' : '🚀 Buka Portal Demo (Live)'}</span>
              </a>

              {project.articleSlug && (
                <a
                  href={`/artikel/${project.articleSlug}`}
                  class="inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl font-bold text-xs text-slate-800 dark:text-slate-200 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-750 shadow-[0_3px_0_#cbd5e1] dark:shadow-[0_3px_0_#1e293b] transition-transform active:translate-y-[1px] active:shadow-none cursor-pointer text-center whitespace-nowrap"
                >
                  <span>📖 Baca Cerita Lapangan</span>
                </a>
              )}

              <a
                href={waClosingUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-1 px-2.5 py-2 rounded-xl text-xs font-bold text-emerald-700 dark:text-emerald-400 hover:underline transition-colors text-center whitespace-nowrap"
              >
                <span>💬 Konsultasi WA</span>
              </a>
            </div>

            <p class="text-[11px] text-slate-500 dark:text-slate-400 pt-0.5">
              Dikembangkan oleh <strong>{project.developer || 'M. Apriyanto Wijaya (@madebyaapri)'}</strong> • Praktisi Otomasi &amp; Zero Server Cost
            </p>

          </div>

          <!-- Right Column: DUAL-DEVICE VIEWPORT MOCKUP (lg:col-span-5) -->
          <div class="lg:col-span-5 relative flex items-center justify-center pt-2 lg:pt-0">
            
            <!-- Dual Device Container -->
            <div id="dual-device-container" class="relative w-full max-w-[430px] lg:max-w-[450px] transition-all duration-300">
              
              <!-- 1. DESKTOP / LAPTOP FRAME (MacBook Style) -->
              <div id="desktop-mockup-frame" class="w-full rounded-2xl bg-slate-900 border-2 border-slate-700 shadow-xl overflow-hidden transition-all duration-300">
                <!-- Browser Header Bar -->
                <div class="px-3 py-1.5 bg-slate-800/90 border-b border-slate-700 flex items-center justify-between">
                  <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-rose-500 inline-block"></span>
                    <span class="w-2 h-2 rounded-full bg-amber-500 inline-block"></span>
                    <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
                  </div>
                  <div class="px-2.5 py-0.5 rounded-md bg-slate-900/80 text-[8px] font-mono text-slate-400 max-w-[180px] truncate border border-slate-700">
                    {project.demoUrl || 'https://sites.google.com/view/g7kaih'}
                  </div>
                  <span class="text-[8px] font-bold text-cyan-400 uppercase tracking-wider">Desktop Admin</span>
                </div>

                <!-- Desktop Screen Content -->
                {project.heroDesktopImage ? (
                  <div class="relative overflow-hidden bg-slate-950 aspect-[16/10] sm:aspect-[16/9.5]">
                    <img
                      src={project.heroDesktopImage}
                      alt={`${project.title} - Antarmuka Desktop`}
                      class="w-full h-full object-cover object-top"
                      loading="eager"
                    />
                    <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950/90 via-slate-950/40 to-transparent p-1.5 flex items-center justify-between text-[8px] text-slate-300">
                      <span class="font-bold text-cyan-400">● LIVE MAN KOTA CIMAHI</span>
                      <span class="bg-slate-900/90 px-1.5 py-0.5 rounded text-slate-400 font-mono">Google Apps Script</span>
                    </div>
                  </div>
                ) : (
                  <div class="p-3 bg-slate-950 text-white min-h-[190px] flex flex-col justify-between">
                    <div>
                      <div class="flex items-center justify-between border-b border-slate-800 pb-1.5 mb-2">
                        <div class="flex items-center gap-1.5">
                          <div class="w-5 h-5 rounded bg-cyan-600 flex items-center justify-center font-bold text-[9px] text-white">
                            GAS
                          </div>
                          <span class="text-[11px] font-bold text-slate-200">{project.title.split('—')[0].trim()}</span>
                        </div>
                        <span class="px-1.5 py-0.5 rounded text-[8px] font-bold bg-emerald-500/20 text-emerald-400">
                          ● LIVE CLOUD
                        </span>
                      </div>

                      <!-- Metrics Grid Mockup -->
                      <div class="grid grid-cols-3 gap-1.5 mb-2 text-center">
                        <div class="p-1.5 rounded-lg bg-slate-900 border border-slate-800">
                          <span class="text-[7px] text-slate-400 block font-bold">TOTAL AKTIF</span>
                          <span class="text-xs font-black text-cyan-400">{project.stats?.[1]?.value || '871'}</span>
                        </div>
                        <div class="p-1.5 rounded-lg bg-slate-900 border border-slate-800">
                          <span class="text-[7px] text-slate-400 block font-bold">STREAK / HARI</span>
                          <span class="text-xs font-black text-amber-400">28 Hari</span>
                        </div>
                        <div class="p-1.5 rounded-lg bg-slate-900 border border-slate-800">
                          <span class="text-[7px] text-slate-400 block font-bold">BIAYA SERVER</span>
                          <span class="text-xs font-black text-emerald-400">Rp 0</span>
                        </div>
                      </div>

                      <!-- Simulated Chart / List -->
                      <div class="p-2 rounded-lg bg-slate-900/80 border border-slate-800 text-[9px] space-y-1">
                        <div class="flex items-center justify-between text-slate-300">
                          <span>Monitoring Kelas / Divisi</span>
                          <span class="text-emerald-400 font-bold">98.4% Terisi</span>
                        </div>
                        <div class="w-full bg-slate-800 h-1 rounded-full overflow-hidden">
                          <div class="bg-gradient-to-r from-cyan-500 to-emerald-400 h-full w-[85%]"></div>
                        </div>
                      </div>
                    </div>

                    <div class="pt-1.5 flex items-center justify-between text-[8px] text-slate-400 border-t border-slate-800/80 mt-1.5">
                      <span>Database Google Sheets Terhubung</span>
                      <span class="text-cyan-400 font-bold">🖨️ Ekspor Siap Cetak</span>
                    </div>
                  </div>
                )}
              </div>

              <!-- 2. SMARTPHONE FRAME (Floating Overlap ala AgenSoal) -->
              <div id="mobile-mockup-frame" class="absolute -bottom-4 -right-2 sm:-right-3 w-[130px] sm:w-[150px] rounded-2xl bg-slate-900 border-2 border-slate-600 shadow-2xl overflow-hidden transition-all duration-300 hover:scale-105">
                <!-- Phone Speaker & Notch -->
                <div class="pt-1 pb-0.5 px-2 bg-slate-950 flex items-center justify-center border-b border-slate-800">
                  <div class="w-6 h-1 rounded-full bg-slate-700"></div>
                </div>

                {project.heroMobileImage ? (
                  <div class="relative overflow-hidden bg-slate-950 h-[190px] sm:h-[220px]">
                    <img
                      src={project.heroMobileImage}
                      alt={`${project.title} - Antarmuka Smartphone`}
                      class="w-full h-full object-cover object-top"
                      loading="eager"
                    />
                    <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950/90 via-slate-950/40 to-transparent p-1 text-center">
                      <span class="inline-block px-1.5 py-0.5 rounded-full text-[7px] font-bold bg-cyan-600/90 text-white shadow-sm backdrop-blur-sm">
                        📱 Real Mobile App
                      </span>
                    </div>
                  </div>
                ) : (
                  <!-- Simulated Fallback Screen -->
                  <div class="p-2 bg-slate-950 text-white min-h-[155px] flex flex-col justify-between text-[8px]">
                    <div>
                      <div class="text-center font-bold text-[9px] text-cyan-400 mb-1">
                        📱 Input Cepat (1 Tap)
                      </div>
                      
                      <!-- Form Check items -->
                      <div class="space-y-1 mb-1.5">
                        <div class="flex items-center justify-between p-1 rounded bg-slate-900 border border-slate-800">
                          <span class="text-[7.5px] text-slate-300 truncate">1. Presensi Hadir</span>
                          <span class="w-3 h-3 rounded bg-emerald-500 flex items-center justify-center text-[6px] font-bold text-white">✓</span>
                        </div>
                        <div class="flex items-center justify-between p-1 rounded bg-slate-900 border border-slate-800">
                          <span class="text-[7.5px] text-slate-300 truncate">2. Laporan Latihan</span>
                          <span class="w-3 h-3 rounded bg-emerald-500 flex items-center justify-center text-[6px] font-bold text-white">✓</span>
                        </div>
                        <div class="flex items-center justify-between p-1 rounded bg-slate-900 border border-slate-800">
                          <span class="text-[7.5px] text-slate-300 truncate">3. Rekap Otomatis</span>
                          <span class="w-3 h-3 rounded bg-emerald-500 flex items-center justify-center text-[6px] font-bold text-white">✓</span>
                        </div>
                      </div>
                    </div>

                    <div class="py-1 px-2 rounded-lg bg-cyan-600 text-white font-bold text-center text-[7.5px] shadow-sm">
                      Kirim Data (1 Detik)
                    </div>
                  </div>
                )}
              </div>

            </div>

          </div>

        </div>

        <!-- Interactive Viewport Switcher Tabs (AgenSoal Benchmark) -->
        <div class="mt-5 pt-3.5 border-t border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-2.5">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-slate-500 dark:text-slate-400">Inspeksi Antarmuka:</span>
            <div class="inline-flex rounded-xl p-1 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-bold">
              <button
                type="button"
                id="btn-view-dual"
                class="px-3 py-1.5 rounded-lg bg-white dark:bg-slate-900 text-cyan-600 dark:text-cyan-400 shadow-sm transition-all cursor-pointer"
              >
                👥 Dual-Device
              </button>
              <button
                type="button"
                id="btn-view-desktop"
                class="px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer"
              >
                💻 Laptop (Admin)
              </button>
              <button
                type="button"
                id="btn-view-mobile"
                class="px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all cursor-pointer"
              >
                📱 Smartphone (Siswa)
              </button>
            </div>
          </div>

          <span class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
            <span>✓</span>
            <span>Otomatis Responsif di Seluruh Ukuran Layar</span>
          </span>
        </div>
      </section>

      <!-- ============================================================ -->
      <!-- 2. PILIH EKOSISTEM / PERAN SOLUSI (AgenSoal Persona Cards)   -->
      <!-- ============================================================ -->
      <section class="mb-14">
        <div class="text-center max-w-2xl mx-auto mb-8 space-y-2">
          <p class="text-xs font-black uppercase tracking-widest text-cyan-600 dark:text-cyan-400">
            SOLUSI SETIAP PERAN
          </p>
          <h2 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-slate-100">
            Bagaimana Sistem Ini Memudahkan Semua Orang
          </h2>
          <p class="text-xs sm:text-sm font-medium text-slate-600 dark:text-slate-400">
            Dari peserta lapangan hingga pimpinan lembaga, setiap orang merasakan efisiensi instan.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          <!-- Card 1: Pengguna Lapangan / Siswa -->
          <div class="rounded-3xl border-2 border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 flex flex-col justify-between shadow-[0_4px_0_#e2e8f0] dark:shadow-[0_4px_0_#1e293b] hover:border-cyan-400 transition-all">
            <div class="space-y-3">
              <div class="w-10 h-10 rounded-xl bg-cyan-100 dark:bg-cyan-950 text-cyan-600 flex items-center justify-center text-xl font-bold">
                📱
              </div>
              <span class="text-[10px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-cyan-50 dark:bg-cyan-950 text-cyan-700 dark:text-cyan-400 border border-cyan-200 dark:border-cyan-800">
                Untuk Siswa / Anggota
              </span>
              <h3 class="text-lg font-black text-slate-900 dark:text-slate-100">
                Input Tap-Tap Ringan
              </h3>
              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                Tanpa perlu instalasi aplikasi berat dari app store. Cukup buka link di browser HP, tap tombol centang, dan laporan selesai terkirim dalam 1 menit.
              </p>
              <ul class="space-y-1.5 text-xs font-bold text-slate-700 dark:text-slate-300 pt-2">
                <li class="flex items-center gap-2"><span>✓</span><span>Fitur Streak Konsistensi</span></li>
                <li class="flex items-center gap-2"><span>✓</span><span>Retroactive input (hari terlewat)</span></li>
                <li class="flex items-center gap-2"><span>✓</span><span>Anti kertas fotokopi tercecer</span></li>
              </ul>
            </div>
          </div>

          <!-- Card 2: Pengawas / Guru BK / Wali Kelas -->
          <div class="rounded-3xl border-2 border-cyan-300 dark:border-cyan-800 bg-[#f8fdff] dark:bg-slate-900 p-6 flex flex-col justify-between shadow-[0_4px_0_#bae6fd] dark:shadow-[0_4px_0_#0e7490] relative overflow-hidden">
            <div class="absolute top-0 right-0 bg-cyan-600 text-white text-[9px] font-black uppercase tracking-wider px-3 py-1 rounded-bl-xl">
              ★ Terpopuler
            </div>
            <div class="space-y-3">
              <div class="w-10 h-10 rounded-xl bg-cyan-500 text-white flex items-center justify-center text-xl font-bold shadow-md">
                🖥️
              </div>
              <span class="text-[10px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-cyan-100 dark:bg-cyan-950 text-cyan-800 dark:text-cyan-300 border border-cyan-300">
                Untuk Guru &amp; Supervisor
              </span>
              <h3 class="text-lg font-black text-slate-900 dark:text-slate-100">
                Dashboard Monitoring Live
              </h3>
              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                Pantau ratusan siswa sekaligus dari layar laptop. Filter per kelas, lihat grafik kepatuhan, dan ketahui siapa yang konsisten secara real-time.
              </p>
              <ul class="space-y-1.5 text-xs font-bold text-slate-700 dark:text-slate-300 pt-2">
                <li class="flex items-center gap-2"><span>✓</span><span>Grafik analitik per angkatan</span></li>
                <li class="flex items-center gap-2"><span>✓</span><span>Filter kelas 1-klik</span></li>
                <li class="flex items-center gap-2"><span>✓</span><span>Bisa diedit via Desktop &amp; HP</span></li>
              </ul>
            </div>
          </div>

          <!-- Card 3: Lembaga / Kepala Sekolah / Owner -->
          <div class="rounded-3xl border-2 border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 flex flex-col justify-between shadow-[0_4px_0_#e2e8f0] dark:shadow-[0_4px_0_#1e293b] hover:border-emerald-400 transition-all">
            <div class="space-y-3">
              <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-950 text-emerald-600 flex items-center justify-center text-xl font-bold">
                🏛️
              </div>
              <span class="text-[10px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800">
                Untuk Pimpinan &amp; Yayasan
              </span>
