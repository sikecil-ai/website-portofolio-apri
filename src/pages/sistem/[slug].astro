  <!-- Interactive Dual-Device Switcher & Lightbox Script -->
  <script is:inline>
    // 1. Dual-Device Switcher
    const btnDual = document.getElementById('btn-view-dual');
    const btnDesktop = document.getElementById('btn-view-desktop');
    const btnMobile = document.getElementById('btn-view-mobile');
    const desktopFrame = document.getElementById('desktop-mockup-frame');
    const mobileFrame = document.getElementById('mobile-mockup-frame');

    function setActiveBtn(active) {
      [btnDual, btnDesktop, btnMobile].forEach((b) => {
        if (!b) return;
        b.classList.remove('bg-white', 'dark:bg-slate-900', 'text-cyan-600', 'dark:text-cyan-400', 'shadow-sm');
        b.classList.add('text-slate-600', 'dark:text-slate-400');
      });
      if (active) {
        active.classList.remove('text-slate-600', 'dark:text-slate-400');
        active.classList.add('bg-white', 'dark:bg-slate-900', 'text-cyan-600', 'dark:text-cyan-400', 'shadow-sm');
      }
    }

    if (btnDual && desktopFrame && mobileFrame) {
      btnDual.addEventListener('click', () => {
        setActiveBtn(btnDual);
        desktopFrame.style.display = 'block';
        desktopFrame.style.opacity = '1';
        desktopFrame.style.transform = 'scale(1)';
        mobileFrame.style.display = 'block';
        mobileFrame.style.opacity = '1';
        mobileFrame.style.position = 'absolute';
        mobileFrame.style.transform = 'scale(1)';
      });
    }

    if (btnDesktop && desktopFrame && mobileFrame) {
      btnDesktop.addEventListener('click', () => {
        setActiveBtn(btnDesktop);
        desktopFrame.style.display = 'block';
        desktopFrame.style.opacity = '1';
        desktopFrame.style.transform = 'scale(1.05)';
        mobileFrame.style.display = 'none';
      });
    }

    if (btnMobile && desktopFrame && mobileFrame) {
      btnMobile.addEventListener('click', () => {
        setActiveBtn(btnMobile);
        desktopFrame.style.display = 'none';
        mobileFrame.style.display = 'block';
        mobileFrame.style.position = 'relative';
        mobileFrame.style.margin = '0 auto';
        mobileFrame.style.transform = 'scale(1.35)';
      });
    }

    // 2. Fullscreen Screenshot Lightbox
    const lightbox = document.getElementById('screenshot-lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxTag = document.getElementById('lightbox-tag');
    const lightboxStats = document.getElementById('lightbox-stats');
    const lightboxDesc = document.getElementById('lightbox-desc');
    const lightboxCounter = document.getElementById('lightbox-counter');
    const lightboxCloseBtn = document.getElementById('lightbox-close-btn');
    const lightboxCloseBottomBtn = document.getElementById('lightbox-close-bottom-btn');
    const lightboxPrevBtn = document.getElementById('lightbox-prev-btn');
    const lightboxNextBtn = document.getElementById('lightbox-next-btn');
    const lightboxScrollContainer = document.getElementById('lightbox-scroll-container');

    const screenshotCards = Array.from(document.querySelectorAll('.screenshot-card'));
    let currentIndex = 0;

    function updateLightbox(idx) {
      if (!screenshotCards.length) return;
      if (idx < 0) idx = screenshotCards.length - 1;
      if (idx >= screenshotCards.length) idx = 0;
      currentIndex = idx;

      const card = screenshotCards[idx];
      if (!card) return;

      const img = card.dataset.image;
      const title = card.dataset.title;
      const tag = card.dataset.tag;
      const stats = card.dataset.stats;
      const desc = card.dataset.desc;

      if (lightboxImg && img) {
        lightboxImg.src = img;
        lightboxImg.alt = title || 'Tangkapan Layar';
      }
      if (lightboxTitle) lightboxTitle.textContent = title || '';
      if (lightboxTag) lightboxTag.textContent = tag || '';
      if (lightboxStats) {
        if (stats) {
          lightboxStats.textContent = stats;
          lightboxStats.style.display = 'inline-block';
        } else {
          lightboxStats.style.display = 'none';
        }
      }
      if (lightboxDesc) lightboxDesc.textContent = desc || '';
      if (lightboxCounter) lightboxCounter.textContent = `${idx + 1} / ${screenshotCards.length}`;

      // Adaptive framing: desktop widescreen vs mobile phone
      const lightboxFrameContainer = document.getElementById('lightbox-frame-container');
      const lightboxNotch = document.getElementById('lightbox-notch');
      const lightboxBrowserHeader = document.getElementById('lightbox-browser-header');
      const isDesktop = tag && tag.toLowerCase().includes('desktop');

      if (lightboxFrameContainer && lightboxNotch && lightboxBrowserHeader) {
        if (isDesktop) {
          lightboxFrameContainer.className = "relative max-h-[76vh] w-full max-w-[94vw] lg:max-w-4xl rounded-2xl border-2 border-slate-700 bg-slate-900 overflow-hidden shadow-2xl flex flex-col transition-all duration-300";
          lightboxNotch.classList.add('hidden');
          lightboxBrowserHeader.classList.remove('hidden');
        } else {
          lightboxFrameContainer.className = "relative max-h-[72vh] sm:max-h-[76vh] w-auto max-w-[90vw] sm:max-w-[340px] rounded-2xl sm:rounded-3xl border-2 border-slate-700 bg-slate-900 overflow-hidden shadow-2xl flex flex-col transition-all duration-300";
          lightboxNotch.classList.remove('hidden');
          lightboxBrowserHeader.classList.add('hidden');
        }
      }

      // Reset scroll to top of view on slide change
      if (lightboxScrollContainer) {
        lightboxScrollContainer.scrollTop = 0;
      }
    }

    function openLightbox(idx) {
      updateLightbox(idx);
      if (lightbox) {
        lightbox.classList.remove('hidden');
        requestAnimationFrame(() => {
          lightbox.classList.remove('opacity-0');
          lightbox.classList.add('opacity-100');
        });
        document.body.style.overflow = 'hidden';
      }
    }

    function closeLightbox() {
      if (lightbox) {
        lightbox.classList.remove('opacity-100');
        lightbox.classList.add('opacity-0');
        setTimeout(() => {
          lightbox.classList.add('hidden');
          document.body.style.overflow = '';
        }, 200);
      }
    }

    screenshotCards.forEach((card, idx) => {
      card.addEventListener('click', () => openLightbox(idx));
    });

    if (lightboxCloseBtn) lightboxCloseBtn.addEventListener('click', closeLightbox);
    if (lightboxCloseBottomBtn) lightboxCloseBottomBtn.addEventListener('click', closeLightbox);

    if (lightboxPrevBtn) {
      lightboxPrevBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        updateLightbox(currentIndex - 1);
      });
    }

    if (lightboxNextBtn) {
      lightboxNextBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        updateLightbox(currentIndex + 1);
      });
    }

    // Close on backdrop click (outside phone frame)
    if (lightbox) {
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });
    }

    // Keyboard navigation
    window.addEventListener('keydown', (e) => {
      if (!lightbox || lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') updateLightbox(currentIndex - 1);
      if (e.key === 'ArrowRight') updateLightbox(currentIndex + 1);
    });
  </script>
</Layout>
