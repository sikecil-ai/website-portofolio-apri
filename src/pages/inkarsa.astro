---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/siteConfig';
import { projects } from '../data/projects';

const canonicalURL = `${siteConfig.url}/inkarsa`;

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${canonicalURL}/#aboutpage`,
  url: canonicalURL,
  name: 'Tentang INKARSA (Inovasi Karya Semesta Raya) | Kang Apri',
  description:
    'Profil lengkap INKARSA (Inovasi Karya Semesta Raya), studio teknologi di Kota Cimahi yang diarsiteki oleh Kang Apri dengan fokus sistem bebas biaya sewa server.',
  mainEntity: {
    '@id': `${siteConfig.url}/#organization`,
  },
  inLanguage: 'id-ID',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Beranda',
      item: siteConfig.url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Tentang INKARSA',
      item: canonicalURL,
    },
  ],
};

const seoProps = {
  title: 'Tentang INKARSA | Studio Sistem & Otomasi oleh Kang Apri',
  description:
    'Mengenal INKARSA (Inovasi Karya Semesta Raya), studio teknologi besutan Kang Apri di Cimahi. Solusi aplikasi web sekolah, lomba, & UMKM Rp 0 sewa server.',
  canonicalURL,
  type: 'website' as const,
  extraSchemas: [aboutPageSchema, breadcrumbSchema],
};

const coreValues = [
  {
    icon: '💡',
    title: 'Inovasi yang Membumi',
    desc: 'Teknologi tidak harus mahal dan rumit. Kami mengubah alat yang sudah familiar seperti Google Workspace menjadi aplikasi web yang cepat dan nyaman di smartphone.',
  },
  {
    icon: '🛠️',
    title: 'Karya Nyata Lapangan',
    desc: 'Setiap fitur lahir dari masalah riil di ruang BK sekolah, meja panitia kejuaraan, hingga dapur UMKM. Teruji pada ratusan hingga ribuan pengguna aktif.',
  },
  {
    icon: '🤝',
    title: 'Semesta Raya (Memberdayakan)',
    desc: 'Berlandaskan semangat kepemimpinan Ki Hadjar Dewantara: menumbuhkan potensi instansi dan tim agar mandiri secara digital tanpa ketergantungan sewa server.',
  },
];

const architecturePillars = [
  {
    icon: '💰',
    label: 'Zero Server Cost',
    title: 'Rp 0 Biaya Sewa Server Seumur Hidup',
    desc: 'Aplikasi berjalan di atas ekosistem Google Workspace dan Google Apps Script milik instansi atau bisnis Anda sendiri. Bebas tagihan VPS tahunan atau cloud bulanan.',
  },
  {
    icon: '⚡',
    label: 'Real-Time Engine',
    title: 'Rekap Otomatis & 1-Klik Siap Cetak PDF',
    desc: 'Baik tabulasi nilai kejuaraan maupun jurnal harian ratusan siswa diproses tanpa jeda. Dokumen berita acara atau rapor siap dicetak dalam hitungan detik.',
  },
  {
    icon: '📱',
    label: 'Mobile-First UX',
    title: 'Ramah Jempol untuk Tim Lapangan',
    desc: 'Antarmuka dirancang khusus agar operator, guru, juri, hingga kasir bisa menginput data dalam 1 menit langsung dari smartphone tanpa mencubit layar spreadsheet.',
  },
  {
    icon: '📚',
    label: 'Onboarding & SOP',
    title: 'Panduan Lengkap, Video Tutorial & Pendampingan',
    desc: 'Setiap serah terima sistem disertai dokumentasi langkah demi langkah, video tutorial per tombol, serta pendampingan langsung bersama Kang Apri hingga tim mahir.',
  },
];
---

<Layout seo={seoProps}>
  <div class="pt-28 pb-24 relative overflow-hidden">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 font-medium">
        <a href="/" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">Beranda</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200 font-semibold">Tentang INKARSA</span>
      </nav>

      <!-- Hero Section INKARSA -->
      <section class="rounded-3xl bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 p-6 sm:p-10 lg:p-12 shadow-sm mb-14">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
          <div class="lg:col-span-8 space-y-5">
            <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-cyan-50 dark:bg-cyan-950/60 border border-cyan-200 dark:border-cyan-800 text-cyan-700 dark:text-cyan-400 text-xs font-bold uppercase tracking-wider">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>Profil Resmi Studio Teknologi</span>
            </div>

            <h1 class="type-h1">
              INKARSA: <span class="text-gradient-cyan">Inovasi Karya Semesta Raya</span>
            </h1>

            <p class="text-base sm:text-lg font-semibold text-slate-700 dark:text-slate-200">
              Menumbuhkan Potensi. Menghadirkan Manfaat. Diarsiteki langsung oleh <strong class="text-cyan-700 dark:text-cyan-400">Kang Apri (M. Apriyanto Wijaya)</strong> di Kota Cimahi.
            </p>

            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
              INKARSA lahir dari keyakinan sederhana bahwa sekolah, organisasi kepemudaan, panitia kejuaraan, dan pelaku UMKM berhak memiliki sistem digital yang rapi, cepat, dan mudah dipakai di smartphone, <strong>tanpa harus terjebak biaya langganan software atau sewa server jutaan rupiah setiap bulan</strong>.
            </p>

            <div class="flex flex-wrap items-center gap-3 pt-2">
              <a
                href="https://wa.me/6282118313655?text=Halo%20Kang%20Apri,%20saya%20baru%20membaca%20halaman%20Tentang%20INKARSA%20dan%20ingin%20berdiskusi%20kebutuhan%20sistem%20kami."
                target="_blank"
                rel="noopener noreferrer"
                class="px-6 py-3.5 min-h-[44px] rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-semibold text-xs sm:text-sm hover:bg-slate-800 dark:hover:bg-slate-100 shadow-sm transition-all inline-flex items-center gap-2"
              >
                <span>💬 Konsultasi Langsung dengan Kang Apri</span>
              </a>
              <a
                href="/#proyek"
                class="px-5 py-3.5 min-h-[44px] rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-semibold text-xs sm:text-sm hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors inline-flex items-center gap-2"
              >
                <span>Lihat 5 Mahakarya Sistem →</span>
              </a>
            </div>
          </div>

          <!-- Brand Identity Card -->
          <div class="lg:col-span-4 flex flex-col items-center justify-center p-6 sm:p-8 rounded-2xl bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 text-center">
            <div class="w-24 h-24 rounded-2xl bg-[#142D43] border border-[#315C50]/50 p-3 shadow-lg mb-4 flex items-center justify-center">
              <svg viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full" aria-hidden="true">
                <rect x="25" y="10" width="10" height="44" rx="5" fill="#F5F3EC"/>
                <path d="M 22 40 C 10 40, 6 25, 12 14 C 22 14, 24 28, 22 40 Z" fill="#315C50"/>
                <path d="M 38 40 C 50 40, 54 25, 48 14 C 38 14, 36 28, 38 40 Z" fill="#5C8980"/>
                <circle cx="30" cy="6" r="4.5" fill="#B89A60"/>
              </svg>
            </div>
            <div class="text-xl font-black tracking-widest text-[#142D43] dark:text-slate-100">INKARSA</div>
            <div class="text-[11px] font-bold uppercase tracking-wider text-[#315C50] dark:text-emerald-400 mt-0.5 mb-3">
              Inovasi Karya Semesta Raya
            </div>
            <div class="w-full pt-3 border-t border-slate-200 dark:border-slate-800 space-y-1.5 text-xs text-slate-600 dark:text-slate-300">
              <div><strong>Founder &amp; Architect:</strong> Kang Apri</div>
              <div><strong>Studio:</strong> Cibeber, Kota Cimahi</div>
              <div><strong>Fokus:</strong> SaaS Edukasi, Lomba &amp; UMKM</div>
            </div>
          </div>
        </div>
      </section>

      <!-- Makna Nama & Filosofi Ki Hadjar Dewantara -->
      <section class="mb-14">
        <div class="max-w-3xl mb-8">
          <h2 class="type-h2 mb-3">
            Makna Nama &amp; <span class="text-gradient-cyan">Filosofi Kerja INKARSA</span>
          </h2>
          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
            Berlandaskan nilai kepemimpinan Ki Hadjar Dewantara (Ing Ngarsa Sung Tuladha, Ing Madya Mangun Karsa, Tut Wuri Handayani), setiap baris kode di INKARSA dirancang untuk melayani pengguna di lapangan secara adil dan membumi.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {coreValues.map((item) => (
            <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
              <div class="w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-2xl mb-4">
                {item.icon}
              </div>
              <h3 class="type-h3 mb-2">{item.title}</h3>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                {item.desc}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- Visi & Misi -->
      <section class="mb-14 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-7 rounded-3xl bg-cyan-50/60 dark:bg-cyan-950/30 border border-cyan-200/80 dark:border-cyan-800/60">
          <span class="inline-block px-3 py-1 rounded-full bg-cyan-600 text-white text-[11px] font-bold uppercase tracking-wider mb-3">
            Visi INKARSA
          </span>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-slate-100 mb-3">
            Mendekatkan Teknologi Rapi Tanpa Beban Sewa Server
          </h2>
          <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
            Menjadi mitra teknologi andalan bagi sekolah, madrasah, organisasi kejuaraan, dan pemilik usaha di Indonesia dalam mengubah spreadsheet yang rumit dan catatan kertas manual menjadi sistem kerja modern yang ringan, transparan, dan dimiliki sepenuhnya oleh instansi terkait.
          </p>
        </div>

        <div class="p-7 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
          <span class="inline-block px-3 py-1 rounded-full bg-emerald-600 text-white text-[11px] font-bold uppercase tracking-wider mb-3">
            Misi Utama
          </span>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-slate-100 mb-3">
            Tiga Komitmen Eksekusi Bersama Kang Apri
          </h2>
          <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Memangkas pekerjaan rekap berjam-jam menjadi laporan otomatis 1-klik siap cetak PDF.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Memaksimalkan infrastruktur Google Workspace agar biaya sewa server bulanan tetap Rp 0.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>Menyertakan onboarding terstruktur, video tutorial, dan dokumentasi resmi agar tim cepat mandiri.</span>
            </li>
          </ul>
        </div>
      </section>

      <!-- Profil Kang Apri -->
      <section class="mb-14 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 sm:p-10 shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-4 flex justify-center">
            <div class="w-48 h-48 sm:w-56 sm:h-56 rounded-3xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-3 shadow-md">
              <img
                src="/images/avatar.svg"
                alt="Kang Apri - Pendiri dan Arsitek Sistem INKARSA"
                width="224"
                height="224"
                class="w-full h-full object-cover rounded-2xl"
              />
            </div>
          </div>

          <div class="lg:col-span-8 space-y-4">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-bold">
              <span>👨‍💻</span>
              <span>Profil Arsitek &amp; Pendiri</span>
            </div>
            <h2 class="type-h2">
              Siapa <span class="text-gradient-cyan">Kang Apri</span> (M. Apriyanto Wijaya)?
            </h2>
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
              Kang Apri adalah seorang praktisi otomasi alur kerja, pembina organisasi, dan pengembang sistem asal Kota Cimahi, Jawa Barat. Sebelum memfokuskan INKARSA sebagai studio solusi sistem tanpa server, Kang Apri berpengalaman di industri CRM serta 17 tahun mengabdi sebagai pelatih dan pembina Paskibra di MAN Kota Cimahi dan SMPN 3 Cimahi sejak 2009.
            </p>
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
              Selain mengawal sekolah dan kejuaraan, Kang Apri juga mengelola usaha kuliner Megumi Hotplate Cimahi sebagai laboratorium hidup (*living automation lab*) untuk memastikan setiap sistem kasir, stok bahan baku, dan kalkulasi HPP yang dibangun benar-benar tahan uji di tengah ramainya jam operasional harian.
            </p>
          </div>
        </div>
      </section>

      <!-- 4 Pilar Arsitektur -->
      <section class="mb-14">
        <div class="max-w-3xl mb-8">
          <h2 class="type-h2 mb-3">
            4 Pilar Standar Sistem <span class="text-gradient-cyan">INKARSA</span>
          </h2>
          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300">
            Fondasi teknis dan layanan purna jual yang membedakan INKARSA dari vendor perangkat lunak konvensional.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {architecturePillars.map((p) => (
            <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
              <div class="flex items-center gap-3 mb-3">
                <div class="w-11 h-11 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-xl">
                  {p.icon}
                </div>
                <div>
                  <span class="text-[10px] font-bold uppercase tracking-wider text-cyan-600 dark:text-cyan-400 block">
                    {p.label}
                  </span>
                  <h3 class="type-h3">{p.title}</h3>
                </div>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                {p.desc}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- Ekosistem Produk & Akses Dokumentasi -->
      <section class="mb-14">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
          <div>
            <h2 class="type-h2 mb-2">
              Ekosistem Produk <span class="text-gradient-cyan">Teruji di Lapangan</span>
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300">
              Seluruh sistem di bawah ini sudah aktif dipakai oleh institusi pendidikan, panitia lomba, dan pelaku usaha.
            </p>
          </div>
          <a href="/#faq" class="text-xs sm:text-sm font-bold text-cyan-600 dark:text-cyan-400 hover:underline shrink-0">
            Lihat FAQ, Onboarding &amp; Dokumentasi →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {projects.map((prj) => (
            <a
              href={`/sistem/${prj.slug}`}
              class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-cyan-500/50 transition-all shadow-sm flex flex-col justify-between group"
            >
              <div>
                <span class="inline-block px-2.5 py-0.5 text-[10px] font-bold rounded-md bg-cyan-50 dark:bg-cyan-950/70 text-cyan-700 dark:text-cyan-400 mb-2">
                  {prj.category}
                </span>
                <h3 class="text-sm sm:text-base font-bold text-slate-900 dark:text-slate-100 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors mb-1.5">
                  {prj.title}
                </h3>
                <p class="text-xs text-slate-600 dark:text-slate-300 line-clamp-2 leading-relaxed">
                  {prj.tagline}
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs font-semibold text-cyan-600 dark:text-cyan-400">
                <span>Pelajari Sistem &amp; Setup</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- Closing Banner -->
      <section class="p-8 sm:p-10 rounded-3xl bg-slate-900 dark:bg-slate-900/90 text-white border border-slate-800 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="max-w-2xl space-y-2 text-center md:text-left">
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
            Siap Merapikan Sistem Sekolah, Lomba, atau Bisnis Anda?
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Kunjungi Studio INKARSA di Puri Fajar A5 No. 2, Cibeber, Kota Cimahi atau diskusikan kebutuhan Anda secara online bersama Kang Apri hari ini.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0 w-full md:w-auto">
          <a
            href="https://wa.me/6282118313655?text=Halo%20Kang%20Apri,%20saya%20ingin%20berkonsultasi%20dengan%20INKARSA%20mengenai%20sistem%20untuk%20instansi/bisnis%20kami."
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3.5 min-h-[44px] rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs sm:text-sm text-center transition-colors inline-flex items-center justify-center gap-2"
          >
            <span>💬 Chat WhatsApp Kang Apri</span>
          </a>
          <a
            href="/dokumentasi/komando"
            class="px-5 py-3.5 min-h-[44px] rounded-xl bg-slate-800 hover:bg-slate-700 text-white border border-slate-700 font-semibold text-xs sm:text-sm text-center transition-colors inline-flex items-center justify-center gap-2"
          >
            <span>📖 Dokumentasi Sistem</span>
          </a>
        </div>
      </section>

    </div>
  </div>
</Layout>
