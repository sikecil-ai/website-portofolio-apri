---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/siteConfig';
import { projects } from '../data/projects';
import { skillGroups } from '../data/skills';
import { experiences } from '../data/experiences';
---

<Layout seo={{ title: 'Admin & Content Manager | Kang Apri Portfolio' }}>
  <div class="min-h-screen pt-28 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    
    <!-- Admin Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-8 mb-8 border-b border-slate-200 dark:border-slate-800">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-2">
          ⚡ Admin Data Manager
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100">
          Dashboard Pengelolaan Data Portofolio
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Kelola profil, proyek, keahlian, dan riwayat pengalaman Kang Apri secara visual.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a href="/" class="btn-secondary text-xs sm:text-sm py-2">
          ← Kembali ke Website
        </a>
        <button
          type="button"
          id="export-json-btn"
          class="btn-primary text-xs sm:text-sm py-2 cursor-pointer"
        >
          <span>Salin / Ekspor Konfigurasi</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Tab Navigation -->
    <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 border-b border-slate-200 dark:border-slate-800" id="admin-tabs">
      <button type="button" class="tab-btn active px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-brand-600 text-white transition-all cursor-pointer" data-tab="tab-profile">
        👤 Profil &amp; Kontak
      </button>
      <button type="button" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 transition-all cursor-pointer" data-tab="tab-projects">
        🚀 Proyek &amp; Aplikasi ({projects.length})
      </button>
      <button type="button" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 transition-all cursor-pointer" data-tab="tab-skills">
        🛠️ Keahlian &amp; Tech Stack
      </button>
      <button type="button" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 transition-all cursor-pointer" data-tab="tab-experience">
        💼 Rekam Jejak Karir
      </button>
    </div>

    <!-- Tab 1: Profile & Contact -->
    <div id="tab-profile" class="tab-content block space-y-6">
      <div class="glass-card p-6 sm:p-8 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60">
        <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-4">Informasi Pribadi</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Nama Lengkap</label>
            <input type="text" id="adm-name" value={siteConfig.name} class="w-full px-3.5 py-2 rounded-xl text-xs sm:text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Role / Title Utama</label>
            <input type="text" id="adm-title" value={siteConfig.subtitle} class="w-full px-3.5 py-2 rounded-xl text-xs sm:text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Email Aktif</label>
            <input type="email" id="adm-email" value={siteConfig.email} class="w-full px-3.5 py-2 rounded-xl text-xs sm:text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">No. WhatsApp</label>
            <input type="text" id="adm-phone" value={siteConfig.phone} class="w-full px-3.5 py-2 rounded-xl text-xs sm:text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100" />
          </div>
          <div class="sm:col-span-2">
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Lokasi Lengkap</label>
            <input type="text" id="adm-location" value={siteConfig.location} class="w-full px-3.5 py-2 rounded-xl text-xs sm:text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100" />
          </div>
          <div class="sm:col-span-2">
            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Bio / Deskripsi Profil Singkat</label>
            <textarea id="adm-bio" rows="3" class="w-full px-3.5 py-2 rounded-xl text-xs sm:text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 resize-none">{siteConfig.bio}</textarea>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab 2: Projects -->
    <div id="tab-projects" class="tab-content hidden space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100">Daftar Aplikasi &amp; Sistem Otomasi</h2>
        <button type="button" id="add-project-btn" class="btn-primary text-xs py-2">
          + Tambah Proyek Baru
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {projects.map((proj) => (
          <div class="glass-card p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="px-2.5 py-0.5 text-[10px] font-bold rounded-lg bg-brand-50 dark:bg-brand-950 text-brand-600 dark:text-brand-400 border border-brand-200 dark:border-brand-800">
                  {proj.category}
                </span>
                <span class="text-xs text-slate-400 font-mono">{proj.date}</span>
              </div>
              <h3 class="font-bold text-slate-900 dark:text-slate-100 text-base mb-1">
                {proj.title}
              </h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 mb-3 line-clamp-2">
                {proj.description}
              </p>
              <div class="flex flex-wrap gap-1 mb-4">
                {proj.tags.map(t => (
                  <span class="px-2 py-0.5 text-[10px] rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
                    {t}
                  </span>
                ))}
              </div>
            </div>
            <div class="pt-3 border-t border-slate-200/60 dark:border-slate-800/60 flex items-center justify-between text-xs">
              <span class="text-slate-400">{proj.role}</span>
              <span class="text-emerald-500 font-semibold">Aktif</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Tab 3: Skills -->
    <div id="tab-skills" class="tab-content hidden space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {skillGroups.map((group) => (
          <div class="glass-card p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60">
            <h3 class="font-bold text-slate-900 dark:text-slate-100 text-base mb-2">{group.category}</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">{group.description}</p>
            <div class="space-y-2">
              {group.skills.map((s) => (
                <div class="flex items-center justify-between p-2 rounded-xl bg-slate-50 dark:bg-slate-800/50 text-xs">
                  <span class="font-semibold text-slate-800 dark:text-slate-200">{s.name}</span>
                  <span class="px-2 py-0.5 rounded bg-brand-50 dark:bg-brand-950 text-brand-600 dark:text-brand-400 font-mono text-[10px]">{s.level}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Tab 4: Experiences -->
    <div id="tab-experience" class="tab-content hidden space-y-4">
      {experiences.map((exp) => (
        <div class="glass-card p-5 sm:p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/60">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
            <div>
              <h3 class="font-bold text-slate-900 dark:text-slate-100 text-base">{exp.role}</h3>
              <p class="text-xs font-semibold text-brand-600 dark:text-brand-400">{exp.company} • {exp.location}</p>
            </div>
            <span class="px-2.5 py-1 text-xs rounded-full bg-slate-100 dark:bg-slate-800 font-mono text-slate-600 dark:text-slate-400">{exp.period}</span>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mb-3">{exp.description}</p>
          <ul class="space-y-1 mb-3 text-xs text-slate-500 dark:text-slate-400">
            {exp.highlights.map(h => (
              <li class="flex items-center gap-1.5"><span>✦</span><span>{h}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Export / Copy Modal & Toast -->
    <div id="admin-toast" class="fixed bottom-6 right-6 z-50 hidden p-4 rounded-2xl bg-emerald-600 text-white font-medium text-xs sm:text-sm shadow-xl flex items-center gap-2">
      <span>✓</span>
      <span id="toast-msg">Data konfigurasi berhasil disalin ke clipboard!</span>
    </div>

  </div>
</Layout>

<script>
  const initAdmin = () => {
    const tabs = document.querySelectorAll('.tab-btn');
    const contents = document.querySelectorAll('.tab-content');
    const exportBtn = document.getElementById('export-json-btn');
    const toast = document.getElementById('admin-toast');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-tab');

        tabs.forEach((t) => {
          t.classList.remove('bg-brand-600', 'text-white');
          t.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
        });

        tab.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
        tab.classList.add('bg-brand-600', 'text-white');

        contents.forEach((c) => {
          if (c.id === targetId) {
            c.classList.remove('hidden');
            c.classList.add('block');
          } else {
            c.classList.add('hidden');
            c.classList.remove('block');
          }
        });
      });
    });

    if (exportBtn && toast) {
      exportBtn.addEventListener('click', () => {
        const name = (document.getElementById('adm-name') as HTMLInputElement)?.value;
        const title = (document.getElementById('adm-title') as HTMLInputElement)?.value;
        const email = (document.getElementById('adm-email') as HTMLInputElement)?.value;
        const phone = (document.getElementById('adm-phone') as HTMLInputElement)?.value;
        const location = (document.getElementById('adm-location') as HTMLInputElement)?.value;
        const bio = (document.getElementById('adm-bio') as HTMLTextAreaElement)?.value;

        const configExport = {
          name,
          subtitle: title,
          email,
          phone,
          location,
          bio,
        };

        navigator.clipboard.writeText(JSON.stringify(configExport, null, 2)).then(() => {
          toast.classList.remove('hidden');
          setTimeout(() => {
            toast.classList.add('hidden');
          }, 3000);
        });
      });
    }
  };

  initAdmin();
  document.addEventListener('astro:after-swap', initAdmin);
</script>
