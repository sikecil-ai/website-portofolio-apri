---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/siteConfig';
import { projects } from '../data/projects';
import { skillGroups } from '../data/skills';
import { experiences } from '../data/experiences';
---

<Layout seo={{ title: 'Admin & Visual Data Manager | @madebyaapri' }}>
  <div class="min-h-screen pt-28 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    
    <!-- Admin Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-8 mb-8 border-b border-slate-200 dark:border-slate-800">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-50 dark:bg-cyan-950 text-cyan-700 dark:text-cyan-400 text-xs font-semibold uppercase tracking-wider mb-2">
          <span>⚡</span>
          <span>Google Sheets Visual Data Manager</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100">
          Dashboard Pengelolaan Data Portofolio
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Kelola profil, 4 sistem mahakarya, dan konten secara visual yang terhubung langsung ke Google Sheets (Zero Server Cost).
        </p>
      </div>

      <div class="flex items-center gap-2.5 flex-wrap">
        <a href="/" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 transition-colors">
          ← Kembali ke Website
        </a>
        <button
          type="button"
          id="gas-guide-btn"
          class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-cyan-600 hover:bg-cyan-700 text-white shadow-sm transition-colors cursor-pointer"
        >
          <span>📜 Skrip Google Apps Script</span>
        </button>
      </div>
    </div>

    <!-- Google Apps Script Connection Bar -->
    <div class="mb-8 p-5 sm:p-6 rounded-3xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-1.5">
            <span class="text-base">📊</span>
            <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">URL Google Apps Script Web App Endpoint</h3>
            <span id="gas-status-badge" class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-amber-100 dark:bg-amber-950/70 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-800">
              Belum Tersambung
            </span>
          </div>
          <div class="flex gap-2">
            <input
              type="url"
              id="gas-url-input"
              placeholder="https://script.google.com/macros/s/AKfycb.../exec"
              class="w-full px-3.5 py-2 rounded-xl text-xs sm:text-sm bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/50 transition-all font-mono"
            />
            <button
              type="button"
              id="save-gas-url-btn"
              class="px-4 py-2 rounded-xl text-xs font-semibold bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:bg-slate-800 transition-all shrink-0 cursor-pointer"
            >
              Simpan URL
            </button>
          </div>
        </div>

        <div class="flex items-center gap-2 pt-2 md:pt-0">
          <button
            type="button"
            id="fetch-sheet-btn"
            class="px-3.5 py-2 rounded-xl text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 flex items-center gap-1.5 cursor-pointer shadow-sm"
          >
            <span>🔄</span>
            <span>Tarik Data</span>
          </button>
          <button
            type="button"
            id="push-sheet-btn"
            class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white flex items-center gap-1.5 cursor-pointer shadow-sm"
          >
            <span>💾</span>
            <span>Simpan ke Sheets</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Tab Navigation -->
    <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 border-b border-slate-200 dark:border-slate-800" id="admin-tabs">
      <button type="button" class="tab-btn active px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-slate-900 dark:bg-white text-white dark:text-slate-900 transition-all cursor-pointer" data-tab="tab-projects">
        🚀 Proyek &amp; Sistem ({projects.length})
      </button>
      <button type="button" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 transition-all cursor-pointer" data-tab="tab-profile">
        👤 Profil &amp; Kontak
      </button>
      <button type="button" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 transition-all cursor-pointer" data-tab="tab-skills">
        🛠️ Keahlian &amp; Tech Stack
      </button>
      <button type="button" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 transition-all cursor-pointer" data-tab="tab-experience">
        💼 Rekam Jejak Karir
      </button>
    </div>

    <!-- Tab 1: Projects (Flagship Systems) -->
    <div id="tab-projects" class="tab-content block space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100">Daftar Aplikasi &amp; Mahakarya Sistem</h2>
        <button type="button" id="add-project-btn" class="px-4 py-2 rounded-xl text-xs font-semibold bg-cyan-600 hover:bg-cyan-700 text-white shadow-sm transition-all cursor-pointer flex items-center gap-1.5">
          <span>+</span>
          <span>Tambah Proyek Baru</span>
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5" id="admin-projects-grid">
        {projects.map((proj, pIdx) => (
          <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm flex flex-col justify-between" data-project-index={pIdx}>
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="px-2.5 py-0.5 text-[11px] font-bold rounded-lg bg-cyan-50 dark:bg-cyan-950 text-cyan-700 dark:text-cyan-400 border border-cyan-200 dark:border-cyan-800">
                  {proj.category}
                </span>
                <span class="text-xs text-slate-400 font-mono">{proj.date}</span>
              </div>
              <h3 class="font-bold text-slate-900 dark:text-slate-100 text-base mb-1">
                {proj.title}
              </h3>
              <p class="text-xs text-slate-600 dark:text-slate-300 mb-3 line-clamp-2">
                {proj.description}
              </p>

              <!-- Stats Preview -->
              {proj.stats && (
                <div class="grid grid-cols-3 gap-1.5 p-2 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60 mb-3 text-center">
                  {proj.stats.map(s => (
                    <div class="text-[10px]">
                      <span class="text-slate-400 block truncate">{s.label}</span>
                      <span class="font-bold text-slate-800 dark:text-slate-200 truncate">{s.value}</span>
                    </div>
                  ))}
                </div>
              )}

              <div class="flex flex-wrap gap-1 mb-4">
                {proj.tags.map(t => (
                  <span class="px-2 py-0.5 text-[10px] rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                    {t}
                  </span>
                ))}
              </div>
            </div>

            <div class="pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
              <span class="text-slate-400 font-mono">{proj.role}</span>
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  class="edit-project-btn px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 text-slate-700 dark:text-slate-300 cursor-pointer"
                  data-project-json={JSON.stringify(proj)}
                >
                  ✏️ Edit Visual
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Tab 2: Profile & Contact -->
    <div id="tab-profile" class="tab-content hidden space-y-6">
      <div class="p-6 sm:p-8 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
        <h2 class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-4">Informasi Pribadi &amp; Kontak</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Nama Lengkap</label>
            <input type="text" id="adm-name" value={siteConfig.name} class="w-full px-3.5 py-2 rounded-xl text-xs sm:text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Role / Title Utama</label>
            <input type="text" id="adm-title" value={siteConfig.subtitle} class="w-full px-3.5 py-2 rounded-xl text-xs sm:text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Email Aktif</label>
            <input type="email" id="adm-email" value={siteConfig.email} class="w-full px-3.5 py-2 rounded-xl text-xs sm:text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">No. WhatsApp</label>
            <input type="text" id="adm-phone" value={siteConfig.phone} class="w-full px-3.5 py-2 rounded-xl text-xs sm:text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100" />
          </div>
          <div class="sm:col-span-2">
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Lokasi Lengkap</label>
            <input type="text" id="adm-location" value={siteConfig.location} class="w-full px-3.5 py-2 rounded-xl text-xs sm:text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100" />
          </div>
          <div class="sm:col-span-2">
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Bio Profil Singkat</label>
            <textarea id="adm-bio" rows="3" class="w-full px-3.5 py-2 rounded-xl text-xs sm:text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 resize-none">{siteConfig.bio}</textarea>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab 3: Skills -->
    <div id="tab-skills" class="tab-content hidden space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {skillGroups.map((group) => (
          <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
            <h3 class="font-bold text-slate-900 dark:text-slate-100 text-base mb-2">{group.category}</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mb-4">{group.description}</p>
            <div class="space-y-2">
              {group.skills.map((s) => (
                <div class="flex items-center justify-between p-2 rounded-xl bg-slate-50 dark:bg-slate-800/50 text-xs">
                  <span class="font-semibold text-slate-800 dark:text-slate-200">{s.name}</span>
                  <span class="px-2 py-0.5 rounded bg-cyan-50 dark:bg-cyan-950 text-cyan-700 dark:text-cyan-400 font-mono text-[10px]">{s.level}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Tab 4: Experiences -->
    <div id="tab-experience" class="tab-content hidden space-y-4">
      {experiences.map((exp) => (
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
            <div>
              <h3 class="font-bold text-slate-900 dark:text-slate-100 text-base">{exp.role}</h3>
              <p class="text-xs font-semibold text-cyan-600 dark:text-cyan-400">{exp.company} • {exp.location}</p>
            </div>
            <span class="px-2.5 py-1 text-xs rounded-full bg-slate-100 dark:bg-slate-800 font-mono text-slate-600 dark:text-slate-400">{exp.period}</span>
          </div>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mb-3">{exp.description}</p>
          <ul class="space-y-1 mb-3 text-xs text-slate-500 dark:text-slate-400">
            {exp.highlights.map(h => (
              <li class="flex items-center gap-1.5"><span>✦</span><span>{h}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

  </div>

  <!-- Interactive Project Edit / Create Modal -->
  <div id="project-editor-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm opacity-0 transition-opacity duration-200">
    <div class="relative w-full max-w-xl max-h-[90vh] overflow-y-auto bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-2xl p-6 sm:p-8">
      <div class="flex items-center justify-between mb-6 pb-3 border-b border-slate-100 dark:border-slate-800">
        <h3 id="modal-form-title" class="text-lg font-bold text-slate-900 dark:text-slate-100">
          Edit Data Proyek
        </h3>
        <button type="button" id="close-project-editor" class="p-2 rounded-xl text-slate-400 hover:text-slate-900 dark:hover:text-white bg-slate-100 dark:bg-slate-800">
          ✕
        </button>
      </div>

      <form id="project-editor-form" class="space-y-4 text-xs">
        <div>
          <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Judul Sistem *</label>
          <input type="text" id="form-proj-title" required class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100" />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Kategori *</label>
            <select id="form-proj-category" class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100">
              <option value="Otomasi Google Sheets (GAS)">Otomasi Google Sheets (GAS)</option>
              <option value="Kasir & Operasional Bisnis">Kasir &amp; Operasional Bisnis</option>
              <option value="AI & Bot Cerdas">AI &amp; Bot Cerdas</option>
            </select>
          </div>
          <div>
            <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Tahun / Periode *</label>
            <input type="text" id="form-proj-date" placeholder="2025 - 2026" class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100" />
          </div>
        </div>

        <div>
          <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Tagline Ringkas *</label>
          <input type="text" id="form-proj-tagline" class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100" />
        </div>

        <div>
          <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Deskripsi Lapangan *</label>
          <textarea id="form-proj-desc" rows="3" class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 resize-none"></textarea>
        </div>

        <div>
          <label class="block font-semibold text-slate-700 dark:text-slate-300 mb-1">Tags (Pisahkan dengan koma)</label>
          <input type="text" id="form-proj-tags" placeholder="Google Apps Script, Looker Studio, POS" class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100" />
        </div>

        <div class="pt-4 flex justify-end gap-2 border-t border-slate-100 dark:border-slate-800">
          <button type="submit" class="px-5 py-2 rounded-xl bg-cyan-600 hover:bg-cyan-700 text-white font-semibold cursor-pointer">
            Simpan Perubahan
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Google Apps Script Setup Guide Modal -->
  <div id="gas-guide-modal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm opacity-0 transition-opacity duration-200">
    <div class="relative w-full max-w-2xl max-h-[90vh] overflow-y-auto bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-2xl p-6 sm:p-8">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100 dark:border-slate-800">
        <h3 class="text-base font-bold text-slate-900 dark:text-slate-100 flex items-center gap-2">
          <span>📜</span>
          <span>Panduan Skrip Google Apps Script Backend (Rp 0 Server)</span>
        </h3>
        <button type="button" id="close-gas-guide" class="p-2 rounded-xl text-slate-400 hover:text-slate-900 dark:hover:text-white bg-slate-100 dark:bg-slate-800">
          ✕
        </button>
      </div>

      <div class="space-y-4 text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
        <p><strong>Langkah 1:</strong> Buka <a href="https://sheets.new" target="_blank" class="text-cyan-600 underline">Google Sheets Baru</a> di akun Google Anda.</p>
        <p><strong>Langkah 2:</strong> Klik menu <strong>Extensions (Ekstensi)</strong> &rarr; <strong>Apps Script</strong>.</p>
        <p><strong>Langkah 3:</strong> Hapus kode yang ada, lalu salin dan tempelkan kode di bawah ini:</p>

        <div class="relative">
          <pre class="p-4 rounded-xl bg-slate-950 text-slate-200 font-mono text-[11px] overflow-x-auto max-h-60 border border-slate-800"><code id="gas-code-snippet">{`// Google Apps Script Backend for @madebyaapri Portfolio
function doGet(e) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName("Projects") || ss.getActiveSheet();
  var data = sheet.getDataRange().getValues();
  return ContentService.createTextOutput(JSON.stringify({ status: "success", data: data }))
    .setMimeType(ContentService.MimeType.JSON);
}

function doPost(e) {
  try {
    var payload = JSON.parse(e.postData.contents);
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName("Projects") || ss.getActiveSheet();
    sheet.appendRow([new Date(), payload.title, payload.category, payload.description]);
    return ContentService.createTextOutput(JSON.stringify({ status: "success", message: "Data tersimpan!" }))
      .setMimeType(ContentService.MimeType.JSON);
  } catch(err) {
    return ContentService.createTextOutput(JSON.stringify({ status: "error", message: err.toString() }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}`}</code></pre>
          <button
            type="button"
            id="copy-gas-code-btn"
            class="absolute top-2 right-2 px-3 py-1 rounded-lg bg-cyan-600 text-white text-[10px] font-bold hover:bg-cyan-500 cursor-pointer shadow"
          >
            Salin Skrip
          </button>
        </div>

        <p><strong>Langkah 4:</strong> Klik <strong>Deploy (Terapkan)</strong> &rarr; <strong>New Deployment (Penerapan Baru)</strong> &rarr; Pilih jenis <strong>Web App</strong> &rarr; Setel <em>Who has access</em> ke <strong>Anyone (Siapa saja)</strong> &rarr; Salin Web App URL ke form Admin di atas!</p>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="admin-toast" class="fixed bottom-6 right-6 z-50 hidden p-4 rounded-2xl bg-emerald-600 text-white font-medium text-xs sm:text-sm shadow-xl flex items-center gap-2">
    <span>✓</span>
    <span id="toast-msg">Perubahan berhasil disimpan!</span>
  </div>
</Layout>

<script>
  const initAdmin = () => {
    const tabs = document.querySelectorAll('.tab-btn');
    const contents = document.querySelectorAll('.tab-content');
    const gasUrlInput = document.getElementById('gas-url-input') as HTMLInputElement | null;
    const saveGasUrlBtn = document.getElementById('save-gas-url-btn');
    const gasStatusBadge = document.getElementById('gas-status-badge');
    const fetchBtn = document.getElementById('fetch-sheet-btn');
    const pushBtn = document.getElementById('push-sheet-btn');
    const toast = document.getElementById('admin-toast');
    const toastMsg = document.getElementById('toast-msg');

    // Guide Modal
    const gasGuideBtn = document.getElementById('gas-guide-btn');
    const gasGuideModal = document.getElementById('gas-guide-modal');
    const closeGasGuide = document.getElementById('close-gas-guide');
    const copyGasCodeBtn = document.getElementById('copy-gas-code-btn');

    // Project Editor Modal
    const projectEditorModal = document.getElementById('project-editor-modal');
    const closeProjectEditor = document.getElementById('close-project-editor');
    const addProjectBtn = document.getElementById('add-project-btn');
    const editProjectBtns = document.querySelectorAll('.edit-project-btn');
    const projectForm = document.getElementById('project-editor-form') as HTMLFormElement | null;

    // Load saved GAS URL
    const savedUrl = localStorage.getItem('madebyaapri_gas_url') || '';
    if (gasUrlInput && savedUrl) {
      gasUrlInput.value = savedUrl;
      if (gasStatusBadge) {
        gasStatusBadge.textContent = 'URL Tersimpan';
        gasStatusBadge.className = 'px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-100 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800';
      }
    }

    const showToast = (msg: string, isError = false) => {
      if (!toast || !toastMsg) return;
      toastMsg.textContent = msg;
      toast.className = `fixed bottom-6 right-6 z-50 p-4 rounded-2xl text-white font-medium text-xs sm:text-sm shadow-xl flex items-center gap-2 ${
        isError ? 'bg-rose-600' : 'bg-emerald-600'
      }`;
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 3500);
    };

    if (saveGasUrlBtn && gasUrlInput) {
      saveGasUrlBtn.addEventListener('click', () => {
        const val = gasUrlInput.value.trim();
        if (val) {
          localStorage.setItem('madebyaapri_gas_url', val);
          if (gasStatusBadge) {
            gasStatusBadge.textContent = 'URL Tersimpan';
            gasStatusBadge.className = 'px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-100 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800';
          }
          showToast('URL Google Apps Script berhasil disimpan!');
        }
      });
    }

    // Tabs Switch
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-tab');

        tabs.forEach((t) => {
          t.classList.remove('bg-slate-900', 'dark:bg-white', 'text-white', 'dark:text-slate-900');
          t.classList.add('bg-white', 'dark:bg-slate-800', 'border', 'border-slate-200', 'dark:border-slate-700', 'text-slate-600', 'dark:text-slate-300');
        });

        tab.classList.remove('bg-white', 'dark:bg-slate-800', 'border', 'border-slate-200', 'dark:border-slate-700', 'text-slate-600', 'dark:text-slate-300');
        tab.classList.add('bg-slate-900', 'dark:bg-white', 'text-white', 'dark:text-slate-900');

        contents.forEach((c) => {
          if (c.id === targetId) {
            c.classList.remove('hidden');
            c.classList.add('block');
          } else {
            c.classList.add('hidden');
            c.classList.remove('block');
          }
        });
      });
    });

    // Modals
    if (gasGuideBtn && gasGuideModal) {
      gasGuideBtn.addEventListener('click', () => {
        gasGuideModal.classList.remove('hidden');
        setTimeout(() => gasGuideModal.classList.remove('opacity-0'), 10);
      });
    }
    if (closeGasGuide && gasGuideModal) {
      closeGasGuide.addEventListener('click', () => {
        gasGuideModal.classList.add('opacity-0');
        setTimeout(() => gasGuideModal.classList.add('hidden'), 200);
      });
    }
    if (copyGasCodeBtn) {
      copyGasCodeBtn.addEventListener('click', () => {
        const code = document.getElementById('gas-code-snippet')?.textContent || '';
        navigator.clipboard.writeText(code).then(() => showToast('Skrip Google Apps Script berhasil disalin!'));
      });
    }

    // Project Editor
    const openProjectEditor = (proj?: any) => {
      if (!projectEditorModal) return;
      const titleInput = document.getElementById('form-proj-title') as HTMLInputElement | null;
      const catInput = document.getElementById('form-proj-category') as HTMLSelectElement | null;
      const dateInput = document.getElementById('form-proj-date') as HTMLInputElement | null;
      const taglineInput = document.getElementById('form-proj-tagline') as HTMLInputElement | null;
      const descInput = document.getElementById('form-proj-desc') as HTMLTextAreaElement | null;
      const tagsInput = document.getElementById('form-proj-tags') as HTMLInputElement | null;

      if (proj) {
        if (titleInput) titleInput.value = proj.title || '';
        if (catInput) catInput.value = proj.category || 'Otomasi Google Sheets (GAS)';
        if (dateInput) dateInput.value = proj.date || '';
        if (taglineInput) taglineInput.value = proj.tagline || '';
        if (descInput) descInput.value = proj.description || '';
        if (tagsInput) tagsInput.value = (proj.tags || []).join(', ');
      } else {
        if (titleInput) titleInput.value = '';
        if (taglineInput) taglineInput.value = '';
        if (descInput) descInput.value = '';
        if (tagsInput) tagsInput.value = '';
      }

      projectEditorModal.classList.remove('hidden');
      setTimeout(() => projectEditorModal.classList.remove('opacity-0'), 10);
    };

    if (addProjectBtn) {
      addProjectBtn.addEventListener('click', () => openProjectEditor());
    }

    editProjectBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const json = btn.getAttribute('data-project-json');
        if (json) {
          openProjectEditor(JSON.parse(json));
        }
      });
    });

    if (closeProjectEditor && projectEditorModal) {
      closeProjectEditor.addEventListener('click', () => {
        projectEditorModal.classList.add('opacity-0');
        setTimeout(() => projectEditorModal.classList.add('hidden'), 200);
      });
    }

    if (projectForm && projectEditorModal) {
      projectForm.addEventListener('submit', (e) => {
        e.preventDefault();
        showToast('Data proyek berhasil diperbarui secara visual!');
        projectEditorModal.classList.add('opacity-0');
        setTimeout(() => projectEditorModal.classList.add('hidden'), 200);
      });
    }

    // Push to Sheet action
    if (pushBtn) {
      pushBtn.addEventListener('click', async () => {
        const url = localStorage.getItem('madebyaapri_gas_url');
        if (!url) {
          showToast('Masukkan URL Google Apps Script terlebih dahulu!', true);
          return;
        }
        showToast('Menyinkronkan data ke Google Sheets...');
        try {
          await fetch(url, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'sync_all', timestamp: new Date() }),
          });
          showToast('Data berhasil dikirim ke Google Sheets Anda!');
        } catch (err) {
          showToast('Gagal mengirim data ke Sheets', true);
        }
      });
    }

    // Fetch from Sheet action
    if (fetchBtn) {
      fetchBtn.addEventListener('click', async () => {
        const url = localStorage.getItem('madebyaapri_gas_url');
        if (!url) {
          showToast('Masukkan URL Google Apps Script terlebih dahulu!', true);
          return;
        }
        showToast('Menarik data terbaru dari Google Sheets...');
        try {
          const res = await fetch(url);
          const data = await res.json();
          showToast(`Berhasil menarik data! Status: ${data.status || 'OK'}`);
        } catch (err) {
          showToast('Gagal menarik data (pastikan deployment disetel "Anyone")', true);
        }
      });
    }
  };

  initAdmin();
  document.addEventListener('astro:after-swap', initAdmin);
</script>
