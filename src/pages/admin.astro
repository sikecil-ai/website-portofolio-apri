      category: aData[i][2],
      readTime: aData[i][3],
      date: aData[i][4],
      excerpt: aData[i][5]
    });
  }

  var profile = {};
  for (var i = 1; i < profData.length; i++) {
    profile[profData[i][0]] = profData[i][1];
  }
  
  return ContentService.createTextOutput(JSON.stringify({
