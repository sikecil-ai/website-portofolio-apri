---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/siteConfig';
import { projects } from '../data/projects';
import { articles } from '../data/articles';
import { skillGroups } from '../data/skills';
import { experiences } from '../data/experiences';
---

<Layout seo={{ title: 'Admin & Visual Data Manager | @madebyaapri' }}>
  <div class="min-h-screen pt-24 pb-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    
    <!-- AUTH GATE: Password Protection Screen -->
    <div id="admin-auth-gate" class="max-w-md mx-auto my-12 p-8 sm:p-10 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xl relative z-20">
      <div class="text-center mb-8">
        <div class="w-14 h-14 mx-auto rounded-2xl bg-cyan-50 dark:bg-cyan-950/80 border border-cyan-200 dark:border-cyan-800 text-cyan-600 dark:text-cyan-400 flex items-center justify-center text-2xl shadow-sm mb-4">
          🔒
        </div>
        <h2 class="text-2xl font-extrabold text-slate-900 dark:text-slate-100">
          Admin Gatekeeper
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
          Halaman ini terproteksi. Masukkan kata sandi admin untuk mengelola data @madebyaapri.
        </p>
      </div>

      <form id="admin-login-form" class="space-y-4">
        <div>
          <label for="admin-password-input" class="block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5">
            Kata Sandi Admin
          </label>
          <div class="relative">
            <input
              type="password"
              id="admin-password-input"
              placeholder="Masukkan password admin..."
              required
              class="w-full px-4 py-3 rounded-xl text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/50 transition-all font-mono"
            />
            <button
              type="button"
              id="toggle-pwd-visibility"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 p-1"
            >
              👁️
            </button>
          </div>
          <p id="auth-error-msg" class="hidden text-xs text-red-500 dark:text-red-400 font-semibold mt-2 flex items-center gap-1">
            <span>⚠️</span>
            <span>Kata sandi salah! Akses ditolak.</span>
          </p>
        </div>

        <div class="flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 pt-1">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" id="remember-admin-login" checked class="rounded border-slate-300 dark:border-slate-700 text-cyan-600 focus:ring-cyan-500" />
            <span>Ingat sesi di browser ini</span>
          </label>
        </div>

        <button
          type="submit"
          id="btn-login-submit"
          class="w-full py-3 px-4 rounded-xl font-bold text-sm bg-slate-900 dark:bg-white text-white dark:text-slate-900 shadow-md hover:bg-slate-800 dark:hover:bg-slate-100 transition-all active:scale-98 cursor-pointer mt-2"
        >
          Buka Dashboard Admin →
        </button>
      </form>

      <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-800 text-center">
        <a href="/" class="text-xs font-semibold text-slate-500 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
          ← Kembali ke Website Utama
        </a>
      </div>
    </div>

    <!-- MAIN ADMIN CONTENT (Hidden Until Authenticated) -->
    <div id="admin-main-content" style="display: none;">
      
      <!-- Admin Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-8 mb-8 border-b border-slate-200 dark:border-slate-800">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-50 dark:bg-cyan-950 text-cyan-700 dark:text-cyan-400 text-xs font-semibold uppercase tracking-wider mb-2">
            <span>⚡</span>
            <span>Google Sheets Visual Data Manager</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100">
            Dashboard Pengelolaan Data Portofolio
          </h1>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
            Kelola profil, 4 sistem mahakarya, dan konten secara visual yang terhubung langsung ke Google Sheets (Zero Server Cost).
          </p>
        </div>

        <div class="flex items-center gap-2.5 flex-wrap">
          <a href="/" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 transition-colors">
            ← Website
          </a>
          <button
            type="button"
            id="change-pwd-btn"
            class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 transition-colors cursor-pointer"
          >
            <span>🔑 Ganti Sandi</span>
          </button>
          <button
            type="button"
            id="gas-guide-btn"
            class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-cyan-600 hover:bg-cyan-700 text-white shadow-sm transition-colors cursor-pointer"
          >
            <span>📜 Skrip GAS</span>
          </button>
          <button
            type="button"
            id="admin-logout-btn"
            class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-red-50 dark:bg-red-950/70 border border-red-200 dark:border-red-800 text-red-600 dark:text-red-400 hover:bg-red-100 transition-colors cursor-pointer"
          >
            <span>🔒 Keluar</span>
          </button>
        </div>
      </div>

      <!-- Google Apps Script Connection Bar -->
      <div class="mb-8 p-5 sm:p-6 rounded-3xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-1.5">
              <span class="text-base">📊</span>
              <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100">URL Google Apps Script Web App Endpoint</h3>
              <span id="gas-status-badge" class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-amber-100 dark:bg-amber-950/70 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-800">
                Belum Tersambung
              </span>
            </div>
            <div class="flex gap-2">
              <input
                type="url"
                id="gas-url-input"
                placeholder="https://script.google.com/macros/s/AKfycb.../exec"
                class="w-full px-3.5 py-2 rounded-xl text-xs sm:text-sm bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/50 transition-all font-mono"
              />
              <button
                type="button"
                id="save-gas-url-btn"
                class="px-4 py-2 rounded-xl text-xs font-semibold bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:bg-slate-800 transition-all shrink-0 cursor-pointer"
              >
                Simpan URL
              </button>
            </div>
          </div>

          <div class="flex items-center gap-2 pt-2 md:pt-0">
            <button
              type="button"
              id="fetch-sheet-btn"
              class="px-3.5 py-2 rounded-xl text-xs font-semibold border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 flex items-center gap-1.5 cursor-pointer shadow-sm"
            >
              <span>🔄</span>
              <span>Tarik Data</span>
            </button>
            <button
              type="button"
              id="push-sheet-btn"
              class="px-3.5 py-2 rounded-xl text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white flex items-center gap-1.5 cursor-pointer shadow-sm"
            >
              <span>💾</span>
              <span>Simpan ke Sheets</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Tab Navigation -->
      <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 border-b border-slate-200 dark:border-slate-800" id="admin-tabs">
        <button type="button" class="tab-btn active px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-slate-900 dark:bg-white text-white dark:text-slate-900 transition-all cursor-pointer" data-tab="tab-projects">
          🚀 Proyek &amp; Sistem ({projects.length})
        </button>
        <button type="button" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 transition-all cursor-pointer" data-tab="tab-profile">
          👤 Profil &amp; Kontak
        </button>
        <button type="button" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 transition-all cursor-pointer" data-tab="tab-skills">
          🛠️ Keahlian &amp; Tech Stack
        </button>
        <button type="button" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 transition-all cursor-pointer" data-tab="tab-experience">
          💼 Rekam Jejak
        </button>
        <button type="button" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 transition-all cursor-pointer" data-tab="tab-articles">
          📰 Artikel ({articles.length})
        </button>
        <button type="button" class="tab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 transition-all cursor-pointer" data-tab="tab-images">
          🖼️ Kelola Gambar
        </button>
      </div>

      <!-- TAB 1: PROJECTS & SYSTEMS -->
      <div id="tab-projects" class="tab-content">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {projects.map((p) => (
            <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-cyan-50 dark:bg-cyan-950 text-cyan-700 dark:text-cyan-400 border border-cyan-200/60 dark:border-cyan-800/60">
                    {p.category}
                  </span>
                  <span class="text-xs text-slate-500 font-mono">{p.date}</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-1">{p.title}</h3>
                <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-4">{p.tagline}</p>
                <div class="flex flex-wrap gap-1.5 mb-4">
                  {p.tags.map((t) => (
                    <span class="px-2 py-0.5 rounded-md text-[10px] bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                      {t}
                    </span>
                  ))}
                </div>
              </div>
              <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <a href={`/sistem/${p.slug}`} target="_blank" class="text-xs font-semibold text-cyan-600 dark:text-cyan-400 hover:underline">
                  Lihat Halaman →
                </a>
                <button
                  type="button"
                  class="edit-project-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 transition-colors cursor-pointer"
                  data-project-json={JSON.stringify(p)}
                >
                  ✏️ Edit Visual
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- TAB 2: PROFILE & CONTACT -->
      <div id="tab-profile" class="tab-content hidden">
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm max-w-3xl">
          <h3 class="text-base font-bold text-slate-900 dark:text-slate-100 mb-4">Informasi Identitas &amp; Kontak</h3>
          <div class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-slate-500 mb-1">Nama Lengkap</label>
              <input type="text" value={siteConfig.name} class="w-full px-3 py-2 rounded-xl text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-500 mb-1">Headline Utama</label>
              <input type="text" value={siteConfig.title} class="w-full px-3 py-2 rounded-xl text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-500 mb-1">Nomor WhatsApp</label>
              <input type="text" value={siteConfig.phone} class="w-full px-3 py-2 rounded-xl text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 font-mono" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-500 mb-1">Domisili Operasional</label>
              <input type="text" value={siteConfig.location} class="w-full px-3 py-2 rounded-xl text-sm bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100" />
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 3: SKILLS -->
      <div id="tab-skills" class="tab-content hidden">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {skillGroups.map((g) => (
            <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
              <h3 class="text-base font-bold text-slate-900 dark:text-slate-100 mb-3">{g.title}</h3>
              <div class="flex flex-wrap gap-2">
                {g.skills.map((s) => (
                  <span class="px-3 py-1.5 rounded-xl text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                    {s.name} ({s.level}%)
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- TAB 4: EXPERIENCE -->
      <div id="tab-experience" class="tab-content hidden">
        <div class="space-y-4 max-w-3xl">
          {experiences.map((exp) => (
            <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
              <div class="flex items-center justify-between mb-2">
                <h4 class="text-base font-bold text-slate-900 dark:text-slate-100">{exp.role} • {exp.company}</h4>
                <span class="text-xs text-slate-500 font-mono">{exp.period}</span>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{exp.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- TAB 5: ARTICLES -->
      <div id="tab-articles" class="tab-content hidden">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {articles.map((a) => (
            <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-cyan-50 dark:bg-cyan-950 text-cyan-700 dark:text-cyan-400 border border-cyan-200/60 dark:border-cyan-800/60">
                    {a.category}
                  </span>
                  <span class="text-xs text-slate-500 font-mono">{a.readTime}</span>
                </div>
                <h3 class="text-base font-bold text-slate-900 dark:text-slate-100 mb-2 line-clamp-2">{a.title}</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mb-4 line-clamp-3 leading-relaxed">{a.excerpt}</p>
              </div>
              <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between">
                <a href={`/artikel/${a.slug}`} target="_blank" class="text-xs font-semibold text-cyan-600 dark:text-cyan-400 hover:underline">
                  Baca Artikel →
                </a>
                <button
                  type="button"
                  class="edit-article-btn px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 transition-colors cursor-pointer"
                  data-article-json={JSON.stringify(a)}
                >
                  ✏️ Edit Artikel
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- TAB 6: KELOLA GAMBAR & ASET VISUAL -->
      <div id="tab-images" class="tab-content hidden">
        <!-- Practical Guide Box -->
        <div class="mb-8 p-6 sm:p-8 rounded-3xl bg-gradient-to-br from-cyan-950/40 via-slate-900 to-slate-900 border border-cyan-500/30 text-slate-200 shadow-md">
          <div class="flex items-center gap-2 text-cyan-400 font-bold text-sm sm:text-base mb-2">
            <span>🖼️</span>
            <span>Cara Update Gambar & Mockup di Portofolio Ini</span>
          </div>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-4">
            Karena website ini dibuat dengan teknologi Astro SSG (Static Site Generator) berkinerja tinggi, gambar disimpan langsung di dalam folder proyek Anda agar loading secepat kilat:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
            <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
              <strong class="text-cyan-300 block mb-1">Cara 1 (Paling Mudah):</strong>
              <p class="text-slate-300 m-0">Kirim/drag & drop file gambar langsung ke obrolan Antigravity Agent. AI yang akan otomatis menempatkan, optimasi, dan push ke Vercel.</p>
            </div>
            <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
              <strong class="text-emerald-300 block mb-1">Cara 2 (Folder Laptop):</strong>
              <p class="text-slate-300 m-0">Copy file gambar ke folder <code class="text-emerald-400 font-mono">public/images/</code>. Nanti path-nya tinggal dipanggil <code class="font-mono text-emerald-400">/images/nama-file.png</code>.</p>
            </div>
            <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
              <strong class="text-amber-300 block mb-1">Cara 3 (Link Cloud):</strong>
              <p class="text-slate-300 m-0">Upload ke Google Drive atau Cloudinary, lalu paste link gambar publiknya ke form edit proyek di dashboard ini.</p>
            </div>
          </div>
        </div>

        <!-- Current Images Gallery Grid -->
        <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-4 flex items-center gap-2">
          <span>📁</span>
          <span>Daftar Gambar Aktif di Folder public/images/</span>
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
            <div class="w-full aspect-[16/9] rounded-xl overflow-hidden bg-slate-950 mb-3 border border-slate-200 dark:border-slate-800">
              <img src="/images/og-komando-organisasi.png" alt="KOMANDO" class="w-full h-full object-cover" />
            </div>
            <div>
              <span class="text-xs font-bold text-slate-900 dark:text-slate-100 block truncate">og-komando-organisasi.png</span>
              <span class="text-[11px] text-slate-500 font-mono block mb-3">/images/og-komando-organisasi.png</span>
              <button type="button" class="copy-img-path-btn w-full py-2 px-3 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 hover:bg-cyan-50 dark:hover:bg-cyan-950/50 hover:text-cyan-600 dark:hover:text-cyan-400 border border-slate-200 dark:border-slate-700 transition-colors cursor-pointer" data-path="/images/og-komando-organisasi.png">
                📋 Salin Path Gambar
              </button>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
            <div class="w-full aspect-[16/9] rounded-xl overflow-hidden bg-slate-950 mb-3 border border-slate-200 dark:border-slate-800">
              <img src="/images/og-si-paling-rekap.png" alt="Si Paling Rekap" class="w-full h-full object-cover" />
            </div>
            <div>
              <span class="text-xs font-bold text-slate-900 dark:text-slate-100 block truncate">og-si-paling-rekap.png</span>
              <span class="text-[11px] text-slate-500 font-mono block mb-3">/images/og-si-paling-rekap.png</span>
              <button type="button" class="copy-img-path-btn w-full py-2 px-3 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 hover:bg-cyan-50 dark:hover:bg-cyan-950/50 hover:text-cyan-600 dark:hover:text-cyan-400 border border-slate-200 dark:border-slate-700 transition-colors cursor-pointer" data-path="/images/og-si-paling-rekap.png">
                📋 Salin Path Gambar
              </button>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
            <div class="w-full aspect-[16/9] rounded-xl overflow-hidden bg-slate-950 mb-3 border border-slate-200 dark:border-slate-800">
              <img src="/images/og-si-paling-kasir.png" alt="Si Paling Kasir" class="w-full h-full object-cover" />
            </div>
            <div>
              <span class="text-xs font-bold text-slate-900 dark:text-slate-100 block truncate">og-si-paling-kasir.png</span>
              <span class="text-[11px] text-slate-500 font-mono block mb-3">/images/og-si-paling-kasir.png</span>
