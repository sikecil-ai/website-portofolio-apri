function doGet(e) {
  var ss = getTargetSpreadsheet();
  initMasterSheets(ss);
  
  var pData = ss.getSheetByName("Proyek").getDataRange().getValues();
  var aData = ss.getSheetByName("Artikel").getDataRange().getValues();
  var profData = ss.getSheetByName("Profil").getDataRange().getValues();
  var kData = ss.getSheetByName("Keahlian").getDataRange().getValues();
  
  var projects = [];
  for (var i = 1; i < pData.length; i++) {
    projects.push({
      id: pData[i][0],
