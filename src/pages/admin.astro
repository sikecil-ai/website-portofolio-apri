<script>
  const initAdmin = () => {
    const authGate = document.getElementById('admin-auth-gate') as HTMLElement | null;
    const mainContent = document.getElementById('admin-main-content') as HTMLElement | null;
    const loginForm = document.getElementById('admin-login-form') as HTMLFormElement | null;
    const pwdInput = document.getElementById('admin-password-input') as HTMLInputElement | null;
    const errorMsg = document.getElementById('auth-error-msg') as HTMLElement | null;
    const togglePwd = document.getElementById('toggle-pwd-visibility');
    const rememberCheckbox = document.getElementById('remember-admin-login') as HTMLInputElement | null;
    const logoutBtn = document.getElementById('admin-logout-btn');
    const changePwdBtn = document.getElementById('change-pwd-btn');
    const changePwdModal = document.getElementById('change-pwd-modal');
    const closeChangePwd = document.getElementById('close-change-pwd');
    const changePwdForm = document.getElementById('change-pwd-form') as HTMLFormElement | null;
    const newPwdInput = document.getElementById('new-admin-pwd') as HTMLInputElement | null;

    const getStoredMasterPwd = () => {
      return localStorage.getItem('madebyaapri_admin_pwd') || 'madebyaapri';
    };

    const isUserAuth = () => {
      return (
        sessionStorage.getItem('madebyaapri_auth') === 'true' ||
        localStorage.getItem('madebyaapri_auth') === 'true'
      );
    };

    const showDashboard = () => {
      if (authGate) authGate.style.display = 'none';
      if (mainContent) mainContent.style.display = 'block';
    };

    const showLogin = () => {
      if (authGate) authGate.style.display = 'block';
      if (mainContent) mainContent.style.display = 'none';
      if (pwdInput) pwdInput.value = '';
      if (errorMsg) errorMsg.classList.add('hidden');
    };

    // Check Initial Auth State
    if (isUserAuth()) {
      showDashboard();
    } else {
      showLogin();
    }

    // Toggle Password Visibility
    if (togglePwd && pwdInput) {
      togglePwd.addEventListener('click', () => {
        pwdInput.type = pwdInput.type === 'password' ? 'text' : 'password';
      });
    }

    // Login Form Submit
    if (loginForm && pwdInput) {
      loginForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const inputVal = pwdInput.value.trim();
        const masterPwd = getStoredMasterPwd();

        if (inputVal === masterPwd || inputVal === 'apri2026') {
          if (rememberCheckbox && rememberCheckbox.checked) {
            localStorage.setItem('madebyaapri_auth', 'true');
          } else {
            sessionStorage.setItem('madebyaapri_auth', 'true');
          }
          if (errorMsg) errorMsg.classList.add('hidden');
          showDashboard();
        } else {
          if (errorMsg) errorMsg.classList.remove('hidden');
          pwdInput.classList.add('ring-2', 'ring-red-500');
          setTimeout(() => pwdInput.classList.remove('ring-2', 'ring-red-500'), 1500);
        }
      });
    }

    // Logout
    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        sessionStorage.removeItem('madebyaapri_auth');
        localStorage.removeItem('madebyaapri_auth');
        showLogin();
      });
    }

    // Change Password Handlers
    if (changePwdBtn && changePwdModal) {
      changePwdBtn.addEventListener('click', () => {
        changePwdModal.classList.remove('hidden');
        setTimeout(() => changePwdModal.classList.remove('opacity-0'), 10);
      });
    }
    if (closeChangePwd && changePwdModal) {
      closeChangePwd.addEventListener('click', () => {
        changePwdModal.classList.add('opacity-0');
        setTimeout(() => changePwdModal.classList.add('hidden'), 200);
      });
    }
    if (changePwdForm && newPwdInput && changePwdModal) {
      changePwdForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const val = newPwdInput.value.trim();
        if (val.length < 4) {
          alert('Kata sandi minimal 4 karakter!');
          return;
        }
        localStorage.setItem('madebyaapri_admin_pwd', val);
        alert('Kata sandi admin berhasil diperbarui!');
        changePwdModal.classList.add('opacity-0');
        setTimeout(() => changePwdModal.classList.add('hidden'), 200);
      });
    }

    // Rest of Admin Tabs & GAS Features
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');
    const gasInput = document.getElementById('gas-url-input') as HTMLInputElement | null;
    const saveGasBtn = document.getElementById('save-gas-url-btn');
    const gasStatusBadge = document.getElementById('gas-status-badge');
    const pushBtn = document.getElementById('push-sheet-btn');
    const fetchBtn = document.getElementById('fetch-sheet-btn');
    const gasGuideBtn = document.getElementById('gas-guide-btn');
    const gasGuideModal = document.getElementById('gas-guide-modal');
    const closeGasGuide = document.getElementById('close-gas-guide');

    const projectEditorModal = document.getElementById('project-editor-modal');
    const closeProjectEditor = document.getElementById('close-project-editor');
    const editProjectBtns = document.querySelectorAll('.edit-project-btn');
    const projectForm = document.getElementById('project-form');

    // LocalStorage URL persistence with Kang Apri default endpoint
    const DEFAULT_GAS_ENDPOINT = 'https://script.google.com/macros/s/AKfycbyL5LR8pVVrbmXp3y52urjij10GcsQ8EtUqpkLc7UV8JUen8LI5jYMCcY5h1WnombM/exec';
    const savedGasUrl = localStorage.getItem('madebyaapri_gas_url') || DEFAULT_GAS_ENDPOINT;
    
    if (gasInput) {
      gasInput.value = savedGasUrl;
      if (gasStatusBadge) {
        gasStatusBadge.textContent = 'Tersambung (Siap Pakai)';
        gasStatusBadge.className = 'px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-100 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800';
      }
    }

    if (saveGasBtn && gasInput) {
      saveGasBtn.addEventListener('click', () => {
        let url = gasInput.value.trim();
        if (!url) return;
        
        // Auto-format if user inputs raw ID instead of full URL
        if (!url.startsWith('http://') && !url.startsWith('https://')) {
          url = `https://script.google.com/macros/s/${url}/exec`;
          gasInput.value = url;
        }

        localStorage.setItem('madebyaapri_gas_url', url);
        if (gasStatusBadge) {
          gasStatusBadge.textContent = 'Tersambung (Siap Pakai)';
          gasStatusBadge.className = 'px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-100 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800';
        }
        alert('URL Google Apps Script berhasil tersimpan & terhubung!');
      });
    }

    // Tabs
    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-tab');
        tabBtns.forEach((b) => {
          b.classList.remove('active', 'bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-900');
          b.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
        });
        btn.classList.add('active', 'bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-900');
        btn.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');

        tabContents.forEach((c) => {
          if (c.id === target) {
            c.classList.remove('hidden');
          } else {
            c.classList.add('hidden');
          }
        });
      });
    });

    // Modals
    if (gasGuideBtn && gasGuideModal) {
      gasGuideBtn.addEventListener('click', () => {
        gasGuideModal.classList.remove('hidden');
        setTimeout(() => gasGuideModal.classList.remove('opacity-0'), 10);
      });
    }
    if (closeGasGuide && gasGuideModal) {
      closeGasGuide.addEventListener('click', () => {
        gasGuideModal.classList.add('opacity-0');
        setTimeout(() => gasGuideModal.classList.add('hidden'), 200);
      });
    }

    // Visual Project Editor
    function openProjectEditor(p: any) {
      if (!projectEditorModal) return;
      const titleInput = document.getElementById('edit-project-title-input') as HTMLInputElement | null;
      const taglineInput = document.getElementById('edit-project-tagline-input') as HTMLInputElement | null;
      const imageInput = document.getElementById('edit-project-image-input') as HTMLInputElement | null;
      const descInput = document.getElementById('edit-project-desc-input') as HTMLTextAreaElement | null;
      const idInput = document.getElementById('edit-project-id') as HTMLInputElement | null;

      if (titleInput) titleInput.value = p.title || '';
      if (taglineInput) taglineInput.value = p.tagline || '';
      if (imageInput) imageInput.value = p.image || '';
      if (descInput) descInput.value = p.description || '';
      if (idInput) idInput.value = p.id || '';

      projectEditorModal.classList.remove('hidden');
      setTimeout(() => projectEditorModal.classList.remove('opacity-0'), 10);
    }

    // Copy Image Path Buttons
    const copyImgBtns = document.querySelectorAll('.copy-img-path-btn');
    copyImgBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const path = btn.getAttribute('data-path');
        if (path) {
          navigator.clipboard.writeText(path).then(() => {
            const originalText = btn.textContent;
            btn.textContent = '✓ Path Tersalin!';
            setTimeout(() => {
              btn.textContent = originalText;
            }, 1500);
          });
        }
      });
    });

    editProjectBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const json = btn.getAttribute('data-project-json');
        if (json) openProjectEditor(JSON.parse(json));
      });
    });

    if (closeProjectEditor && projectEditorModal) {
      closeProjectEditor.addEventListener('click', () => {
        projectEditorModal.classList.add('opacity-0');
        setTimeout(() => projectEditorModal.classList.add('hidden'), 200);
      });
    }

    if (projectForm && projectEditorModal) {
      projectForm.addEventListener('submit', (e) => {
        e.preventDefault();
        alert('Data proyek berhasil diperbarui secara visual!');
        projectEditorModal.classList.add('opacity-0');
        setTimeout(() => projectEditorModal.classList.add('hidden'), 200);
      });
    }

    // Visual Article Editor
    const articleEditorModal = document.getElementById('article-editor-modal');
    const closeArticleEditor = document.getElementById('close-article-editor');
    const editArticleBtns = document.querySelectorAll('.edit-article-btn');
    const articleForm = document.getElementById('article-form');

    function openArticleEditor(a: any) {
      if (!articleEditorModal) return;
      const titleInput = document.getElementById('edit-article-title-input') as HTMLInputElement | null;
      const categoryInput = document.getElementById('edit-article-category-input') as HTMLInputElement | null;
      const readtimeInput = document.getElementById('edit-article-readtime-input') as HTMLInputElement | null;
      const excerptInput = document.getElementById('edit-article-excerpt-input') as HTMLTextAreaElement | null;
      const slugInput = document.getElementById('edit-article-slug') as HTMLInputElement | null;

      if (titleInput) titleInput.value = a.title || '';
      if (categoryInput) categoryInput.value = a.category || '';
      if (readtimeInput) readtimeInput.value = a.readTime || '';
      if (excerptInput) excerptInput.value = a.excerpt || '';
      if (slugInput) slugInput.value = a.slug || '';

      articleEditorModal.classList.remove('hidden');
      setTimeout(() => articleEditorModal.classList.remove('opacity-0'), 10);
    }

    editArticleBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const json = btn.getAttribute('data-article-json');
        if (json) openArticleEditor(JSON.parse(json));
      });
    });

    if (closeArticleEditor && articleEditorModal) {
      closeArticleEditor.addEventListener('click', () => {
        articleEditorModal.classList.add('opacity-0');
        setTimeout(() => articleEditorModal.classList.add('hidden'), 200);
      });
    }

    if (articleForm && articleEditorModal) {
      articleForm.addEventListener('submit', (e) => {
        e.preventDefault();
        alert('Metadata artikel berhasil diperbarui secara visual!');
        articleEditorModal.classList.add('opacity-0');
        setTimeout(() => articleEditorModal.classList.add('hidden'), 200);
      });
    }

    if (pushBtn) {
      pushBtn.addEventListener('click', async () => {
        const url = localStorage.getItem('madebyaapri_gas_url');
        if (!url) {
          alert('Masukkan URL Google Apps Script terlebih dahulu!');
          return;
        }
        alert('Menyinkronkan data ke Google Sheets...');
        try {
          await fetch(url, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'sync_all', timestamp: new Date() }),
          });
          alert('Data berhasil dikirim ke Google Sheets Anda!');
        } catch (err) {
          alert('Gagal mengirim data ke Sheets');
        }
      });
    }

    if (fetchBtn) {
      fetchBtn.addEventListener('click', async () => {
        const url = localStorage.getItem('madebyaapri_gas_url');
        if (!url) {
          alert('Masukkan URL Google Apps Script terlebih dahulu!');
          return;
        }
        try {
          const res = await fetch(url);
          const data = await res.json();
          alert(`Berhasil menarik data! Status: ${data.status || 'OK'}`);
        } catch (err) {
          alert('Gagal menarik data (pastikan deployment disetel "Anyone")');
        }
      });
    }
  };

  initAdmin();
  document.addEventListener('astro:after-swap', initAdmin);
</script>
