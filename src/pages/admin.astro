      category: pData[i][2],
      tagline: pData[i][3],
      description: pData[i][4],
      status: pData[i][5]
    });
  }

  var articles = [];
  for (var i = 1; i < aData.length; i++) {
    articles.push({
      slug: aData[i][0],
