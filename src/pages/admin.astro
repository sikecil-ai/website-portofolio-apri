    profile: profile,
    projects: projects,
    articles: articles
  })).setMimeType(ContentService.MimeType.JSON);
}

function doPost(e) {
  try {
    var ss = getTargetSpreadsheet();
    initMasterSheets(ss);
    var p = JSON.parse(e.postData.contents);
    
    if (p.action === 'save_project' && p.project) {
      var sheet = ss.getSheetByName("Proyek");
      var data = sheet.getDataRange().getValues();
      var found = false;
      for (var i = 1; i < data.length; i++) {
        if (data[i][0] == p.project.id) {
          sheet.getRange(i + 1, 2).setValue(p.project.title);
          sheet.getRange(i + 1, 4).setValue(p.project.tagline);
          sheet.getRange(i + 1, 5).setValue(p.project.description);
          sheet.getRange(i + 1, 7).setValue(new Date());
          found = true;
          break;
        }
      }
      if (!found) {
        sheet.appendRow([p.project.id, p.project.title, p.project.category, p.project.tagline, p.project.description, "Aktif", new Date()]);
      }
    }
    
    return ContentService.createTextOutput(JSON.stringify({
      status: "success",
      message: "Data berhasil disimpan ke Spreadsheet!"
    })).setMimeType(ContentService.MimeType.JSON);
  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({
      status: "error",
      message: err.toString()
    })).setMimeType(ContentService.MimeType.JSON);
  }
}

