---
import { siteConfig } from '../data/siteConfig';
---

<section id="beranda" class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
  <!-- Ambient background glow elements -->
  <div class="ambient-glow bg-brand-500/20 top-20 -left-20 w-72 h-72 sm:w-96 sm:h-96 animate-pulse-glow"></div>
  <div class="ambient-glow bg-cyan-500/15 top-40 -right-20 w-80 h-80 sm:w-[30rem] sm:h-[30rem] animate-pulse-glow" style="animation-delay: 2s;"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Content Column -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Status Indicator & Handle Badge -->
        <div class="flex flex-wrap items-center gap-2 mb-6 animate-fade-in">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100 dark:bg-slate-800/90 border border-slate-200 dark:border-slate-700/80 shadow-sm">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
            </span>
            <span class="text-xs font-semibold text-slate-800 dark:text-slate-200 font-mono">
              @madebyaapri
            </span>
          </div>

          <div class="px-3 py-1.5 rounded-full bg-brand-50 dark:bg-brand-950/70 border border-brand-200 dark:border-brand-800 text-brand-600 dark:text-brand-400 text-xs font-medium">
            ⚡ Zero Server Cost Architecture
          </div>
        </div>

        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-slate-50 leading-[1.2] mb-6">
          Ubah Alur Kerja Manual Menjadi <span class="text-gradient">Otomasi 1-Klik</span>
          <span class="block mt-2 text-xl sm:text-2xl lg:text-3xl font-bold text-slate-700 dark:text-slate-300">
            Tanpa Biaya Sewa Server.
          </span>
        </h1>

        <!-- Subtitle Description -->
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mb-8 leading-relaxed">
          Halo, Saya <strong class="text-slate-900 dark:text-slate-100">Muhammad Apriyanto Wijaya (Kang Apri)</strong>. 
          Membantu bisnis, UMKM, dan organisasi membangun <span class="font-semibold text-slate-900 dark:text-slate-100">sistem kasir &amp; keuangan otomatis</span>, <span class="font-semibold text-slate-900 dark:text-slate-100">sistem tabulasi event Paskibra</span>, serta otomasi alur kerja cerdas berbasis Google Workspace &amp; AI.
        </p>

        <!-- Location Badge -->
        <div class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-8 bg-slate-100/70 dark:bg-slate-800/50 px-3.5 py-1.5 rounded-xl border border-slate-200/60 dark:border-slate-700/60">
          <svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span>{siteConfig.location}</span>
        </div>

        <!-- CTA Action Buttons with Direct WA -->
        <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-12">
          <a
            href="https://wa.me/6282118313655?text=Halo%20Kang%20Apri,%20saya%20tertarik%20berkonsultasi%20mengenai%20solusi%20otomasi/sistem%20alur%20kerja."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            <span class="text-lg">💬</span>
            <span>Konsultasi Alur Kerja (WhatsApp)</span>
          </a>

          <a href="#proyek" class="btn-secondary">
            <span>Lihat Showcase Sistem</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          </a>

          <a
            href="https://instagram.com/madebyaapri"
            target="_blank"
            rel="noopener noreferrer"
            class="p-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white/80 dark:bg-slate-800/80 hover:text-pink-500 transition-colors"
            title="Instagram @madebyaapri"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        </div>

        <!-- Real Stats Counter Row -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 pt-6 border-t border-slate-200 dark:border-slate-800/80 w-full">
          <div>
            <span class="block text-2xl sm:text-3xl font-extrabold text-brand-600 dark:text-brand-400">Rp 0</span>
            <span class="text-xs text-slate-500 dark:text-slate-400">Biaya Server (Zero Cost)</span>
          </div>
          <div>
            <span class="block text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100">17+ Th</span>
            <span class="text-xs text-slate-500 dark:text-slate-400">Pengabdian Paskibra Cimahi</span>
          </div>
          <div>
            <span class="block text-2xl sm:text-3xl font-extrabold text-emerald-500">0 Detik</span>
            <span class="text-xs text-slate-500 dark:text-slate-400">Input Delay Tabulasi</span>
          </div>
          <div>
            <span class="block text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100">100%</span>
            <span class="text-xs text-slate-500 dark:text-slate-400">Konsultasi via WhatsApp</span>
          </div>
        </div>

      </div>

      <!-- Right Visual Column -->
      <div class="lg:col-span-5 flex justify-center relative">
        <div class="relative w-72 sm:w-88 md:w-96 aspect-square">
          
          <!-- Outer glowing rings -->
          <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-brand-600/30 via-cyan-500/20 to-purple-600/30 blur-2xl animate-pulse"></div>
          
          <!-- Avatar container -->
          <div class="relative w-full h-full rounded-3xl p-3 bg-gradient-to-b from-white/20 to-white/5 dark:from-white/10 dark:to-transparent border border-white/30 dark:border-slate-700/50 shadow-2xl backdrop-blur-xl flex items-center justify-center">
            <img
              src="/images/avatar.svg"
              alt="Kang Apri - madebyaapri"
              width="360"
              height="360"
              class="w-full h-full object-cover rounded-2xl animate-float"
              loading="eager"
            />

            <!-- Floating Real Badges -->
            <div
              class="absolute -top-3 -left-3 px-3.5 py-1.5 rounded-xl glass-panel bg-white/90 dark:bg-slate-900/90 shadow-lg border border-slate-200 dark:border-slate-700 flex items-center gap-2 animate-float"
              style="animation-delay: 1s;"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span class="text-xs font-semibold text-slate-800 dark:text-slate-200">💬 Fast WA Response</span>
            </div>

            <div class="absolute -bottom-3 -right-3 px-3.5 py-1.5 rounded-xl glass-panel bg-white/90 dark:bg-slate-900/90 shadow-lg border border-slate-200 dark:border-slate-700 flex items-center gap-2 animate-float" style="animation-delay: 2.5s;">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span class="text-xs font-semibold text-slate-800 dark:text-slate-200">⚡ Google Apps Script</span>
            </div>

            <div class="absolute top-1/2 -right-6 px-3 py-1.5 rounded-xl glass-panel bg-white/90 dark:bg-slate-900/90 shadow-lg border border-slate-200 dark:border-slate-700 flex items-center gap-2 animate-float" style="animation-delay: 3.5s;">
              <span class="w-2 h-2 rounded-full bg-blue-500"></span>
              <span class="text-xs font-semibold text-slate-800 dark:text-slate-200">📊 Looker Studio BI</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
