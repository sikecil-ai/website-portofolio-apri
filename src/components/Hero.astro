---
import { siteConfig } from '../data/siteConfig';
---

<section id="beranda" class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
  <!-- Ambient background glow elements -->
  <div class="ambient-glow bg-brand-500/20 top-20 -left-20 w-72 h-72 sm:w-96 sm:h-96 animate-pulse-glow"></div>
  <div class="ambient-glow bg-cyan-500/15 top-40 -right-20 w-80 h-80 sm:w-[30rem] sm:h-[30rem] animate-pulse-glow" style="animation-delay: 2s;"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Content Column -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Status Indicator & Handle Badge -->
        <div class="flex items-center gap-2 mb-6 animate-fade-in">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-100 dark:bg-slate-800/90 border border-slate-200 dark:border-slate-700/80 shadow-sm">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
            </span>
            <span class="text-xs font-bold text-slate-800 dark:text-slate-200 font-mono">
              @madebyaapri
            </span>
            <span class="text-slate-300 dark:text-slate-600">•</span>
            <span class="text-xs font-semibold text-brand-600 dark:text-brand-400">
              Modernisasi Spreadsheet &amp; Sistem Bisnis
            </span>
          </div>
        </div>

        <!-- Main Killer Headline: Targeted at Decision Makers & System Owners -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-slate-50 leading-[1.2] mb-5">
          Sudah Punya Sistem Tapi <span class="text-gradient">Tampilannya Bikin Tim Malas Pakai?</span>
          <span class="block mt-2 text-xl sm:text-2xl lg:text-3xl font-bold text-slate-700 dark:text-slate-300">
            Saya Upgrade Jadi Rapi, Cepat &amp; Menyenangkan.
          </span>
        </h1>

        <!-- Subtitle Description: Explicit Problem-Solution Fit -->
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mb-8 leading-relaxed">
          Halo, Saya <strong class="text-slate-900 dark:text-slate-100">Kang Apri (@madebyaapri)</strong>. 
          Saya membantu pemilik bisnis dan tim operasional mengubah spreadsheet ribet menjadi <span class="font-semibold text-slate-900 dark:text-slate-100">aplikasi smartphone yang rapi, cepat, dan membuat kerja tim jadi lebih menyenangkan</span> — investasi cerdas sekali bayar tanpa langganan server bulanan.
        </p>

        <!-- Concise Professional Action Buttons -->
        <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-12">
          <a
            href="https://wa.me/6282118313655?text=Halo%20Kang%20Apri,%20saya%20tertarik%20berkonsultasi%20mengenai%20upgrade%20spreadsheet%20dan%20sistem%20bisnis."
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary py-3.5 px-6"
          >
            <span class="text-lg">💬</span>
            <span>Konsultasi via WhatsApp</span>
          </a>

          <a href="#proyek" class="btn-secondary py-3.5 px-5 text-xs sm:text-sm flex items-center gap-2">
            <span>Lihat 7 Sistem Showcase</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          </a>
        </div>

        <!-- Outcome-Centric 3 Factual Stats Row -->
        <div class="grid grid-cols-3 gap-4 sm:gap-6 pt-6 border-t border-slate-200 dark:border-slate-800/80 w-full max-w-xl">
          <div>
            <span class="block text-xl sm:text-2xl font-extrabold text-brand-600 dark:text-brand-400">Hemat Puluhan Jam</span>
            <span class="text-xs text-slate-500 dark:text-slate-400">Waktu Kerja per Bulan</span>
          </div>
          <div>
            <span class="block text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-slate-100">7+ Sistem Nyata</span>
            <span class="text-xs text-slate-500 dark:text-slate-400">Teruji di Lapangan</span>
          </div>
          <div>
            <span class="block text-xl sm:text-2xl font-extrabold text-emerald-500">1-Klik Siap Cetak</span>
            <span class="text-xs text-slate-500 dark:text-slate-400">Laporan PDF Instan</span>
          </div>
        </div>

      </div>

      <!-- Right Visual Column -->
      <div class="lg:col-span-5 flex justify-center relative">
        <div class="relative w-72 sm:w-88 md:w-96 aspect-square">
          
          <!-- Outer glowing rings -->
          <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-brand-600/30 via-cyan-500/20 to-purple-600/30 blur-2xl animate-pulse"></div>
          
          <!-- Avatar container -->
          <div class="relative w-full h-full rounded-3xl p-3 bg-gradient-to-b from-white/20 to-white/5 dark:from-white/10 dark:to-transparent border border-white/30 dark:border-slate-700/50 shadow-2xl backdrop-blur-xl flex items-center justify-center">
            <img
              src="/images/avatar.svg"
              alt="Kang Apri - madebyaapri"
              width="360"
              height="360"
              class="w-full h-full object-cover rounded-2xl animate-float"
              loading="eager"
            />

            <!-- Floating Real Badges -->
            <div
              class="absolute -top-3 -left-3 px-3.5 py-1.5 rounded-xl glass-panel bg-white/90 dark:bg-slate-900/90 shadow-lg border border-slate-200 dark:border-slate-700 flex items-center gap-2 animate-float"
              style="animation-delay: 1s;"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span class="text-xs font-semibold text-slate-800 dark:text-slate-200">✨ Modern UI/UX</span>
            </div>

            <div class="absolute -bottom-3 -right-3 px-3.5 py-1.5 rounded-xl glass-panel bg-white/90 dark:bg-slate-900/90 shadow-lg border border-slate-200 dark:border-slate-700 flex items-center gap-2 animate-float" style="animation-delay: 2.5s;">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span class="text-xs font-semibold text-slate-800 dark:text-slate-200">⚡ Google Apps Script</span>
            </div>

            <div class="absolute top-1/2 -right-6 px-3 py-1.5 rounded-xl glass-panel bg-white/90 dark:bg-slate-900/90 shadow-lg border border-slate-200 dark:border-slate-700 flex items-center gap-2 animate-float" style="animation-delay: 3.5s;">
              <span class="w-2 h-2 rounded-full bg-blue-500"></span>
              <span class="text-xs font-semibold text-slate-800 dark:text-slate-200">📊 Looker Studio BI</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
