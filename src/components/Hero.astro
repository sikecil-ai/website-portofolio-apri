---
import { siteConfig } from '../data/siteConfig';
---

<section id="beranda" class="relative pt-24 pb-16 sm:pt-32 md:pt-40 md:pb-28 overflow-hidden">
  <!-- Ambient background glow elements -->
  <div class="ambient-glow bg-cyan-500/15 top-20 -left-20 w-72 h-72 sm:w-96 sm:h-96 animate-pulse-glow"></div>
  <div class="ambient-glow bg-blue-500/10 top-40 -right-20 w-80 h-80 sm:w-[30rem] sm:h-[30rem] animate-pulse-glow" style="animation-delay: 2s;"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
      
      <!-- Content Column (100% Full Width on Mobile, 7-Cols on Desktop) -->
      <div class="lg:col-span-7 flex flex-col items-start text-left w-full">
        
        <!-- Status Indicator & Compact Profile Badge -->
        <div class="flex items-center gap-2 mb-5 animate-fade-in w-full sm:w-auto">
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-slate-100 dark:bg-slate-800/90 border border-slate-200 dark:border-slate-700/80 shadow-sm max-w-full">
            <div class="relative w-5 h-5 rounded-full overflow-hidden shrink-0 border border-cyan-500/50">
              <img src="/images/avatar.svg" alt="Kang Apri" width="20" height="20" class="w-full h-full object-cover" />
            </div>
            <span class="relative flex h-2 w-2 shrink-0">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="text-xs font-bold text-slate-800 dark:text-slate-200 font-mono shrink-0">
              @madebyaapri
            </span>
            <span class="text-slate-300 dark:text-slate-600 hidden xs:inline">•</span>
            <span class="text-[11px] sm:text-xs font-semibold text-cyan-600 dark:text-cyan-400 truncate">
              Modernisasi Spreadsheet &amp; Sistem Bisnis
            </span>
          </div>
        </div>

        <!-- Main Headline -->
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-slate-50 leading-[1.25] mb-5 w-full">
          Sudah Punya Sistem Tapi <span class="text-gradient-cyan">Tampilannya Bikin Tim Malas Pakai?</span>
          <span class="block mt-2 text-lg sm:text-2xl lg:text-3xl font-bold text-slate-700 dark:text-slate-300">
            Saya Upgrade Jadi Rapi, Cepat &amp; Menyenangkan.
          </span>
        </h1>

        <!-- Subtitle Description -->
        <p class="text-sm sm:text-base lg:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mb-8 leading-relaxed w-full">
          Halo, aku <strong class="text-slate-900 dark:text-slate-100">Apri (@madebyaapri)</strong>. 
          Aku bantu pemilik bisnis dan tim operasional mengubah spreadsheet ribet menjadi <span class="font-semibold text-slate-900 dark:text-slate-100">aplikasi smartphone yang rapi, cepat, dan membuat kerja tim jadi lebih ringan</span> — investasi cerdas sekali bayar tanpa langganan server bulanan.
        </p>

        <!-- Concise Professional Action Buttons (100% Full-Width on Mobile) -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4 mb-8 w-full sm:w-auto">
          <a
            href="https://wa.me/6282118313655?text=Halo%20Kang%20Apri,%20saya%20tertarik%20berkonsultasi%20mengenai%20upgrade%20spreadsheet%20dan%20sistem%20bisnis."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto text-center px-6 py-3.5 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-semibold text-xs sm:text-sm hover:bg-slate-800 dark:hover:bg-slate-100 shadow-sm transition-all"
          >
            <span>💬 Konsultasi via WhatsApp</span>
          </a>

          <a href="#proyek" class="w-full sm:w-auto text-center px-5 py-3.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 font-semibold text-xs sm:text-sm hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors flex items-center justify-center gap-2">
            <span>Lihat 4 Mahakarya Sistem ↓</span>
          </a>
        </div>

        <!-- Outcome-Centric 3 Factual Stats Row (Responsive Full-Width Card) -->
        <div class="grid grid-cols-3 gap-2 sm:gap-6 p-4 sm:p-5 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800/80 w-full max-w-xl">
          <div class="text-center sm:text-left min-w-0">
            <span class="block text-sm sm:text-2xl font-extrabold text-cyan-600 dark:text-cyan-400 truncate">40+ Jam</span>
            <span class="text-[10px] sm:text-xs text-slate-500 dark:text-slate-400 block leading-tight">Dihemat / Bulan</span>
          </div>
          <div class="text-center sm:text-left min-w-0 border-x border-slate-200 dark:border-slate-800 px-1 sm:px-0 sm:border-x-0">
            <span class="block text-sm sm:text-2xl font-extrabold text-slate-900 dark:text-slate-100 truncate">4 Sistem</span>
            <span class="text-[10px] sm:text-xs text-slate-500 dark:text-slate-400 block leading-tight">Teruji Lapangan</span>
          </div>
          <div class="text-center sm:text-left min-w-0">
            <span class="block text-sm sm:text-2xl font-extrabold text-emerald-500 truncate">1-Klik</span>
            <span class="text-[10px] sm:text-xs text-slate-500 dark:text-slate-400 block leading-tight">Siap Print PDF</span>
          </div>
        </div>

      </div>

      <!-- Right Visual Column (Desktop Only: Harmonic Pixel Card) -->
      <div class="hidden lg:flex lg:col-span-5 justify-center relative">
        <div class="relative w-72 sm:w-88 md:w-96 aspect-square">
          <div class="relative w-full h-full rounded-3xl p-4 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl flex items-center justify-center">
            <img
              src="/images/avatar.svg"
              alt="Kang Apri - madebyaapri"
              width="360"
              height="360"
              class="w-full h-full object-cover rounded-2xl"
              loading="eager"
            />

            <!-- Floating Badges -->
            <div
              class="absolute -top-3 -left-2 sm:-left-3 px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 shadow-md border border-slate-200 dark:border-slate-700 flex items-center gap-1.5 text-xs font-semibold text-slate-800 dark:text-slate-200"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>Modern UI/UX</span>
            </div>

            <div class="absolute -bottom-3 -right-2 sm:-right-3 px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 shadow-md border border-slate-200 dark:border-slate-700 flex items-center gap-1.5 text-xs font-semibold text-slate-800 dark:text-slate-200">
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
              <span>Google Apps Script</span>
            </div>

            <div class="absolute top-1/2 -right-4 sm:-right-6 px-3 py-1.5 rounded-xl bg-white dark:bg-slate-800 shadow-md border border-slate-200 dark:border-slate-700 flex items-center gap-1.5 text-xs font-semibold text-slate-800 dark:text-slate-200">
              <span class="w-2 h-2 rounded-full bg-blue-500"></span>
              <span>Looker Studio BI</span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
