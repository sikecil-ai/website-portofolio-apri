---
const testimonials = [
  {
    quote: 'Mengelola database 147 anggota aktif dan absensi latihan mingguan sekarang tinggal buka smartphone. Begitu butuh laporan pertanggungjawaban untuk pihak sekolah, cukup 1 klik langsung siap print rapi ke format PDF tanpa perlu bongkar tumpukan berkas fisik lagi.',
    name: 'Pelatih & Pembina Paskibra',
    role: 'Unit Paskibra MAN & SMPN 3 Cimahi • Kota Cimahi',
    icon: '🎖️',
    badge: 'Organisasi Paskibra (147 Anggota)',
  },
  {
    quote: 'Sistem Si Paling Rekap di Kejurcab FORBASI Kota Cimahi 2026 benar-benar membantu. Standing nilai langsung keluar seketika saat lomba berjalan dan langsung jadi bahan diskusi objektif para pelatih di lokasi. Kalkulasi skornya 100% akurat tanpa komplain, dan panitia tidak perlu begadang untuk rekap manual.',
    name: 'Ketua Panitia Pelaksana',
    role: 'Kejurcab FORBASI Kota Cimahi 2026 • Kota Cimahi',
    icon: '🏆',
    badge: 'Uji Resmi Kejurcab FORBASI 2026',
  },
];
---

<section id="testimoni" class="relative py-24 sm:py-32 bg-slate-50/50 dark:bg-[#070b14]/50 border-t border-slate-200/60 dark:border-slate-800/60 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-cyan-50 dark:bg-cyan-950/60 border border-cyan-200 dark:border-cyan-800 text-cyan-700 dark:text-cyan-400 text-xs font-semibold uppercase tracking-wider mb-4">
        <span>💬</span>
        <span>Pembuktian Nyata di Lapangan</span>
      </div>
      
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-slate-50 tracking-tight leading-[1.2] mb-4">
        Cerita Keberhasilan <span class="text-gradient-cyan">Mitra &amp; Kejuaraan</span>
      </h2>
      
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Testimoni jujur dan apa adanya dari pelatih organisasi dan panitia kejuaraan yang membuktikan langsung efisiensi sistem Kang Apri (@madebyaapri).
      </p>
    </div>

    <!-- Testimonials 2-Column Grid (Focused & High Impact) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 max-w-5xl mx-auto">
      {testimonials.map((t) => (
        <div class="p-6 sm:p-8 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="px-2.5 py-1 rounded-lg bg-cyan-50 dark:bg-cyan-950/70 text-cyan-700 dark:text-cyan-400 text-[11px] font-bold border border-cyan-200/60 dark:border-cyan-800/60">
                {t.badge}
              </span>
              <div class="flex items-center gap-0.5 text-amber-400 text-xs">
                ★★★★★
              </div>
            </div>

            <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed mb-6 italic">
              "{t.quote}"
            </p>
          </div>

          <div class="flex items-center gap-3.5 pt-4 border-t border-slate-100 dark:border-slate-800">
            <div class="w-11 h-11 rounded-2xl bg-slate-100 dark:bg-slate-800 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-center font-bold text-xl shrink-0">
              {t.icon}
            </div>
            <div>
              <h4 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-slate-100">{t.name}</h4>
              <p class="text-[11px] text-slate-500 dark:text-slate-400">{t.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Social Proof CTA Bridge -->
    <div class="mt-12 text-center">
      <a
        href="https://wa.me/6282118313655?text=Halo%20Kang%20Apri,%20saya%20melihat%20testimoni%20lapangan%20di%20website%20dan%20ingin%20berkonsultasi%20sistem%20serupa%20untuk%20organisasi/kejuaraan."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex flex-col sm:flex-row items-center justify-center gap-1.5 sm:gap-2 px-5 sm:px-6 py-3.5 rounded-2xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-semibold text-xs sm:text-sm hover:bg-slate-800 dark:hover:bg-slate-100 shadow-sm transition-all text-center max-w-full"
      >
        <span>💡 Ingin merasakan efisiensi serupa untuk organisasimu?</span>
        <span class="text-cyan-400 dark:text-cyan-600 font-bold">Konsultasi via WA →</span>
      </a>
    </div>

  </div>
</section>
