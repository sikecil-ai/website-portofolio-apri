---
const painPoints = [
  {
    icon: '📑',
    accentColor: 'amber',
    title: 'Buka Spreadsheet Kaku & Bolak-Balik Aplikasi',
    description: 'Tim harus bolak-balik buka banyak sheet atau file excel jadul. Tampilan tabel di layar HP kekecilan, kaku, dan rawan salah pencet—bikin kerjaan harian gak beres-beres.',
    impact: 'Membuang 1–2 jam waktu produktif cuma buat rekap.',
  },
  {
    icon: '🤯',
    accentColor: 'rose',
    title: 'Laporan Mingguan Gak Nyambung & Gak Ada Progres',
    description: 'Bos dan tim sama-sama capek tiap sesi evaluasi mingguan karena datanya berceceran. Mau kroscek angka harus tanya ke banyak orang dan rumusnya sering rusak.',
    impact: 'Diskusi mingguan berputar-putar tanpa solusi nyata.',
  },
  {
    icon: '🚁',
    accentColor: 'indigo',
    title: 'Bos Kehilangan "Helicopter View" Satu Layar',
    description: 'Tanpa dashboard visual terpadu, pemilik bisnis dan manajer sulit memantau stok, omset, dan laba harian. Akhirnya keputusan bisnis diambil pakai tebakan atau emosi, bukan data nyata.',
    impact: 'Sulit mengendalikan kebocoran kas dan arah bisnis.',
  },
  {
    icon: '💸',
    accentColor: 'purple',
    title: 'Terjebak Biaya Langganan Software Mahal Tiap Bulan',
    description: 'Menyewa aplikasi POS atau software cloud jutaan rupiah per bulan, padahal fiturnya ribet, jarang dipakai, dan tidak pas dengan alur kerja tim di lapangan.',
    impact: 'Beban operasional membengkak tanpa efisiensi nyata.',
  },
];
---

<section id="masalah" class="relative py-20 bg-slate-50/70 dark:bg-[#0c121e]/70 border-t border-slate-200/60 dark:border-slate-800/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800 text-amber-700 dark:text-amber-400 text-xs font-semibold uppercase tracking-wider mb-4">
        <span>⚠️</span>
        <span>Masalah Klasik di Lapangan</span>
      </div>
      
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-slate-50 tracking-tight leading-[1.2] mb-4">
        Apakah Operasional Bisnismu Masih <span class="text-gradient">Ngalamin Drama Ini?</span>
      </h2>
      
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Keresahan nyata para pemilik bisnis, manajer operasional, dan tim di Cimahi, Bandung, hingga Jawa Barat yang lelah berkutat dengan spreadsheet kaku dan rekap manual yang menyita waktu.
      </p>
    </div>

    <!-- Pain Points 4-Card Responsive Grid (Google Pixel Harmonis Style) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {painPoints.map((point) => (
        <div class="rounded-2xl p-6 sm:p-7 border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/90 shadow-sm hover:shadow-md hover:border-slate-300 dark:hover:border-slate-700 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-2xl mb-5">
              {point.icon}
            </div>
            
            <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 mb-2.5 leading-snug">
              {point.title}
            </h3>
            
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
              {point.description}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-start gap-2 text-xs font-medium text-slate-700 dark:text-slate-300">
            <span class="text-rose-500 font-bold shrink-0">⚠️</span>
            <span class="leading-tight">{point.impact}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA Bridge to Solutions Showcase -->
    <div class="mt-12 text-center">
      <a
        href="#proyek"
        class="inline-flex flex-col sm:flex-row items-center justify-center gap-1.5 sm:gap-2 px-5 sm:px-6 py-3 rounded-2xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-semibold text-xs sm:text-sm hover:bg-slate-800 dark:hover:bg-slate-100 transition-all shadow-sm group max-w-full text-center"
      >
        <span>💡 Lihat bagaimana kami membereskan semua ini dalam hitungan hari</span>
        <span class="group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>

  </div>
</section>
