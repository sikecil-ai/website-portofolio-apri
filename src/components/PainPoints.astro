---
const painPoints = [
  {
    icon: '⏳',
    title: 'Rekap Manual Berjam-jam Tiap Malam',
    description: 'Tiap jam tutup kedai atau toko, tim harus memindahkan tumpukan nota kertas ke Excel. Laporan omzet selalu terlambat, rumus sering error, dan data rawan salah hitung.',
    impact: 'Membuang 1–2 jam waktu produktif setiap hari.',
  },
  {
    icon: '💬',
    title: 'Admin Kewalahan Melayani Chat Berulang',
    description: 'Pertanyaan yang sama diulang puluhan kali oleh calon pelanggan (jam buka, pricelist, alamat, ketersediaan stok). Respon lambat membuat prospek langsung kabur ke kompetitor.',
    impact: 'Potensi penjualan hilang akibat respon chat lambat.',
  },
  {
    icon: '📉',
    title: 'Kebocoran Stok & Arus Kas Tidak Sinkron',
    description: 'Stok bahan baku di gudang tidak sesuai dengan catatan penjualan di kasir. Sulit mengetahui secara pasti apakah bisnis hari ini benar-benar untung bersih atau boncos.',
    impact: 'Margin laba harian bocor tanpa disadari pemilik bisnis.',
  },
];
---

<section class="relative py-20 bg-slate-100/60 dark:bg-slate-900/40 border-t border-slate-200/60 dark:border-slate-800/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-rose-50 dark:bg-rose-950/60 border border-rose-200 dark:border-rose-800 text-rose-600 dark:text-rose-400 text-xs font-semibold uppercase tracking-wider mb-4">
        Masalah Klasik di Lapangan
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-slate-50 tracking-tight mb-4">
        Apakah Bisnis Anda Masih <span class="text-rose-600 dark:text-rose-400">Terjebak di Sini?</span>
      </h2>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
        Tiga titik kebocoran waktu dan biaya operasional yang paling sering dialami pemilik usaha sebelum beralih ke sistem otomasi.
      </p>
    </div>

    <!-- Pain Points Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {painPoints.map((point) => (
        <div class="glass-card rounded-3xl p-7 sm:p-8 border border-rose-200/60 dark:border-rose-900/40 bg-white/80 dark:bg-slate-900/60 flex flex-col justify-between hover:border-rose-400 dark:hover:border-rose-700 transition-all duration-300">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center text-2xl mb-6">
              {point.icon}
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-slate-100 mb-3">
              {point.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
              {point.description}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-200/60 dark:border-slate-800/60 flex items-center gap-2 text-xs font-semibold text-rose-600 dark:text-rose-400">
            <span>⚠️</span>
            <span>{point.impact}</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
