---
import type { Project } from '../types';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div
  class="project-card rounded-2xl overflow-hidden flex flex-col group border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md hover:border-slate-300 dark:hover:border-slate-700 transition-all duration-300 cursor-pointer w-full"
  data-category={project.category}
  data-tags={project.tags.join(',').toLowerCase()}
  data-title={project.title.toLowerCase()}
  data-project-json={JSON.stringify(project)}
>
  <!-- Card Header & Image Preview -->
  <div class="relative w-full aspect-[16/9] overflow-hidden bg-slate-950">
    <img
      src={project.image}
      alt={project.title}
      loading="lazy"
      class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
    />
    
    <!-- Category Badge -->
    <div class="absolute top-3 left-3 flex items-center gap-1.5 flex-wrap">
      <span class="px-2.5 py-1 text-[11px] font-semibold rounded-lg bg-slate-900/90 text-cyan-300 border border-cyan-500/30 backdrop-blur-md">
        {project.category}
      </span>
      {project.featured && (
        <span class="px-2.5 py-1 text-[11px] font-semibold rounded-lg bg-amber-400 text-slate-900 font-bold backdrop-blur-md shadow-sm">
          ★ Unggulan
        </span>
      )}
    </div>
  </div>

  <!-- Card Body -->
  <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
    <div>
      <a href={`/sistem/${project.slug}`}>
        <h3 class="type-h3 mb-2 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
          {project.title}
        </h3>
      </a>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mb-4 leading-relaxed">
        {project.description}
      </p>

      <!-- Key Stats Badges (Clear & Wrap-friendly for Mobile) -->
      {project.stats && (
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60 mb-4">
          {project.stats.map((stat) => (
            <div class="flex sm:flex-col items-center sm:items-center justify-between sm:justify-center text-left sm:text-center gap-1">
              <span class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">{stat.label}:</span>
              <span class="text-xs font-bold text-slate-900 dark:text-slate-100">{stat.value}</span>
            </div>
          ))}
        </div>
      )}

      <!-- Tech Stack Badges -->
      <div class="flex flex-wrap gap-1.5 mb-5">
        {project.tags.slice(0, 4).map((tag) => (
          <span class="px-2 py-0.5 text-[10px] sm:text-[11px] font-medium rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60">
            {tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Dual Actions Footer -->
    <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-3">
      <a
        href={`/sistem/${project.slug}`}
        class="text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors"
      >
        Detail Sistem →
      </a>

      <a
        href={project.demoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold text-white bg-slate-900 dark:bg-white dark:text-slate-900 hover:bg-slate-800 dark:hover:bg-slate-100 shadow-sm transition-all"
        onclick="event.stopPropagation()"
      >
        <span>💬 Konsultasi</span>
      </a>
    </div>
  </div>
</div>
