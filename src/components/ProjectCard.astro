---
import type { Project } from '../types';

export interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
---

<div
  class={`project-card rounded-2xl overflow-hidden flex flex-col group border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md hover:border-slate-300 dark:hover:border-slate-700 transition-all duration-300 cursor-pointer w-full ${index >= 4 ? 'hidden' : ''}`}
  data-category={project.category}
  data-tags={project.tags.join(',').toLowerCase()}
  data-title={project.title.toLowerCase()}
  data-project-json={JSON.stringify(project)}
  data-index={index}
>
  <!-- Card Header & Clean Real-Screenshot Mockup Showcase -->
  <div class="relative w-full aspect-[16/9] overflow-hidden bg-slate-950 border-b border-slate-100 dark:border-slate-800/80 flex items-center justify-center">
    {project.heroDesktopImage ? (
      <!-- 1. Desktop Browser Frame Showcase (e.g. G7KAIH) -->
      <div class="w-full h-full flex flex-col bg-slate-950">
        <!-- Minimal Browser Bar -->
        <div class="px-3 py-1.5 bg-slate-900 border-b border-slate-800 flex items-center justify-between shrink-0">
          <div class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-rose-500/80 inline-block"></span>
            <span class="w-2 h-2 rounded-full bg-amber-500/80 inline-block"></span>
            <span class="w-2 h-2 rounded-full bg-emerald-500/80 inline-block"></span>
          </div>
          <div class="px-2 py-0.5 rounded bg-slate-950/80 border border-slate-800 text-[8px] font-mono text-slate-400 max-w-[160px] truncate">
            {project.demoUrl ? project.demoUrl.replace('https://', '') : `${project.slug}.cloud`}
          </div>
          <span class="text-[8px] font-bold text-cyan-400 uppercase tracking-wider">Desktop UI</span>
        </div>
        <!-- Real Screenshot Image -->
        <div class="relative flex-1 overflow-hidden bg-slate-950">
          <img
            src={project.heroDesktopImage}
            alt={`${project.title} - Antarmuka Desktop Asli`}
            loading="lazy"
            class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/50 via-transparent to-transparent pointer-events-none"></div>
        </div>
      </div>
    ) : project.heroMobileImage ? (
      <!-- 2. Floating Smartphone Frame Showcase (e.g. KOMANDO) -->
      <div class="w-full h-full relative flex items-center justify-center bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900 p-2 sm:p-3 overflow-hidden">
        <!-- Subtle Pattern & Ambient Glow -->
        <div class="absolute inset-0 bg-[radial-gradient(#0891b218_1px,transparent_1px)] [background-size:12px_12px] opacity-60"></div>
        <div class="absolute w-32 h-32 rounded-full bg-cyan-500/10 blur-2xl pointer-events-none"></div>

        <!-- Centered Smartphone Frame -->
        <div class="relative w-[130px] sm:w-[145px] h-[92%] rounded-2xl bg-slate-900 border-2 border-slate-700 shadow-2xl overflow-hidden transition-transform duration-500 group-hover:scale-105 group-hover:-translate-y-0.5 flex flex-col z-0">
          <!-- Notch -->
          <div class="pt-1 pb-0.5 px-2 bg-slate-950 flex items-center justify-center border-b border-slate-800 shrink-0">
            <div class="w-6 h-0.5 rounded-full bg-slate-700"></div>
          </div>
          <!-- Mobile Screenshot -->
          <div class="flex-1 overflow-hidden bg-slate-950">
            <img
              src={project.heroMobileImage}
              alt={`${project.title} - Antarmuka Mobile Asli`}
              loading="lazy"
              class="w-full h-full object-cover object-top"
            />
          </div>
        </div>

        <div class="absolute bottom-2 right-2 z-10">
          <span class="px-2 py-0.5 rounded-md text-[8px] font-bold bg-slate-900/90 text-cyan-400 border border-slate-700/80 shadow-sm backdrop-blur-sm">
            📱 Mobile App
          </span>
        </div>
      </div>
    ) : (
      <!-- 3. Clean Fallback Image -->
      <div class="relative w-full h-full">
        <img
          src={project.image}
          alt={project.title}
          loading="lazy"
          class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-transparent pointer-events-none"></div>
      </div>
    )}

    <!-- Category & Status Badge -->
    <div class="absolute top-2.5 left-2.5 flex items-center gap-1.5 flex-wrap z-10 pointer-events-none">
      <span class="px-2 py-0.5 text-[10px] font-bold rounded-lg bg-slate-900/90 text-cyan-300 border border-cyan-500/30 backdrop-blur-md shadow-sm">
        {project.category}
      </span>
      {project.featured && (
        <span class="px-2 py-0.5 text-[10px] rounded-lg bg-amber-400 text-slate-900 font-bold backdrop-blur-md shadow-sm">
          ★ Unggulan
        </span>
      )}
    </div>
  </div>

  <!-- Card Body -->
  <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
    <div>
      <a href={`/sistem/${project.slug}`}>
        <h3 class="type-h3 mb-2 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
          {project.title}
        </h3>
      </a>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mb-4 leading-relaxed">
        {project.description}
      </p>

      <!-- Key Stats Badges (Clear & Wrap-friendly for Mobile) -->
      {project.stats && (
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60 mb-4">
          {project.stats.map((stat) => (
            <div class="flex sm:flex-col items-center sm:items-center justify-between sm:justify-center text-left sm:text-center gap-1">
              <span class="text-[11px] text-slate-500 dark:text-slate-400 font-medium">{stat.label}:</span>
              <span class="text-xs font-bold text-slate-900 dark:text-slate-100">{stat.value}</span>
            </div>
          ))}
        </div>
      )}

      <!-- Tech Stack Badges -->
      <div class="flex flex-wrap gap-1.5 mb-5">
        {project.tags.slice(0, 4).map((tag) => (
          <span class="px-2 py-0.5 text-[10px] sm:text-[11px] font-medium rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60">
            {tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Dual Actions Footer -->
    <div class="pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between gap-3">
      <a
        href={`/sistem/${project.slug}`}
        class="text-xs font-semibold text-slate-700 dark:text-slate-300 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors"
      >
        Detail Sistem →
      </a>

      <a
        href={project.demoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold text-white bg-slate-900 dark:bg-white dark:text-slate-900 hover:bg-slate-800 dark:hover:bg-slate-100 shadow-sm transition-all"
        onclick="event.stopPropagation()"
      >
        <span>💬 Konsultasi</span>
      </a>
    </div>
  </div>
</div>
