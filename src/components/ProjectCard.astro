---
import type { Project } from '../types';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div
  class="project-card glass-card rounded-2xl overflow-hidden flex flex-col group border border-slate-200/80 dark:border-slate-800/80 bg-white/70 dark:bg-slate-900/60 transition-all duration-300 hover:-translate-y-1.5"
  data-category={project.category}
  data-tags={project.tags.join(',').toLowerCase()}
  data-title={project.title.toLowerCase()}
>
  <!-- Card Header & Image Preview -->
  <div class="relative w-full aspect-[16/10] overflow-hidden bg-slate-950/80">
    <img
      src={project.image}
      alt={project.title}
      loading="lazy"
      class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
    />
    
    <!-- Category & Featured Badges -->
    <div class="absolute top-3 left-3 flex items-center gap-1.5 flex-wrap">
      <span class="px-2.5 py-1 text-[11px] font-semibold rounded-lg bg-slate-900/85 text-brand-300 border border-brand-500/30 backdrop-blur-md">
        {project.category}
      </span>
      {project.featured && (
        <span class="px-2.5 py-1 text-[11px] font-semibold rounded-lg bg-emerald-500/90 text-slate-950 font-bold backdrop-blur-md shadow-sm">
          ★ Unggulan
        </span>
      )}
    </div>

    <!-- Quick Overlay for Details -->
    <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center gap-3 backdrop-blur-[2px]">
      <a
        href={`/sistem/${project.slug}`}
        class="px-4 py-2 rounded-xl text-xs font-semibold text-white bg-brand-600/90 hover:bg-brand-500 shadow-lg transition-transform active:scale-95 cursor-pointer"
      >
        Lihat Detail Sistem →
      </a>
    </div>
  </div>

  <!-- Card Body -->
  <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
    <div>
      <a href={`/sistem/${project.slug}`}>
        <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-slate-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors line-clamp-1 mb-2">
          {project.title}
        </h3>
      </a>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 line-clamp-2 mb-4 leading-relaxed">
        {project.description}
      </p>

      <!-- Tech Stack Badges -->
      <div class="flex flex-wrap gap-1.5 mb-5">
        {project.tags.slice(0, 4).map((tag) => (
          <span class="px-2 py-0.5 text-[11px] font-medium rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60">
            {tag}
          </span>
        ))}
        {project.tags.length > 4 && (
          <span class="px-1.5 py-0.5 text-[10px] font-medium rounded-md bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
            +{project.tags.length - 4}
          </span>
        )}
      </div>
    </div>

    <!-- Footer Stats & Actions -->
    <div class="pt-4 border-t border-slate-200/70 dark:border-slate-800/70 flex items-center justify-between gap-2">
      <!-- Role / Year -->
      <span class="text-[11px] text-slate-500 dark:text-slate-400 font-mono">
        {project.role} • {project.date}
      </span>

      <!-- Action Links: Direct WA -->
      <div class="flex items-center gap-1.5">
        <a
          href={project.demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-white bg-emerald-600 hover:bg-emerald-500 shadow-sm transition-all"
          title="Diskusi atau Pesan Sistem Ini via WhatsApp"
        >
          <span class="text-sm">💬</span>
          <span>Diskusi WA</span>
        </a>
      </div>
    </div>
  </div>
</div>
