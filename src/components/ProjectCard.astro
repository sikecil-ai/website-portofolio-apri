---
import type { Project } from '../types';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div
  class="project-card glass-card rounded-2xl overflow-hidden flex flex-col group border border-slate-200/80 dark:border-slate-800/80 bg-white/70 dark:bg-slate-900/60 transition-all duration-300 hover:-translate-y-1.5"
  data-category={project.category}
  data-tags={project.tags.join(',').toLowerCase()}
  data-title={project.title.toLowerCase()}
  data-project-json={JSON.stringify(project)}
>
  <!-- Card Header & Image Preview -->
  <div class="relative w-full aspect-[16/10] overflow-hidden bg-slate-950/80">
    <img
      src={project.image}
      alt={project.title}
      loading="lazy"
      class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
    />
    
    <!-- Category & Featured Badges -->
    <div class="absolute top-3 left-3 flex items-center gap-1.5 flex-wrap">
      <span class="px-2.5 py-1 text-[11px] font-semibold rounded-lg bg-slate-900/85 text-brand-300 border border-brand-500/30 backdrop-blur-md">
        {project.category}
      </span>
      {project.featured && (
        <span class="px-2.5 py-1 text-[11px] font-semibold rounded-lg bg-amber-500/90 text-slate-950 font-bold backdrop-blur-md shadow-sm">
          ★ Unggulan
        </span>
      )}
    </div>

    <!-- Quick Overlay for Details -->
    <div class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center gap-3 backdrop-blur-[2px]">
      <button
        type="button"
        class="open-modal-btn px-4 py-2 rounded-xl text-xs font-semibold text-white bg-brand-600/90 hover:bg-brand-500 shadow-lg transition-transform active:scale-95 cursor-pointer"
        data-project-id={project.id}
      >
        Lihat Detail
      </button>
    </div>
  </div>

  <!-- Card Body -->
  <div class="p-5 sm:p-6 flex-1 flex flex-col justify-between">
    <div>
      <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-slate-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors line-clamp-1 mb-2">
        {project.title}
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 line-clamp-2 mb-4 leading-relaxed">
        {project.description}
      </p>

      <!-- Tech Stack Badges -->
      <div class="flex flex-wrap gap-1.5 mb-5">
        {project.tags.slice(0, 4).map((tag) => (
          <span class="px-2 py-0.5 text-[11px] font-medium rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60">
            {tag}
          </span>
        ))}
        {project.tags.length > 4 && (
          <span class="px-1.5 py-0.5 text-[10px] font-medium rounded-md bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
            +{project.tags.length - 4}
          </span>
        )}
      </div>
    </div>

    <!-- Footer Stats & Actions -->
    <div class="pt-4 border-t border-slate-200/70 dark:border-slate-800/70 flex items-center justify-between gap-2">
      <!-- Role / Year -->
      <span class="text-[11px] text-slate-500 dark:text-slate-400 font-mono">
        {project.role} • {project.date}
      </span>

      <!-- Action Links -->
      <div class="flex items-center gap-1.5">
        {project.repoUrl && (
          <a
            href={project.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="p-2 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-950 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
            title="Lihat Source Code GitHub"
            aria-label={`GitHub repo untuk ${project.title}`}
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </a>
        )}

        {project.demoUrl && (
          <a
            href={project.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold text-white bg-brand-600 hover:bg-brand-500 shadow-sm transition-all"
            title="Buka Live Demo Aplikasi"
          >
            <span>Demo</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>
</div>
