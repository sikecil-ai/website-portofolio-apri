---
const pricingTiers = [
  {
    name: 'Sesi Diagnosa Alur Kerja',
    tagline: 'Pemetaan Titik Macet, Kebocoran Waktu & Solusi Spreadsheet',
    price: 'Gratis / Rp 0',
    type: 'Sesi 30–45 Menit (Google Meet / WA)',
    description: 'Sesi ngobrol santai 1-on-1 bersama Kang Apri untuk memetakan alur kerja manual atau spreadsheet Anda, mencari titik boros waktu, dan rekomendasi solusi tanpa biaya sewa software.',
    features: [
      'Pemetaan alur kerja manual & spreadsheet saat ini',
      'Identifikasi titik boros waktu tim yang bisa diotomasi',
      'Rekomendasi arsitektur sistem tanpa biaya server (GAS/Looker)',
      'Konsultasi 100% bebas risiko tanpa ikatan komitmen',
    ],
    ctaText: '💬 Ambil Sesi Ngobrol Gratis',
    waText: 'Halo Kang Apri, saya mau ambil sesi konsultasi alur kerja (Gratis / Rp 0) untuk mendiskusikan alur operasional bisnis/organisasi saya.',
    highlight: false,
    badge: '★ Bebas Risiko (100% Gratis)',
  },
  {
    name: 'Lisensi SaaS Sistem Siap Pakai',
    tagline: 'Aktivasi Cepat untuk Sekolah, Madrasah, Organisasi & F&B',
    price: 'Mulai Rp 500',
    type: 'Per Siswa / Pengguna / Bulan (Atau Sewa Per Event)',
    description: 'Gunakan langsung ekosistem aplikasi yang sudah terbukti di lapangan (G7KAIH 871 siswa, KOMANDO 147 anggota, kasir mandiri, atau sistem tabulasi lomba) tanpa perlu menunggu masa pembuatan dari nol.',
    features: [
      'Akses instan aplikasi jadi yang teruji di lapangan',
      'Form smartphone ramah pengguna + Google Sheets database',
      'Dashboard pemantauan live untuk wali kelas / pimpinan',
      'Setup cepat & video panduan cara pakai 1-klik',
      'Model fleksibel: Langganan bulanan mikro atau per event',
    ],
    ctaText: '📂 Pilih Sistem di Etalase',
    link: '#proyek',
    waText: 'Halo Kang Apri, saya tertarik menggunakan lisensi aplikasi sistem yang sudah ada (mulai Rp 500 per siswa/user/bulan) untuk kebutuhan instansi/tim saya.',
    highlight: false,
    badge: '⚡ Solusi Cepat (Ready to Use)',
  },
  {
    name: 'Rancang Sistem Alur Kustom',
    tagline: 'Bedah Alur Kerja Unik & Spreadsheet Manual Anda dari Nol',
    price: 'Mulai Rp 500.000',
    type: 'Sekali Bayar (Rp 0 Biaya Server Seumur Hidup)',
    description: 'Solusi paling dicari untuk pemilik bisnis, sekolah, atau organisasi yang punya alur kerja unik dan ingin dibuatkan sistem mandiri yang pas 100% dengan kebutuhan operasionalnya.',
    features: [
      '100% dirancang khusus sesuai alur unik tim Anda',
      'Form web smartphone modern ramah staf operasional',
      'Engine modular Google Apps Script tanpa biaya server seumur hidup',
      'Dashboard Business Intelligence interaktif Looker Studio',
      'Buku SOP panduan alur, video tutorial & garansi pendampingan',
    ],
    ctaText: '💬 Konsultasi Rancang Sistem Kustom',
    waText: 'Halo Kang Apri, saya mau konsultasi pembuatan sistem alur kustom (mulai Rp 500rb) untuk mengotomasi alur manual/spreadsheet unik di tim saya.',
    highlight: true,
    badge: '★ PALING DIMINATI (REKOMENDASI)',
  },
];
---

<section id="layanan" class="relative py-24 sm:py-32 bg-slate-50/50 dark:bg-[#070b14]/50 border-t border-slate-200/60 dark:border-slate-800/60 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-cyan-50 dark:bg-cyan-950/60 border border-cyan-200 dark:border-cyan-800 text-cyan-700 dark:text-cyan-400 text-xs font-semibold uppercase tracking-wider mb-4">
        <span>💎</span>
        <span>Skema Investasi &amp; Pilihan Layanan</span>
      </div>
      
      <h2 class="type-h2 mb-4">
        Transparan, Fleksibel, dan <span class="text-gradient-cyan">Bekerja Selamanya</span>
      </h2>
      
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Mulai dari konsultasi alur gratis, aktivasi lisensi SaaS siap pakai (mulai Rp 500/siswa/bulan), hingga rancang bangun sistem kustom terpadu (mulai Rp 500.000). <strong>Semuanya tanpa beban sewa server bulanan seumur hidup</strong>.
      </p>
    </div>

    <!-- Trust Badges Bar -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-4xl mx-auto mb-12">
      <div class="p-3.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center justify-center gap-2.5 text-center">
        <span class="text-lg">🛡️</span>
        <span class="text-xs font-bold text-slate-800 dark:text-slate-200">Garansi Pendampingan Sampai Jalan</span>
      </div>
      <div class="p-3.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center justify-center gap-2.5 text-center">
        <span class="text-lg">💰</span>
        <span class="text-xs font-bold text-slate-800 dark:text-slate-200">Rp 0 Biaya Server Seumur Hidup</span>
      </div>
      <div class="p-3.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center justify-center gap-2.5 text-center">
        <span class="text-lg">📚</span>
        <span class="text-xs font-bold text-slate-800 dark:text-slate-200">Buku SOP &amp; Video Panduan 1-Klik</span>
      </div>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {pricingTiers.map((tier) => (
        <div
          class={`rounded-3xl p-7 sm:p-8 flex flex-col justify-between relative transition-all duration-300 ${
            tier.highlight
              ? 'border-2 border-cyan-500 bg-white dark:bg-slate-900 shadow-xl shadow-cyan-500/10 lg:-translate-y-2'
              : 'border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm'
          }`}
        >
          {tier.highlight && (
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-cyan-600 text-white font-bold text-[11px] shadow-md uppercase tracking-wider whitespace-nowrap">
              {tier.badge}
            </div>
          )}

          <div>
            {!tier.highlight && (
              <span class="inline-block px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 text-[11px] font-bold mb-3">
                {tier.badge}
              </span>
            )}
            <h3 class="type-h3 mt-2 mb-1">
              {tier.name}
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mb-6">
              {tier.tagline}
            </p>

            <!-- Price Display with starting amount -->
            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60 mb-6">
              <span class="block text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-slate-100">
                {tier.price}
              </span>
              <span class="text-xs font-semibold text-cyan-600 dark:text-cyan-400">
                {tier.type}
              </span>
            </div>

            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mb-6 leading-relaxed">
              {tier.description}
            </p>

            <!-- Feature list -->
            <ul class="space-y-2.5 mb-8 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
              {tier.features.map((feat) => (
                <li class="flex items-start gap-2">
                  <span class="text-cyan-500 font-bold mt-0.5">✓</span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Direct CTA Actions -->
          {tier.link ? (
            <div class="flex flex-col gap-2.5">
              <a
                href={tier.link}
                class="w-full py-3.5 px-4 rounded-xl font-semibold text-xs sm:text-sm text-center flex items-center justify-center gap-2 transition-all bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:bg-slate-800 dark:hover:bg-slate-100 shadow-sm group cursor-pointer"
              >
                <span>{tier.ctaText}</span>
                <span class="group-hover:translate-y-0.5 transition-transform">↓</span>
              </a>
              {tier.waText && (
                <a
                  href={`https://wa.me/6282118313655?text=${encodeURIComponent(tier.waText)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-center text-[11px] text-cyan-600 dark:text-cyan-400 font-semibold hover:underline py-1"
                >
                  Atau langsung aktivasi via WhatsApp →
                </a>
              )}
            </div>
          ) : (
            <a
              href={`https://wa.me/6282118313655?text=${encodeURIComponent(tier.waText)}`}
              target="_blank"
              rel="noopener noreferrer"
              class={`w-full py-3.5 px-4 rounded-xl font-semibold text-xs sm:text-sm text-center flex items-center justify-center gap-2 transition-all ${
                tier.highlight
                  ? 'bg-cyan-600 hover:bg-cyan-500 text-white shadow-md shadow-cyan-600/20'
                  : 'bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:bg-slate-800 dark:hover:bg-slate-100 shadow-sm'
              }`}
            >
              <span>{tier.ctaText}</span>
            </a>
          )}
        </div>
      ))}
    </div>

  </div>
</section>
