---
const pricingTiers = [
  {
    name: 'Sesi Diagnosa Alur Kerja',
    tagline: 'Pemetaan Titik Macet & Kebocoran Waktu Tim',
    price: 'Gratis / Rp 0',
    type: 'Sesi 30–45 Menit (Google Meet / WA)',
    description: 'Sesi ngobrol santai 1-on-1 bersama Kang Apri untuk memetakan alur kerja manual atau spreadsheet Anda, serta mencari solusi yang paling pas dan hemat biaya.',
    features: [
      'Pemetaan alur kerja manual & spreadsheet saat ini',
      'Identifikasi titik boros waktu tim yang bisa diotomasi',
      'Rekomendasi arsitektur sistem tanpa biaya server',
      'Konsultasi 100% bebas risiko tanpa komitmen',
    ],
    ctaText: '💬 Ambil Sesi Ngobrol Gratis',
    waText: 'Halo Kang Apri, saya mau ambil sesi konsultasi alur kerja (Gratis) untuk mendiskusikan sistem operasional bisnis saya.',
    highlight: false,
    badge: '★ Bebas Risiko (100% Gratis)',
  },
  {
    name: 'Sistem Kasir & Operasional Bisnis (Si Paling Kasir)',
    tagline: 'Sistem Kasir, Stok & Dashboard Tanpa Biaya Server',
    price: 'Mulai Rp 1.000.000',
    type: 'Sekali Bayar (Rp 0 Biaya Server Seumur Hidup)',
    description: 'Solusi unggulan untuk merombak operasional bisnis F&B / retail ke form smartphone, otomatisasi HPP, dan Looker Studio Dashboard.',
    features: [
      'Form web input kasir/transaksi ramah smartphone',
      'Kalkulasi otomatis HPP bumbu, laba harian, & sisa stok',
      'Dashboard Business Intelligence interaktif Looker Studio',
      'Buku panduan penggunaan (SOP) + Video tutorial cara pakai',
      'Garansi pendampingan langsung hingga tim lancar',
    ],
    ctaText: '💬 Diskusi Alur & Estimasi',
    waText: 'Halo Kang Apri, saya tertarik membangun Sistem Kasir & Operasional F&B (Si Paling Kasir) mulai Rp 1 Juta untuk bisnis saya.',
    highlight: true,
    badge: '★ Paling Populer (Bisnis & F&B)',
  },
  {
    name: 'Live Event Tabulation (Si Paling Rekap)',
    tagline: 'Sistem Penjurian Digital & Tabulasi Real-Time 0 Detik',
    price: 'Mulai Rp 500.000',
    type: 'Per Kejuaraan / Musim Lomba',
    description: 'Didesain khusus untuk panitia kejuaraan PBB, LKBB, atau lomba organisasi yang ingin rekapitulasi nilai juri 100% digital tanpa jeda waktu.',
    features: [
      'Formulir penilaian juri digital smartphone/tablet',
      'Tabulasi rekapitulasi skor otomatis real-time 0 detik',
      'Papan klasemen standing juara umum & per-kategori instan',
      'Ekspor otomatis rekapitulasi nilai ke format PDF resmi',
      'Dukungan briefing operator tabulasi sebelum hari H',
    ],
    ctaText: '💬 Konsultasi Tabulasi Event',
    waText: 'Halo Kang Apri, saya tertarik dengan Sistem Tabulasi Si Paling Rekap (mulai Rp 500rb) untuk event kami.',
    highlight: false,
    badge: '★ Teruji di Kejurcab 2026',
  },
];
---

<section id="layanan" class="relative py-24 sm:py-32 bg-slate-50/50 dark:bg-[#070b14]/50 border-t border-slate-200/60 dark:border-slate-800/60 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-cyan-50 dark:bg-cyan-950/60 border border-cyan-200 dark:border-cyan-800 text-cyan-700 dark:text-cyan-400 text-xs font-semibold uppercase tracking-wider mb-4">
        <span>💎</span>
        <span>Skema Investasi &amp; Pilihan Layanan</span>
      </div>
      
      <h2 class="type-h2 mb-4">
        Investasi Nyata yang <span class="text-gradient-cyan">Bekerja Selamanya</span>
      </h2>
      
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Investasi transparan mulai dari diagnosa alur kerja hingga sistem terpadu siap pakai. <strong>Tanpa beban sewa server bulanan seumur hidup (Rp 0/bulan)</strong>.
      </p>
    </div>

    <!-- Trust Badges Bar -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-4xl mx-auto mb-12">
      <div class="p-3.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center justify-center gap-2.5 text-center">
        <span class="text-lg">🛡️</span>
        <span class="text-xs font-bold text-slate-800 dark:text-slate-200">Garansi Pendampingan Sampai Jalan</span>
      </div>
      <div class="p-3.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center justify-center gap-2.5 text-center">
        <span class="text-lg">💰</span>
        <span class="text-xs font-bold text-slate-800 dark:text-slate-200">Rp 0 Biaya Server Seumur Hidup</span>
      </div>
      <div class="p-3.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center justify-center gap-2.5 text-center">
        <span class="text-lg">📚</span>
        <span class="text-xs font-bold text-slate-800 dark:text-slate-200">Buku SOP &amp; Video Panduan 1-Klik</span>
      </div>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
      {pricingTiers.map((tier) => (
        <div
          class={`rounded-3xl p-7 sm:p-8 flex flex-col justify-between relative transition-all duration-300 ${
            tier.highlight
              ? 'border-2 border-cyan-500 bg-white dark:bg-slate-900 shadow-xl shadow-cyan-500/10 lg:-translate-y-2'
              : 'border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm'
          }`}
        >
          {tier.highlight && (
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-cyan-600 text-white font-bold text-[11px] shadow-md uppercase tracking-wider">
              {tier.badge}
            </div>
          )}

          <div>
            {!tier.highlight && (
              <span class="inline-block px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 text-[11px] font-bold mb-3">
                {tier.badge}
              </span>
            )}
            <h3 class="type-h3 mt-2 mb-1">
              {tier.name}
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mb-6">
              {tier.tagline}
            </p>

            <!-- Price Display with starting amount -->
            <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60 mb-6">
              <span class="block text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-slate-100">
                {tier.price}
              </span>
              <span class="text-xs font-semibold text-cyan-600 dark:text-cyan-400">
                {tier.type}
              </span>
            </div>

            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mb-6 leading-relaxed">
              {tier.description}
            </p>

            <!-- Feature list -->
            <ul class="space-y-2.5 mb-8 text-xs sm:text-sm text-slate-700 dark:text-slate-300">
              {tier.features.map((feat) => (
                <li class="flex items-start gap-2">
                  <span class="text-cyan-500 font-bold mt-0.5">✓</span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Direct WhatsApp Button -->
          <a
            href={`https://wa.me/6282118313655?text=${encodeURIComponent(tier.waText)}`}
            target="_blank"
            rel="noopener noreferrer"
            class={`w-full py-3.5 px-4 rounded-xl font-semibold text-xs sm:text-sm text-center flex items-center justify-center gap-2 transition-all ${
              tier.highlight
                ? 'bg-cyan-600 hover:bg-cyan-500 text-white shadow-md'
                : 'bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:bg-slate-800 dark:hover:bg-slate-100 shadow-sm'
            }`}
          >
            <span>{tier.ctaText}</span>
          </a>
        </div>
      ))}
    </div>

  </div>
</section>
