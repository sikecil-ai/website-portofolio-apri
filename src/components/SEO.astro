---
import { siteConfig } from '../data/siteConfig';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  type?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = siteConfig.ogImage,
  canonicalURL = siteConfig.url,
  type = 'website',
} = Astro.props;

const fullImageURL = image.startsWith('http')
  ? image
  : `${siteConfig.url}${image}`;

const baseSiteUrl = siteConfig.url;

// Schema 1: Person (E-E-A-T Authority for Kang Apri)
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${baseSiteUrl}/#person`,
  name: 'M. Apriyanto Wijaya',
  alternateName: ['Kang Apri', '@madebyaapri', 'Muhammad Apriyanto Wijaya', 'Apriyanto Wijaya'],
  url: baseSiteUrl,
  image: fullImageURL,
  jobTitle: 'Workflow Automation Specialist & Zero Server Cost Architecture Developer',
  description: siteConfig.bio,
  email: siteConfig.email,
  telephone: siteConfig.phone,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kota Cimahi',
    addressRegion: 'Jawa Barat',
    addressCountry: 'ID',
  },
  sameAs: [
    'https://instagram.com/madebyaapri',
    'https://tiktok.com/@madebyaapri',
    'https://www.youtube.com/@madebyaapri',
    'https://linkedin.com/in/apriyanto-wijaya',
    'https://github.com/sikecil-ai',
    'https://wa.me/6282118313655',
  ],
  knowsAbout: [
    'Workflow Automation',
    'Google Apps Script',
    'Google Sheets Database Engine',
    'Looker Studio Business Intelligence',
    'Aplikasi Kasir UMKM Zero Server Cost',
    'Aplikasi Tabulasi Lomba Paskibra Real-time',
    'Astro Web Framework',
    'Python AI Bot Development',
  ],
};

// Schema 2: WebSite
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${baseSiteUrl}/#website`,
  url: baseSiteUrl,
  name: 'Kang Apri (@madebyaapri) — Otomasi Alur Kerja & Sistem Bisnis Tanpa Server',
  description: siteConfig.description,
  publisher: {
    '@id': `${baseSiteUrl}/#person`,
  },
  inLanguage: 'id-ID',
};

// Schema 3: FAQPage (Google Rich Snippets)
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Apa yang dimaksud dengan Zero Server Cost Architecture?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Zero Server Cost Architecture adalah pendekatan perancangan sistem perangkat lunak yang memanfaatkan ekosistem cloud gratis seperti Google Workspace, Google Apps Script, dan Google Sheets sebagai database engine.',
      },
    },
    {
      '@type': 'Question',
      name: 'Bagaimana alur kerja aplikasi tabulasi lomba Paskibra KOMANDO?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Juri menginput nilai langsung melalui formulir digital di smartphone. Nilai otomatis tersinkronisasi secara real-time (0 detik jeda) ke engine kalkulasi terpusat.',
      },
    },
    {
      '@type': 'Question',
      name: 'Berapa lama estimasi pengerjaan sebuah sistem kustom?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Waktu pengerjaan umumnya berkisar antara 3 hingga 7 hari kerja tergantung pada kompleksitas modul yang dibutuhkan.',
      },
    },
    {
      '@type': 'Question',
      name: 'Apakah data transaksi dan keuangan bisnis saya aman di Google Sheets?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sangat aman. Seluruh database tersimpan di akun Google Workspace milik Anda sendiri dengan standar enkripsi enterprise dari Google.',
      },
    },
    {
      '@type': 'Question',
      name: 'Bagaimana cara berkonsultasi mengenai kebutuhan otomasi saya?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Anda dapat langsung mengklik tombol WhatsApp di website untuk mendiskusikan proses bisnis atau alur kerja yang ingin diotomasi.',
      },
    },
  ],
};

// Schema 4: ItemList for Software Products
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Sistem Otomasi & Aplikasi by M. Apriyanto Wijaya (@madebyaapri)',
  itemListElement: [
    {
      '@type': 'SoftwareApplication',
      position: 1,
      name: 'KOMANDO — Sistem Manajemen Organisasi Paskibra',
      operatingSystem: 'Web, Android, iOS',
      applicationCategory: 'BusinessApplication',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'IDR',
      },
    },
    {
      '@type': 'SoftwareApplication',
      position: 2,
      name: 'Si Paling Rekap — Sistem Tabulasi Kejuaraan Multi-Kategori Real-Time',
      operatingSystem: 'Web, Mobile, Tablet',
      applicationCategory: 'SportsApplication',
    },
    {
      '@type': 'SoftwareApplication',
      position: 3,
      name: 'G7KAIH Mankoci — Sistem Monitoring 7 Kebiasaan Siswa Hebat',
      operatingSystem: 'Web, Android, iOS',
      applicationCategory: 'EducationalApplication',
    },
    {
      '@type': 'SoftwareApplication',
      position: 4,
      name: 'Si Paling Kasir — Sistem POS, HPP & Inventaris F&B Zero Server Cost',
      operatingSystem: 'Web, Android POS, Desktop',
      applicationCategory: 'FinanceApplication',
    },
    {
      '@type': 'SoftwareApplication',
      position: 5,
      name: 'Si Paling Threads — Bot Distribusi Konten & AI Auto-Publisher',
      operatingSystem: 'Cross-platform Cloud Python',
      applicationCategory: 'MarketingApplication',
    },
  ],
};

// Schema 5: Blog & Articles (Google Discover E-E-A-T)
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Studi Kasus & Artikel Otomasi by Kang Apri (@madebyaapri)',
  url: `${baseSiteUrl}/#artikel`,
  description: 'Kumpulan cerita nyata di balik layar, studi kasus otomasi bisnis tanpa server, dan sistem penjurian Paskibra.',
  author: {
    '@id': `${baseSiteUrl}/#person`,
  },
};

// Schema 6: Breadcrumbs
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Beranda',
      item: baseSiteUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Sistem & Solusi',
      item: `${baseSiteUrl}/#proyek`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Artikel & Studi Kasus',
      item: `${baseSiteUrl}/#artikel`,
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: 'Investasi & Biaya',
      item: `${baseSiteUrl}/#investasi`,
    },
    {
      '@type': 'ListItem',
      position: 5,
      name: 'FAQ',
      item: `${baseSiteUrl}/#faq`,
    },
  ],
};
---

<!-- Favicons & Touch Icons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="shortcut icon" href="/favicon.svg" />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={siteConfig.author} />
<meta name="publisher" content="M. Apriyanto Wijaya (@madebyaapri)" />
<meta name="keywords" content={siteConfig.keywords.join(', ')} />
<link rel="canonical" href={canonicalURL} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

<!-- Geo Local SEO Tags (Kota Cimahi, Jawa Barat) -->
<meta name="geo.region" content="ID-JB" />
<meta name="geo.placename" content="Kota Cimahi" />
<meta name="geo.position" content="-6.872288;107.542046" />
<meta name="ICBM" content="-6.872288, 107.542046" />

<!-- Open Graph / Facebook & Threads -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageURL} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content="madebyaapri — Kang Apri" />
<meta property="og:locale" content="id_ID" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageURL} />
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:creator" content="@madebyaapri" />

<!-- Structured Data JSON-LD Schemas -->
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
