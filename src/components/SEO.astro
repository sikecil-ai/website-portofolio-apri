---
import { siteConfig } from '../data/siteConfig';
import { projects } from '../data/projects';
import { articles } from '../data/articles';
import type { SEOProps } from '../types';

export interface Props extends SEOProps {}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = siteConfig.ogImage,
  canonicalURL = Astro.url.href,
  type = 'website',
} = Astro.props;

const fullImageUrl = new URL(image, siteConfig.url).href;
const fullCanonicalUrl = new URL(Astro.url.pathname, siteConfig.url).href;

// JSON-LD Schema: Person
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.name,
  alternateName: ['Kang Apri', 'madebyaapri'],
  url: siteConfig.url,
  image: new URL('/images/avatar.svg', siteConfig.url).href,
  jobTitle: 'Workflow Automation Specialist & Google Workspace Solutions Developer',
  worksFor: {
    '@type': 'Organization',
    name: 'madebyaapri Digital Solutions',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kota Cimahi',
    addressRegion: 'Jawa Barat',
    postalCode: '40532',
    addressCountry: 'ID',
  },
  sameAs: siteConfig.socialLinks.map((link) => link.url),
  description: siteConfig.bio,
  knowsAbout: [
    'Otomasi Alur Kerja Tanpa Server',
    'Aplikasi Kasir & Rekap Keuangan UMKM',
    'Aplikasi Tabulasi Lomba Paskibra Real-time',
    'Google Apps Script (GAS)',
    'Google Workspace Automation',
    'Looker Studio Business Intelligence',
    'AI Automation & Gemini API',
    'Zero Server Cost Architecture',
  ],
};

// JSON-LD Schema: WebSite with SearchAction
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Kang Apri (@madebyaapri) — Otomasi Alur Kerja & Sistem Bisnis Tanpa Server',
  url: siteConfig.url,
  description: siteConfig.description,
  author: {
    '@type': 'Person',
    name: siteConfig.name,
  },
  inLanguage: 'id-ID',
};

// JSON-LD Schema: FAQPage for Google Rich Snippets
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Apakah benar-benar tanpa biaya sewa server bulanan (Zero Server Cost)?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Ya, 100% benar! Kami memanfaatkan arsitektur serverless Google Workspace (Google Sheets Database Engine, Google Apps Script, dan Looker Studio) yang disediakan gratis oleh Google tanpa biaya langganan bulanan.',
      },
    },
    {
      '@type': 'Question',
      name: 'Bisnis apa saja yang bisa dibuatkan sistem otomasi alur kerja & aplikasi kasir?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Semua jenis usaha! Kami telah menangani bisnis kuliner (F&B), toko retail, klinik, jasa penulisan, event organizer, panitia lomba Paskibra/LKBB, hingga administrasi sekolah.',
      },
    },
    {
      '@type': 'Question',
      name: 'Berapa lama proses pembuatan dan implementasi sistem otomasi?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Untuk kebutuhan standar seperti sistem kasir F&B atau tabulasi lomba, waktu pengerjaan umumnya memakan waktu 3 hingga 7 hari kerja sudah siap pakai dan teruji di lapangan.',
      },
    },
    {
      '@type': 'Question',
      name: 'Bagaimana cara memesan aplikasi tabulasi lomba Paskibra KOMANDO?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Cukup klik tombol WhatsApp di website ini dan sampaikan tanggal event serta jumlah pleton peserta. Kami akan menyiapkan sistem tabulasi live real-time untuk kejuaraan Anda.',
      },
    },
  ],
};

// JSON-LD Schema: ItemList (Portfolio Applications)
const projectListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Sistem Otomasi & Aplikasi by ' + siteConfig.name,
  itemListElement: projects.map((project, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: project.title,
      description: project.description,
      applicationCategory: project.category,
      operatingSystem: 'All (Cloud, Web, Mobile)',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'IDR',
      },
    },
  })),
};

// JSON-LD Schema: Blog / Articles Collection
const articlesSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Studi Kasus & Artikel Otomasi by Kang Apri (@madebyaapri)',
  description: 'Kumpulan cerita nyata dan studi kasus di balik layar pengembangan 7 sistem otomasi alur kerja, kasir F&B, dan tabulasi lomba.',
  url: `${siteConfig.url}#artikel`,
  blogPost: articles.map((article) => ({
    '@type': 'BlogPosting',
    headline: article.title,
    description: article.excerpt,
    datePublished: '2025-01-01',
    author: {
      '@type': 'Person',
      name: siteConfig.name,
    },
    inLanguage: 'id-ID',
  })),
};

// JSON-LD Schema: BreadcrumbList
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Beranda',
      item: siteConfig.url,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Sistem & Solusi',
      item: `${siteConfig.url}#proyek`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Artikel & Studi Kasus',
      item: `${siteConfig.url}#artikel`,
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: 'FAQ',
      item: `${siteConfig.url}#faq`,
    },
  ],
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<meta name="theme-color" content="#090d16" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

<!-- Primary Meta Tags with Google Trends Repeating Keywords -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={siteConfig.keywords.join(', ')} />
<meta name="author" content={siteConfig.author} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<link rel="canonical" href={fullCanonicalUrl} />

<!-- Geo & Local SEO Tagging (Kota Cimahi, Jawa Barat) -->
<meta name="geo.region" content="ID-JB" />
<meta name="geo.placename" content="Kota Cimahi" />
<meta name="geo.position" content="-6.872288;107.542046" />
<meta name="ICBM" content="-6.872288, 107.542046" />
<meta name="language" content="Indonesian" />

<!-- Open Graph / Facebook / WhatsApp -->
<meta property="og:type" content={type} />
<meta property="og:url" content={fullCanonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content="madebyaapri — Kang Apri" />
<meta property="og:locale" content="id_ID" />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={fullCanonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageUrl} />
<meta name="twitter:creator" content="@madebyaapri" />

<!-- Font Preconnect -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
  rel="stylesheet"
/>

<!-- Google SEO Structured Data (JSON-LD Rich Snippets) -->
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(projectListSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(articlesSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
