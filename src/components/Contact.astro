---
import { siteConfig } from '../data/siteConfig';
---

<section id="kontak" class="relative py-24 sm:py-32 bg-white/60 dark:bg-[#070b14]/60 border-t border-slate-200/60 dark:border-slate-800/60 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-cyan-50 dark:bg-cyan-950/60 border border-cyan-200 dark:border-cyan-800 text-cyan-700 dark:text-cyan-400 text-xs font-semibold uppercase tracking-wider mb-4">
        <span>📫</span>
        <span>Konsultasi &amp; Kontak Langsung</span>
      </div>
      
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-slate-50 tracking-tight leading-[1.2] mb-4">
        Mari Mulai <span class="text-gradient-cyan">Upgrade Alur Kerja Anda</span>
      </h2>
      
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Punya spreadsheet ruwet, sistem kasir yang lambat, atau butuh tabulasi kejuaraan Paskibra tanpa server? Diskusikan santai bareng Kang Apri.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start max-w-5xl mx-auto">
      
      <!-- Left Column: Contact Cards & Socials -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        
        <!-- Direct WhatsApp Card -->
        <a
          href="https://wa.me/6282118313655?text=Halo%20Kang%20Apri,%20saya%20tertarik%20berkonsultasi%20mengenai%20upgrade%20sistem%20otomasi."
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-3xl p-6 sm:p-7 border border-emerald-300 dark:border-emerald-800/80 bg-emerald-50/50 dark:bg-emerald-950/30 block group hover:border-emerald-500 transition-all shadow-sm"
        >
          <div class="flex items-center justify-between gap-3 mb-2">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-2xl bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-xl">
                💬
              </div>
              <div>
                <h3 class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">Fast Response WhatsApp</h3>
                <p class="text-base font-bold text-slate-900 dark:text-slate-100">+62 821-1831-3655</p>
              </div>
            </div>
            <span class="text-emerald-500 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-400 mt-2">
            Konsultasi langsung tanpa perantara. Arsitektur sistem dan estimasi dijelaskan secara transparan.
          </p>
        </a>

        <!-- Local Base Card -->
        <div class="rounded-3xl p-6 border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 rounded-2xl bg-cyan-50 dark:bg-cyan-950/60 text-cyan-600 dark:text-cyan-400 flex items-center justify-center font-bold text-lg">
              📍
            </div>
            <div>
              <h3 class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Lokasi &amp; Domisili</h3>
              <p class="text-sm font-bold text-slate-900 dark:text-slate-100">Cibeber, Kota Cimahi</p>
            </div>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Melayani konsultasi langsung untuk area Bandung Raya &amp; implementasi online ke seluruh Indonesia.
          </p>
        </div>

        <!-- Social Channels -->
        <div class="rounded-3xl p-6 border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-3">Sosial Media Resmi @madebyaapri</h4>
          <div class="flex flex-col gap-2">
            {siteConfig.socialLinks.filter(l => ['Threads', 'Instagram', 'LinkedIn'].includes(l.name)).map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 hover:bg-slate-100 dark:hover:bg-slate-700 border border-slate-200/60 dark:border-slate-700/60 text-slate-700 dark:text-slate-200 transition-all text-xs font-semibold"
              >
                <span>{link.name}</span>
                <span class="text-slate-400 text-xs font-normal">{link.username}</span>
              </a>
            ))}
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Quick Message Form -->
      <div class="lg:col-span-7">
        <div class="rounded-3xl p-6 sm:p-8 border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
          <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-slate-100 mb-1">Kirim Pesan WhatsApp Cepat</h3>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-6">
            Isi formulir ringkas di bawah ini, tombol akan otomatis membuat format chat WhatsApp yang rapi ke Kang Apri.
          </p>

          <form id="contact-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Nama Anda / Brand *</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Contoh: Budi / Kedai Kopi"
                  class="w-full px-4 py-2.5 rounded-xl text-xs sm:text-sm bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/50 transition-all"
                />
              </div>

              <div>
                <label for="service" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Kebutuhan Utama *</label>
                <select
                  id="service"
                  name="service"
                  class="w-full px-4 py-2.5 rounded-xl text-xs sm:text-sm bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-cyan-500/50 transition-all"
                >
                  <option value="Sistem Kasir & Operasional Bisnis (Si Paling Kasir)">Sistem Kasir &amp; Operasional F&amp;B</option>
                  <option value="Tabulasi Kejuaraan LKBB/Paskibra (Si Paling Rekap)">Tabulasi Kejuaraan LKBB / Paskibra</option>
                  <option value="Otomasi Alur Spreadsheet Kustom">Otomasi Alur Spreadsheet Kustom</option>
                  <option value="Sesi 1-Hour Diagnostic">Sesi 1-Hour Diagnostic</option>
                </select>
              </div>
            </div>

            <div>
              <label for="message" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Ceritakan Kendala / Alur Kerja Anda *</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="Contoh: Rekap kasir harian masih manual dan butuh waktu 2 jam tiap malam, ingin otomatis masuk ke Google Sheets..."
                class="w-full px-4 py-2.5 rounded-xl text-xs sm:text-sm bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/50 transition-all resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-3.5 px-6 rounded-xl text-xs sm:text-sm font-semibold text-white bg-slate-900 dark:bg-white dark:text-slate-900 hover:bg-slate-800 dark:hover:bg-slate-100 shadow-sm transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>💬 Kirim Pesan ke WhatsApp Kang Apri →</span>
            </button>
          </form>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const initContactForm = () => {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('name') as HTMLInputElement)?.value.trim() || 'Teman';
      const service = (document.getElementById('service') as HTMLSelectElement)?.value || 'Konsultasi Sistem';
      const message = (document.getElementById('message') as HTMLTextAreaElement)?.value.trim() || '';

      const waText = `Halo Kang Apri, saya ${name}. Saya tertarik dengan layanan ${service}.\n\nDetail kendala/kebutuhan saya:\n${message}`;
      const waUrl = `https://wa.me/6282118313655?text=${encodeURIComponent(waText)}`;

      window.open(waUrl, '_blank');
    });
  };

  initContactForm();
  document.addEventListener('astro:after-swap', initContactForm);
</script>
