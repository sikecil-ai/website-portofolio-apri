---
import { siteConfig } from '../data/siteConfig';
---

<section id="kontak" class="relative py-24 sm:py-32 bg-slate-50/50 dark:bg-slate-900/30 border-t border-slate-200/60 dark:border-slate-800/60 overflow-hidden">
  <!-- Glows -->
  <div class="ambient-glow bg-brand-500/15 top-1/4 left-10 w-96 h-96 animate-pulse-glow"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-600 dark:text-emerald-400 text-xs font-semibold uppercase tracking-wider mb-4">
        📫 Hubungi &amp; Konsultasi Langsung
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-slate-50 tracking-tight mb-4">
        Mari Mulai <span class="text-gradient">Upgrade Alur Kerja Anda</span>
      </h2>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
        Punya spreadsheet ruwet, sistem kasir yang lambat, atau butuh tabulasi kejuaraan Paskibra tanpa server? Diskusikan langsung via WhatsApp.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start max-w-5xl mx-auto">
      
      <!-- Left Column: Contact Cards & Socials -->
      <div class="lg:col-span-5 flex flex-col gap-6">
        
        <!-- Direct WhatsApp Card -->
        <a
          href="https://wa.me/6282118313655?text=Halo%20Kang%20Apri,%20saya%20tertarik%20berkonsultasi%20mengenai%20upgrade%20sistem%20otomasi."
          target="_blank"
          rel="noopener noreferrer"
          class="glass-card rounded-3xl p-6 sm:p-7 border border-emerald-300 dark:border-emerald-800/80 bg-gradient-to-br from-emerald-50/70 to-teal-50/40 dark:from-emerald-950/40 dark:to-teal-950/30 block group hover:border-emerald-500 transition-all"
        >
          <div class="flex items-center justify-between gap-3 mb-2">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-xl">
                💬
              </div>
              <div>
                <h3 class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">Fast Response WhatsApp</h3>
                <p class="text-base font-bold text-slate-900 dark:text-slate-100">+62 821-1831-3655</p>
              </div>
            </div>
            <span class="text-emerald-500 group-hover:translate-x-1 transition-transform">→</span>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">
            Konsultasi langsung tanpa perantara. Estimasi arsitektur dan skema biaya dijelaskan transparan.
          </p>
        </a>

        <!-- Direct Email Card with Copy button -->
        <div class="glass-card rounded-3xl p-6 sm:p-7 border border-slate-200/80 dark:border-slate-800/80 bg-white/80 dark:bg-slate-900/70">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-brand-500/10 dark:bg-brand-500/20 text-brand-600 dark:text-brand-400 flex items-center justify-center font-bold">
              ✉️
            </div>
            <div>
              <h3 class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Email Resmi</h3>
              <p class="text-base font-bold text-slate-900 dark:text-slate-100">{siteConfig.email}</p>
            </div>
          </div>

          <button
            type="button"
            id="copy-email-btn"
            class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800 hover:bg-brand-50 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200 hover:text-brand-600 transition-all cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
            <span id="copy-btn-text">Salin Alamat Email</span>
          </button>
        </div>

        <!-- Social Media Grid -->
        <div class="glass-card rounded-3xl p-6 border border-slate-200/80 dark:border-slate-800/80 bg-white/80 dark:bg-slate-900/70">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-4">Channel &amp; Sosmed @madebyaapri</h4>
          <div class="grid grid-cols-2 gap-2.5">
            {siteConfig.socialLinks.filter(l => l.name !== 'Email').map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2 p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/60 hover:bg-brand-50 dark:hover:bg-slate-700 border border-slate-200/60 dark:border-slate-700/60 text-slate-700 dark:text-slate-200 transition-all text-xs font-medium"
              >
                <span class="font-bold text-brand-600 dark:text-brand-400">●</span>
                <span>{link.name}</span>
              </a>
            ))}
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Contact Form -->
      <div class="lg:col-span-7">
        <div class="glass-card rounded-3xl p-6 sm:p-8 border border-slate-200/80 dark:border-slate-800/80 bg-white/90 dark:bg-slate-900/80">
          <h3 class="text-xl font-bold text-slate-900 dark:text-slate-100 mb-1">Kirim Pesan Langsung</h3>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mb-6">
            Diskusikan kebutuhan perapian spreadsheet, pembuatan sistem kasir smartphone, atau tabulasi kejuaraan Paskibra.
          </p>

          <form id="contact-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Nama Anda / Instansi *</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Contoh: Budi / Panitia LKBB"
                  class="w-full px-4 py-2.5 rounded-xl text-xs sm:text-sm bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/50 transition-all"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Email Anda *</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="nama@perusahaan.com"
                  class="w-full px-4 py-2.5 rounded-xl text-xs sm:text-sm bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/50 transition-all"
                />
              </div>
            </div>

            <div>
              <label for="subject" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Topik / Kebutuhan</label>
              <input
                type="text"
                id="subject"
                name="subject"
                placeholder="Upgrade Spreadsheet / Custom POS Kasir / Tabulasi Lomba"
                class="w-full px-4 py-2.5 rounded-xl text-xs sm:text-sm bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/50 transition-all"
              />
            </div>

            <div>
              <label for="message" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Ceritakan Masalah Alur Kerja Anda *</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="Jelaskan proses manual atau spreadsheet yang ingin diupgrade menjadi rapi dan otomatis..."
                class="w-full px-4 py-2.5 rounded-xl text-xs sm:text-sm bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500/50 transition-all resize-none"
              ></textarea>
            </div>

            <div class="pt-2 flex flex-col sm:flex-row gap-3">
              <button
                type="button"
                id="whatsapp-btn"
                class="btn-primary flex-1 cursor-pointer py-3"
              >
                <span class="text-base">💬</span>
                <span>Chat WhatsApp Kang Apri</span>
              </button>

              <button
                type="submit"
                class="btn-secondary cursor-pointer py-3"
              >
                <span>Kirim via Email</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </button>
            </div>

            <div id="form-feedback" class="hidden p-3 rounded-xl text-xs font-medium text-center transition-all"></div>
          </form>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const initContact = () => {
    const copyBtn = document.getElementById('copy-email-btn');
    const copyBtnText = document.getElementById('copy-btn-text');
    const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
    const whatsappBtn = document.getElementById('whatsapp-btn');
    const feedback = document.getElementById('form-feedback');

    // Email copy
    if (copyBtn && copyBtnText) {
      copyBtn.addEventListener('click', () => {
        const email = 'sohibwijaya@gmail.com';
        navigator.clipboard.writeText(email).then(() => {
          copyBtnText.textContent = '✓ Alamat Email Tersalin!';
          copyBtn.classList.add('bg-emerald-50', 'text-emerald-600', 'dark:bg-emerald-950', 'dark:text-emerald-400');
          setTimeout(() => {
            copyBtnText.textContent = 'Salin Alamat Email';
            copyBtn.classList.remove('bg-emerald-50', 'text-emerald-600', 'dark:bg-emerald-950', 'dark:text-emerald-400');
          }, 3000);
        });
      });
    }

    // Form submit to mailto
    if (contactForm) {
      contactForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = (document.getElementById('name') as HTMLInputElement).value;
        const email = (document.getElementById('email') as HTMLInputElement).value;
        const subject = (document.getElementById('subject') as HTMLInputElement).value || 'Pesan dari Portofolio';
        const message = (document.getElementById('message') as HTMLTextAreaElement).value;

        const body = `Halo Kang Apri (@madebyaapri),\n\nNama: ${name}\nEmail: ${email}\n\nPesan:\n${message}`;
        const mailtoUrl = `mailto:sohibwijaya@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        
        window.location.href = mailtoUrl;

        if (feedback) {
          feedback.textContent = '✓ Membuka email client Anda... Terima kasih!';
          feedback.className = 'p-3 rounded-xl text-xs font-medium text-center bg-emerald-50 text-emerald-700 dark:bg-emerald-950/80 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800';
          feedback.classList.remove('hidden');
        }
      });
    }

    // WhatsApp Direct Message
    if (whatsappBtn) {
      whatsappBtn.addEventListener('click', () => {
        const name = (document.getElementById('name') as HTMLInputElement)?.value || '';
        const message = (document.getElementById('message') as HTMLTextAreaElement)?.value || '';
        const greeting = name ? `Halo Kang Apri, saya ${name}.` : 'Halo Kang Apri,';
        const text = `${greeting} ${message ? `Terkait: ${message}` : 'Saya tertarik untuk berkonsultasi mengenai perapian sistem & otomasi alur kerja.'}`;
        
        const waUrl = `https://wa.me/6282118313655?text=${encodeURIComponent(text)}`;
        window.open(waUrl, '_blank');
      });
    }
  };

  initContact();
  document.addEventListener('astro:after-swap', initContact);
</script>
