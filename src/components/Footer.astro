---
import { siteConfig } from '../data/siteConfig';
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-950/80 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      
      <!-- Brand & Copyright -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
        <div class="flex items-center gap-2 mb-2">
          <div class="w-6 h-6 rounded-lg bg-gradient-to-tr from-brand-600 to-cyan-500 flex items-center justify-center text-white font-bold text-xs font-mono">
            mba
          </div>
          <span class="font-bold text-slate-900 dark:text-slate-100 text-sm">madebyaapri</span>
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-400">
          &copy; {currentYear} {siteConfig.name}. Seluruh Hak Cipta Dilindungi.
        </p>
      </div>

      <!-- Quick Nav Links -->
      <div class="flex flex-wrap justify-center items-center gap-4 text-xs font-medium text-slate-600 dark:text-slate-400">
        {siteConfig.navLinks.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : '_self'}
            class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors"
          >
            {link.name}
          </a>
        ))}
      </div>

      <!-- Lynk.id & Back to Top -->
      <div class="flex items-center gap-3">
        <a
          href="https://lynk.id/madebyaapri"
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-1.5 rounded-xl border border-pink-200 dark:border-pink-900/50 bg-pink-50 dark:bg-pink-950/40 text-pink-600 dark:text-pink-400 text-xs font-semibold hover:bg-pink-100 transition-all"
        >
          🛍️ Lynk.id Store
        </a>

        <a
          href="#beranda"
          class="p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 hover:border-brand-500/40 transition-all cursor-pointer"
          aria-label="Kembali ke atas"
          title="Kembali ke atas"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
          </svg>
        </a>
      </div>

    </div>

    <!-- Tech Stack Attribution & Signature -->
    <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-900 flex flex-col sm:flex-row items-center justify-between text-[11px] text-slate-400 gap-2 text-center">
      <span>Crafted with precision by <strong class="text-slate-700 dark:text-slate-300">@madebyaapri</strong> • Zero Server Cost Architecture</span>
      <span class="flex items-center gap-1.5">
        Ditenagai oleh <span class="font-semibold text-slate-700 dark:text-slate-300">Astro 5</span> &amp; <span class="font-semibold text-slate-700 dark:text-slate-300">Tailwind CSS</span>
      </span>
    </div>
  </div>
</footer>
