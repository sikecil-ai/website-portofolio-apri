---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

const categories = ['Semua', 'Otomasi Google Sheets (GAS)', 'Kasir & Operasional Bisnis', 'AI & Bot Cerdas'];
---

<section id="proyek" class="relative py-24 sm:py-32 bg-slate-50/50 dark:bg-[#070b14]/50 border-t border-slate-200/60 dark:border-slate-800/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-cyan-50 dark:bg-cyan-950/60 border border-cyan-200 dark:border-cyan-800 text-cyan-700 dark:text-cyan-400 text-xs font-semibold uppercase tracking-wider mb-4">
        <span>🏆</span>
        <span>Etalase Sistem &amp; Mahakarya</span>
      </div>
      
      <h2 class="type-h2 mb-4">
        Solusi Nyata yang <span class="text-gradient-cyan">Terbukti di Lapangan</span>
      </h2>
      
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Dari manajemen organisasi 147 anggota, monitoring 871 siswa madrasah, sistem tabulasi kejuaraan 0 detik delay, hingga kasir F&amp;B zero server cost.
      </p>
    </div>

    <!-- Filter Bar & Real-time Search Controls -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 mb-10 pb-6 border-b border-slate-200 dark:border-slate-800/80">
      
      <!-- Category Filter Pills -->
      <div class="flex items-center gap-2 overflow-x-auto w-full md:w-auto pb-2 md:pb-0 scrollbar-none" id="category-filters">
        {categories.map((cat, idx) => (
          <button
            type="button"
            class={`category-filter-btn px-4 py-2 text-xs sm:text-sm font-semibold rounded-xl transition-all duration-200 whitespace-nowrap cursor-pointer ${
              idx === 0
                ? 'bg-slate-900 dark:bg-white text-white dark:text-slate-900 shadow-sm'
                : 'bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700'
            }`}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Search Box -->
      <div class="relative w-full md:w-72">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        <input
          type="text"
          id="project-search"
          placeholder="Cari sistem atau fitur..."
          class="w-full pl-10 pr-4 py-2.5 rounded-xl text-xs sm:text-sm bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-slate-100 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/50 focus:border-cyan-500 transition-all"
        />
      </div>

    </div>

    <!-- Cards Grid -->
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6 sm:gap-8">
      {projects.map((project, idx) => (
        <ProjectCard project={project} index={idx} />
      ))}
    </div>

    <!-- Expand / Collapse All Projects Button -->
    {projects.length > 4 && (
      <div id="expand-projects-container" class="mt-10 flex justify-center">
        <button
          type="button"
          id="btn-expand-projects"
          class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-2xl bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 font-semibold text-xs sm:text-sm border border-slate-200 dark:border-slate-800 shadow-sm hover:shadow-md hover:border-slate-300 dark:hover:border-slate-700 transition-all duration-200 cursor-pointer group"
          aria-expanded="false"
        >
          <span id="expand-icon" class="text-cyan-600 dark:text-cyan-400 group-hover:scale-110 transition-transform duration-200">📂</span>
          <span id="expand-text">Tampilkan Semua Mahakarya ({projects.length} Sistem)</span>
          <svg id="expand-arrow" class="w-4 h-4 text-slate-400 group-hover:text-cyan-500 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
      </div>
    )}

    <!-- Empty State -->
    <div id="empty-state" class="hidden text-center py-16 px-4">
      <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-1">Sistem Tidak Ditemukan</h3>
      <p class="text-sm text-slate-500 dark:text-slate-400 max-w-sm mx-auto">
        Tidak ada sistem yang cocok dengan kata kunci atau filter yang Anda pilih. Silakan coba kata kunci lain.
      </p>
    </div>

    <!-- Bottom Bridge CTA -->
    <div class="mt-14 p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
      <div>
        <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-1">
          Punya Kebutuhan Alur Sistem yang Berbeda?
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300">
          Setiap bisnis punya kebiasaan unik. Kami siap merancang alur kustom yang 100% pas untuk tim Anda.
        </p>
      </div>

      <a
        href="https://wa.me/6282118313655?text=Halo%20Apri,%20aku%20mau%20konsultasi%20kebutuhan%20sistem%20kustom%20untuk%20operasional%20bisnis."
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 px-6 py-3 rounded-xl bg-cyan-600 hover:bg-cyan-700 text-white font-semibold text-xs sm:text-sm shadow-sm transition-all"
      >
        <span>💬 Konsultasi Sistem Kustom via WA →</span>
      </a>
    </div>

  </div>

  <!-- Interactive Project Details Modal -->
  <div
    id="project-modal"
    class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 sm:p-6 md:p-10 bg-slate-950/80 backdrop-blur-md opacity-0 transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
  >
    <div class="relative w-full max-w-2xl max-h-[90vh] overflow-y-auto bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-2xl transform scale-95 transition-transform duration-300 p-6 sm:p-8" id="modal-content-container">
      
      <!-- Close Button -->
      <button
        type="button"
        id="modal-close-btn"
        class="absolute top-4 right-4 sm:top-6 sm:right-6 p-2 rounded-xl text-slate-400 hover:text-slate-900 dark:hover:text-white bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors cursor-pointer"
        aria-label="Tutup modal"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Modal Image -->
      <div class="w-full aspect-[16/9] rounded-2xl overflow-hidden mb-6 bg-slate-950">
        <img id="modal-image" src="" alt="" class="w-full h-full object-cover object-center" />
      </div>

      <!-- Modal Badges -->
      <div class="flex items-center gap-2 mb-3">
        <span id="modal-category" class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-cyan-50 dark:bg-cyan-950 text-cyan-700 dark:text-cyan-400 border border-cyan-200 dark:border-cyan-800">
        </span>
        <span id="modal-date" class="text-xs text-slate-500 font-mono"></span>
      </div>

      <!-- Modal Title & Subtitle -->
      <h3 id="modal-title" class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 mb-3"></h3>
      <p id="modal-desc" class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-6"></p>

      <!-- Stats Grid -->
      <div id="modal-stats" class="grid grid-cols-3 gap-3 mb-6 p-4 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60">
      </div>

      <!-- Features List -->
      <div class="mb-6">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-100 mb-3">Fitur &amp; Keunggulan Sistem</h4>
        <ul id="modal-features" class="space-y-2 text-xs sm:text-sm text-slate-600 dark:text-slate-300">
        </ul>
      </div>

      <!-- Technologies -->
      <div class="mb-8">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-100 mb-3">Teknologi &amp; Engine</h4>
        <div id="modal-tags" class="flex flex-wrap gap-2"></div>
      </div>

      <!-- Modal Actions with Direct WA -->
      <div class="flex items-center gap-3 pt-4 border-t border-slate-200 dark:border-slate-800">
        <a id="modal-demo-btn" href="#" target="_blank" rel="noopener noreferrer" class="w-full py-3 rounded-xl bg-cyan-600 hover:bg-cyan-700 text-white font-semibold text-xs sm:text-sm text-center shadow-sm transition-all flex items-center justify-center gap-2">
          <span class="text-base">💬</span>
          <span>Konsultasi / Pesan Sistem Ini (WhatsApp)</span>
        </a>
      </div>

    </div>
  </div>
</section>

<script>
  const initGallery = () => {
    const filterBtns = document.querySelectorAll('.category-filter-btn');
    const searchInput = document.getElementById('project-search') as HTMLInputElement | null;
    const cards = document.querySelectorAll('.project-card') as NodeListOf<HTMLElement>;
    const emptyState = document.getElementById('empty-state');
    const expandContainer = document.getElementById('expand-projects-container');
    const expandBtn = document.getElementById('btn-expand-projects');
    const expandText = document.getElementById('expand-text');
    const expandArrow = document.getElementById('expand-arrow');

    // Modal elements
    const modal = document.getElementById('project-modal');
    const modalContainer = document.getElementById('modal-content-container');
    const modalCloseBtn = document.getElementById('modal-close-btn');
    const modalImage = document.getElementById('modal-image') as HTMLImageElement | null;
    const modalTitle = document.getElementById('modal-title');
    const modalCategory = document.getElementById('modal-category');
    const modalDate = document.getElementById('modal-date');
    const modalDesc = document.getElementById('modal-desc');
    const modalStats = document.getElementById('modal-stats');
    const modalFeatures = document.getElementById('modal-features');
    const modalTags = document.getElementById('modal-tags');
    const modalDemoBtn = document.getElementById('modal-demo-btn') as HTMLAnchorElement | null;

    let activeCategory = 'Semua';
    let searchQuery = '';
    let isExpanded = false;
    const INITIAL_VISIBLE_LIMIT = 4;

    const filterCards = () => {
      let matchedCount = 0;
      let visibleCount = 0;
      const isFilteringOrSearching = activeCategory !== 'Semua' || searchQuery !== '';

      cards.forEach((card) => {
        card.classList.remove('hidden');

        const category = card.dataset.category || '';
        const title = card.dataset.title || '';
        const tags = card.dataset.tags || '';
        const cardIndex = parseInt(card.dataset.index || '0', 10);

        const matchesCategory = activeCategory === 'Semua' || category === activeCategory;
        const matchesSearch =
          searchQuery === '' ||
          title.includes(searchQuery) ||
          tags.includes(searchQuery) ||
          category.toLowerCase().includes(searchQuery);

        const isMatch = matchesCategory && matchesSearch;

        if (isMatch) {
          matchedCount++;
          // When filtering or searching, show all matched cards. When in default browse, respect 4-card limit unless expanded.
          const shouldShow = isFilteringOrSearching || isExpanded || cardIndex < INITIAL_VISIBLE_LIMIT;

          if (shouldShow) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyState) {
        if (matchedCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }

      // Manage expand button visibility based on filter state
      if (expandContainer) {
        if (isFilteringOrSearching || matchedCount <= INITIAL_VISIBLE_LIMIT) {
          expandContainer.style.display = 'none';
        } else {
          expandContainer.style.display = 'flex';
        }
      }
    };

    // Expand / Collapse Button Click Listener
    if (expandBtn) {
      expandBtn.addEventListener('click', () => {
        isExpanded = !isExpanded;
        expandBtn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');

        if (expandText) {
          expandText.textContent = isExpanded
            ? 'Tutup Sebagian Sistem'
            : `Tampilkan Semua Mahakarya (${cards.length} Sistem)`;
        }
        if (expandArrow) {
          if (isExpanded) {
            expandArrow.classList.add('rotate-180');
          } else {
            expandArrow.classList.remove('rotate-180');
          }
        }

        filterCards();

        // Scroll gracefully back to projects grid when collapsed
        if (!isExpanded) {
          const gallerySection = document.getElementById('proyek');
          if (gallerySection) {
            gallerySection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    }

    // Category Button Clicks
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('bg-slate-900', 'dark:bg-white', 'text-white', 'dark:text-slate-900', 'shadow-sm');
          b.classList.add('bg-white', 'dark:bg-slate-800', 'border', 'border-slate-200', 'dark:border-slate-700', 'text-slate-600', 'dark:text-slate-300');
        });

        btn.classList.remove('bg-white', 'dark:bg-slate-800', 'border', 'border-slate-200', 'dark:border-slate-700', 'text-slate-600', 'dark:text-slate-300');
        btn.classList.add('bg-slate-900', 'dark:bg-white', 'text-white', 'dark:text-slate-900', 'shadow-sm');

        activeCategory = btn.getAttribute('data-category') || 'Semua';
        filterCards();
      });
    });

    // Search Input Typing
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        filterCards();
      });
    }

    // Modal Trigger Logic
    const openModal = (project: any) => {
      if (!modal || !modalImage || !modalTitle || !modalDesc || !modalCategory || !modalDate || !modalFeatures || !modalTags || !modalStats) return;

      modalImage.src = project.heroDesktopImage || project.heroMobileImage || project.image;
      modalImage.alt = project.title;
      modalTitle.textContent = project.title;
      modalCategory.textContent = project.category;
      modalDate.textContent = `${project.role} • ${project.date}`;
      modalDesc.textContent = project.fullDescription || project.description;

      // Stats
      modalStats.innerHTML = '';
      if (project.stats && project.stats.length > 0) {
        modalStats.classList.remove('hidden');
        project.stats.forEach((s: any) => {
          const div = document.createElement('div');
          div.className = 'text-center';
          div.innerHTML = `<span class="block text-base font-extrabold text-cyan-600 dark:text-cyan-400">${s.value}</span><span class="text-[10px] text-slate-500 dark:text-slate-400 uppercase tracking-wider">${s.label}</span>`;
          modalStats.appendChild(div);
        });
      } else {
        modalStats.classList.add('hidden');
      }

      // Features
      modalFeatures.innerHTML = '';
      if (project.features && project.features.length > 0) {
        project.features.forEach((feat: string) => {
          const li = document.createElement('li');
          li.className = 'flex items-start gap-2';
          li.innerHTML = `<span class="text-emerald-500 font-bold mt-0.5">✓</span><span>${feat}</span>`;
          modalFeatures.appendChild(li);
        });
      }

      // Tags
      modalTags.innerHTML = '';
      project.tags.forEach((tag: string) => {
        const span = document.createElement('span');
        span.className = 'px-2.5 py-1 text-xs font-medium rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700';
        span.textContent = tag;
        modalTags.appendChild(span);
      });

      // Actions: Direct WhatsApp link
      if (modalDemoBtn) {
        if (project.demoUrl) {
          modalDemoBtn.href = project.demoUrl;
          modalDemoBtn.classList.remove('hidden');
        } else {
          modalDemoBtn.classList.add('hidden');
        }
      }

      // Show modal
      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        modalContainer?.classList.remove('scale-95');
        modalContainer?.classList.add('scale-100');
      }, 10);
      document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
      if (!modal) return;
      modal.classList.add('opacity-0');
      modalContainer?.classList.remove('scale-100');
      modalContainer?.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
      }, 300);
    };

    cards.forEach((card) => {
      card.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('a') || target.closest('button')) return;
        if (card.dataset.projectJson) {
          const project = JSON.parse(card.dataset.projectJson);
          openModal(project);
        }
      });
    });

    if (modalCloseBtn) {
      modalCloseBtn.addEventListener('click', closeModal);
    }

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });

    // Initial run to sync visibility and expand states
    filterCards();
  };

  initGallery();
  document.addEventListener('astro:after-swap', initGallery);
</script>
