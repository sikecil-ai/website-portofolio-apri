---
import { siteConfig } from '../data/siteConfig';

const pillars = [
  {
    icon: '💰',
    title: 'Rp 0 Biaya Server Bulanan',
    subtitle: 'Google Apps Script Engine',
    description: 'Memaksimalkan ekosistem Google Workspace untuk membangun sistem bisnis tangguh seumur hidup tanpa biaya sewa server atau cloud bulanan.',
  },
  {
    icon: '⚡',
    title: '1 Klik Print Beres (0 Detik Delay)',
    subtitle: 'High-Stakes Tabulation & Reporting',
    description: 'Laporan administrasi, rekap juri, atau pembukuan yang biasanya makan waktu berjam-jam kini otomatis terhitung dan siap print seketika.',
  },
  {
    icon: '📊',
    title: 'Visual Dashboard Interaktif',
    subtitle: 'Looker Studio Smartphone View',
    description: 'Helicopter view satu layar untuk memantau tren omset kasir, stok bahan, dan laba harian secara real-time langsung dari smartphone Anda.',
  },
  {
    icon: '🤖',
    title: 'Integrasi AI Cerdas (Gemini AI)',
    subtitle: 'Grounding Data Nyata Tanpa Halu',
    description: 'Otomasi pembuatan copywriting, ringkasan laporan, dan analisis cerdas menggunakan Gemini AI yang selalu membaca data riil toko Anda.',
  },
];
---

<section id="tentang" class="py-20 border-t border-slate-200/60 dark:border-slate-800/60 relative bg-white/40 dark:bg-[#080d1a]/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Storytelling, Philosophy & Local SEO Hook -->
      <div class="lg:col-span-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-cyan-50 dark:bg-cyan-950/60 border border-cyan-200 dark:border-cyan-800 text-cyan-700 dark:text-cyan-400 text-xs font-semibold uppercase tracking-wider mb-5">
          <span>👤</span>
          <span>Tentang Apri (@madebyaapri)</span>
        </div>
        
        <h2 class="type-h2 mb-5">
          Dedikasi pada <span class="text-gradient-cyan">Otomasi Nyata &amp; Hasil Terukur</span>
        </h2>
        
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
          Halo! Aku Apri (<a href="https://instagram.com/madebyaapri" target="_blank" rel="noopener noreferrer" class="text-cyan-600 dark:text-cyan-400 font-semibold hover:underline">@madebyaapri</a>). Aku bantu pemilik bisnis, manajer, dan tim operasional mengubah spreadsheet yang ribet menjadi alur kerja yang rapi, cepat, dan membuat kerja harian jadi jauh lebih ringan — <strong class="text-slate-900 dark:text-slate-100">tanpa beban sewa software bulanan</strong>.
        </p>
        
        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
          Banyak yang tanya, apa hubungannya 17 tahun menjadi Pelatih Paskibra dengan menyusun baris kode sistem? Di lapangan baris-berbaris, aku belajar satu filosofi hidup: <em>ketertiban gerak, evaluasi objektif, dan ketenangan saat menghadapi masalah</em>. Saat merancang sistem, pola pikir itulah yang aku bawa: jangan panik atau menyalahkan alat, tapi bedah alurnya langkah demi langkah sampai beres.
        </p>

        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
          Mulai dari ketahanan sistem operasional <strong>KOMANDO</strong> yang mengelola 147 anggota Paskibra, platform SaaS <strong>G-7KAIH</strong> yang mengawal Gerakan 7 Kebiasaan Indonesia Hebat di MAN Kota Cimahi (871 siswa), kecepatan sistem tabulasi <strong>Si Paling Rekap</strong> berkecepatan 0 detik delay di Kejurcab FORBASI Cimahi 2026, hingga sistem kasir <strong>Si Paling Kasir</strong> di Megumi Hotplate yang bebas biaya sewa server—semuanya dibangun agar simpel dipakai, stabil, dan terbukti tangguh di lapangan.
        </p>

        <!-- Values Badge Bar (Gen Z & Professional Tone) -->
        <div class="flex flex-wrap gap-2.5 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-200">
            <span>🛡️</span> High Integrity &amp; Amanah
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-200">
            <span>📊</span> Data-Driven Decisions
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-200">
            <span>🔍</span> Full Transparency
          </span>
        </div>

        <!-- Local Origin & Friendly CTA -->
        <div class="p-4 sm:p-5 rounded-2xl bg-cyan-50/60 dark:bg-cyan-950/30 border border-cyan-100 dark:border-cyan-900/50 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <div class="text-xs font-bold text-cyan-800 dark:text-cyan-300 flex items-center gap-1.5 mb-1">
              <span>📍</span> Berbasis di Cibeber, Kota Cimahi
            </div>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-normal">
              Punya alur kerja yang bikin pusing tiap malam? Gak usah dipikirin sendirian sampai larut. Ngobrol santai aja bareng aku.
            </p>
          </div>
          
          <a
            href="https://wa.me/6282118313655?text=Halo%20Apri,%20aku%20mau%20ngobrol%20santai%20soal%20alur%20kerja%20bisnis."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto shrink-0 px-4 py-2.5 rounded-xl bg-cyan-600 hover:bg-cyan-700 text-white text-xs font-semibold shadow-sm transition-all flex items-center justify-center gap-1.5 text-center"
          >
            <span>💬 Ngobrol Santai</span>
            <span>→</span>
          </a>
        </div>

      </div>

      <!-- Right Column: 4 Validated Pillars (Google Pixel Harmonic Card Grid) -->
      <div class="lg:col-span-6 grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
        {pillars.map((pillar) => (
          <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:shadow-md hover:border-slate-300 dark:hover:border-slate-700 transition-all flex flex-col justify-between">
            <div>
              <div class="w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-2xl mb-4">
                {pillar.icon}
              </div>
              
              <div class="text-[11px] font-semibold text-cyan-600 dark:text-cyan-400 uppercase tracking-wider mb-1">
                {pillar.subtitle}
              </div>

              <h3 class="type-h3 mb-2">
                {pillar.title}
              </h3>
              
              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                {pillar.description}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
