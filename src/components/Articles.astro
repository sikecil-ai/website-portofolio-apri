---
import { articles } from '../data/articles';

const categories = ['Semua', 'Studi Kasus Paskibra', 'Otomasi Bisnis & F&B', 'AI & Bot Automation', 'Teknologi & Efisiensi'];
---

<section id="artikel" class="relative py-24 sm:py-32 bg-slate-50/50 dark:bg-slate-900/40 border-t border-slate-200/60 dark:border-slate-800/60 overflow-hidden">
  <!-- Subtle ambient glows -->
  <div class="ambient-glow bg-brand-500/10 top-1/4 -left-20 w-96 h-96 animate-pulse-glow"></div>
  <div class="ambient-glow bg-purple-500/10 bottom-20 -right-20 w-96 h-96 animate-pulse-glow" style="animation-delay: 2s;"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-purple-50 dark:bg-purple-950/60 border border-purple-200 dark:border-purple-800 text-purple-600 dark:text-purple-400 text-xs font-semibold uppercase tracking-wider mb-4">
        📚 Cerita Nyata &amp; Studi Kasus
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-slate-50 tracking-tight mb-4">
        Di Balik Layar <span class="text-gradient">7 Proyek &amp; Sistem Otomasi</span>
      </h2>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
        Kisah nyata, tantangan teknis di lapangan, dan filosofi pengembangan sistem tanpa biaya server oleh Kang Apri (@madebyaapri).
      </p>
    </div>

    <!-- Category Filter Bar -->
    <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-10 scrollbar-none justify-start md:justify-center" id="article-filters">
      {categories.map((cat, idx) => (
        <button
          type="button"
          class={`article-filter-btn px-4 py-2 text-xs sm:text-sm font-medium rounded-xl transition-all duration-200 whitespace-nowrap cursor-pointer ${
            idx === 0
              ? 'bg-purple-600 text-white shadow-md shadow-purple-500/30'
              : 'bg-slate-100 dark:bg-slate-800/70 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700'
          }`}
          data-category={cat}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Articles Grid -->
    <div id="articles-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {articles.map((article) => (
        <article
          class="article-card glass-card rounded-3xl p-6 sm:p-7 border border-slate-200/80 dark:border-slate-800/80 bg-white/80 dark:bg-slate-900/60 flex flex-col justify-between group hover:-translate-y-1.5 hover:border-purple-500/40 transition-all duration-300"
          data-category={article.category}
          data-article-json={JSON.stringify(article)}
        >
          <div>
            <!-- Top Meta: Emoji Badge + Category & Reading Time -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <div class="flex items-center gap-2">
                <span class="text-2xl">{article.coverEmoji}</span>
                <span class="px-2.5 py-0.5 text-[11px] font-semibold rounded-lg bg-purple-50 dark:bg-purple-950/70 text-purple-600 dark:text-purple-400 border border-purple-200/60 dark:border-purple-800/60">
                  {article.category}
                </span>
              </div>
              <span class="text-[11px] text-slate-400 font-mono">{article.readTime}</span>
            </div>

            <!-- Title -->
            <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100 group-hover:text-purple-600 dark:group-hover:text-purple-400 transition-colors mb-3 line-clamp-2">
              {article.title}
            </h3>

            <!-- Excerpt -->
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-6 line-clamp-3">
              {article.excerpt}
            </p>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5 mb-6">
              {article.tags.slice(0, 3).map((tag) => (
                <span class="px-2 py-0.5 text-[10px] font-medium rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                  #{tag}
                </span>
              ))}
            </div>
          </div>

          <!-- Bottom Action Button -->
          <div class="pt-4 border-t border-slate-200/60 dark:border-slate-800/60 flex items-center justify-between">
            <span class="text-[11px] text-slate-400 font-mono">{article.projectRelation}</span>
            <button
              type="button"
              class="read-article-btn inline-flex items-center gap-1 text-xs font-bold text-purple-600 dark:text-purple-400 group-hover:translate-x-1 transition-transform cursor-pointer"
            >
              <span>Baca Cerita</span>
              <span>→</span>
            </button>
          </div>
        </article>
      ))}
    </div>

  </div>

  <!-- Interactive Article Reader Modal -->
  <div
    id="article-modal"
    class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 sm:p-6 md:p-10 bg-slate-950/80 backdrop-blur-md opacity-0 transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
    aria-labelledby="article-modal-title"
  >
    <div class="relative w-full max-w-3xl max-h-[90vh] overflow-y-auto bg-white dark:bg-slate-900 rounded-3xl border border-slate-200 dark:border-slate-800 shadow-2xl transform scale-95 transition-transform duration-300 p-6 sm:p-10" id="article-modal-container">
      
      <!-- Close Button -->
      <button
        type="button"
        id="article-modal-close-btn"
        class="absolute top-4 right-4 sm:top-6 sm:right-6 p-2.5 rounded-xl text-slate-400 hover:text-slate-900 dark:hover:text-white bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors cursor-pointer"
        aria-label="Tutup artikel"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Article Header Inside Modal -->
      <div class="flex items-center gap-2 mb-4">
        <span id="article-modal-emoji" class="text-3xl"></span>
        <div>
          <span id="article-modal-category" class="px-2.5 py-0.5 text-xs font-semibold rounded-lg bg-purple-50 dark:bg-purple-950 text-purple-600 dark:text-purple-400 border border-purple-200 dark:border-purple-800"></span>
          <span id="article-modal-readtime" class="text-xs text-slate-400 ml-2 font-mono"></span>
        </div>
      </div>

      <h2 id="article-modal-title" class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-slate-100 mb-4 leading-tight"></h2>

      <!-- Author Attribution -->
      <div class="flex items-center gap-3 pb-6 mb-6 border-b border-slate-200 dark:border-slate-800">
        <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-brand-600 to-purple-600 flex items-center justify-center text-white font-bold text-xs font-mono">
          mba
        </div>
        <div>
          <h4 class="text-xs font-bold text-slate-900 dark:text-slate-100">Ditulis oleh Kang Apri (@madebyaapri)</h4>
          <p class="text-[11px] text-slate-500 dark:text-slate-400">Workflow Automation Specialist • Cibeber, Cimahi Selatan</p>
        </div>
      </div>

      <!-- Article Body Content -->
      <div id="article-modal-content" class="text-slate-700 dark:text-slate-300 text-sm sm:text-base leading-relaxed space-y-4 whitespace-pre-line font-sans mb-8">
      </div>

      <!-- Related Tags -->
      <div class="pt-6 border-t border-slate-200 dark:border-slate-800 mb-8">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-2.5">Topik Terkait</h4>
        <div id="article-modal-tags" class="flex flex-wrap gap-2"></div>
      </div>

      <!-- Call to Action Banner at bottom of article -->
      <div class="p-6 rounded-2xl bg-gradient-to-r from-brand-600/10 via-purple-600/10 to-emerald-600/10 border border-brand-500/30 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h4 class="text-sm font-bold text-slate-900 dark:text-slate-100 mb-0.5">Tertarik menerapkan solusi serupa di bisnis Anda?</h4>
          <p class="text-xs text-slate-500 dark:text-slate-400">Konsultasikan kebutuhan otomasi sistem Anda langsung dengan Kang Apri.</p>
        </div>
        <a
          id="article-modal-wa-btn"
          href="https://wa.me/6282118313655?text=Halo%20Kang%20Apri,%20saya%20baru%20saja%20membaca%20artikel%20studi%20kasus%20Anda%20dan%20tertarik%20berdiskusi."
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary text-xs py-2.5 px-4 whitespace-nowrap"
        >
          <span>💬 Diskusi via WhatsApp</span>
        </a>
      </div>

    </div>
  </div>
</section>

<script>
  const initArticles = () => {
    const filterBtns = document.querySelectorAll('.article-filter-btn');
    const cards = document.querySelectorAll('.article-card') as NodeListOf<HTMLElement>;
    
    // Modal elements
    const modal = document.getElementById('article-modal');
    const modalContainer = document.getElementById('article-modal-container');
    const modalCloseBtn = document.getElementById('article-modal-close-btn');
    const modalEmoji = document.getElementById('article-modal-emoji');
    const modalCategory = document.getElementById('article-modal-category');
    const modalReadtime = document.getElementById('article-modal-readtime');
    const modalTitle = document.getElementById('article-modal-title');
    const modalContent = document.getElementById('article-modal-content');
    const modalTags = document.getElementById('article-modal-tags');
    const modalWaBtn = document.getElementById('article-modal-wa-btn') as HTMLAnchorElement | null;

    let activeCategory = 'Semua';

    // Category Filter
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('bg-purple-600', 'text-white', 'shadow-md', 'shadow-purple-500/30');
          b.classList.add('bg-slate-100', 'dark:bg-slate-800/70', 'text-slate-600', 'dark:text-slate-300');
        });

        btn.classList.remove('bg-slate-100', 'dark:bg-slate-800/70', 'text-slate-600', 'dark:text-slate-300');
        btn.classList.add('bg-purple-600', 'text-white', 'shadow-md', 'shadow-purple-500/30');

        activeCategory = btn.getAttribute('data-category') || 'Semua';

        cards.forEach((card) => {
          const category = card.dataset.category || '';
          if (activeCategory === 'Semua' || category === activeCategory) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Open Reader Modal
    const openReader = (article: any) => {
      if (!modal || !modalTitle || !modalContent || !modalEmoji || !modalCategory || !modalReadtime || !modalTags) return;

      modalEmoji.textContent = article.coverEmoji;
      modalCategory.textContent = article.category;
      modalReadtime.textContent = article.readTime;
      modalTitle.textContent = article.title;
      modalContent.textContent = article.content;

      // Tags
      modalTags.innerHTML = '';
      if (article.tags) {
        article.tags.forEach((tag: string) => {
          const span = document.createElement('span');
          span.className = 'px-2.5 py-1 text-xs font-medium rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700';
          span.textContent = `#${tag}`;
          modalTags.appendChild(span);
        });
      }

      if (modalWaBtn) {
        const text = `Halo Kang Apri, saya baru saja membaca artikel "${article.title}" dan tertarik berkonsultasi mengenai solusi serupa.`;
        modalWaBtn.href = `https://wa.me/6282118313655?text=${encodeURIComponent(text)}`;
      }

      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        modalContainer?.classList.remove('scale-95');
        modalContainer?.classList.add('scale-100');
      }, 10);
      document.body.style.overflow = 'hidden';
    };

    const closeReader = () => {
      if (!modal) return;
      modal.classList.add('opacity-0');
      modalContainer?.classList.remove('scale-100');
      modalContainer?.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
        document.body.style.overflow = '';
      }, 300);
    };

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        if (card.dataset.articleJson) {
          const article = JSON.parse(card.dataset.articleJson);
          openReader(article);
        }
      });
    });

    if (modalCloseBtn) {
      modalCloseBtn.addEventListener('click', closeReader);
    }

    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeReader();
        }
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeReader();
      }
    });
  };

  initArticles();
  document.addEventListener('astro:after-swap', initArticles);
</script>
