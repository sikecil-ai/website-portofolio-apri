---
import { skillGroups } from '../data/skills';
---

<section id="keahlian" class="relative py-24 sm:py-32 bg-white/60 dark:bg-[#070b14]/60 border-t border-slate-200/60 dark:border-slate-800/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-cyan-50 dark:bg-cyan-950/60 border border-cyan-200 dark:border-cyan-800 text-cyan-700 dark:text-cyan-400 text-xs font-semibold uppercase tracking-wider mb-4">
        <span>⚙️</span>
        <span>Fondasi Teknologi Teruji</span>
      </div>
      
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-slate-50 tracking-tight leading-[1.2] mb-4">
        Teknologi &amp; Engine <span class="text-gradient-cyan">di Balik Setiap Sistem</span>
      </h2>
      
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Kombinasi Google Workspace, Google Apps Script, Looker Studio, dan Gemini AI API yang dirancang hemat, tangguh di lapangan, dan tanpa biaya server bulanan.
      </p>
    </div>

    <!-- Skills Group Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      {skillGroups.map((group) => (
        <div class="p-6 sm:p-8 rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm flex flex-col justify-between">
          <div>
            <!-- Group Header -->
            <div class="flex items-center gap-3 mb-4">
              <div class="w-11 h-11 rounded-2xl bg-cyan-50 dark:bg-cyan-950/60 border border-cyan-200/60 dark:border-cyan-800/60 text-cyan-700 dark:text-cyan-400 flex items-center justify-center font-bold text-xl shrink-0">
                {group.icon === 'server' && '⚙️'}
                {group.icon === 'sparkles' && '🤖'}
                {group.icon === 'cloud' && '📊'}
                {group.icon === 'layout' && '⚡'}
              </div>
              <div>
                <h3 class="text-base sm:text-lg font-bold text-slate-900 dark:text-slate-100">
                  {group.category}
                </h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                  {group.description}
                </p>
              </div>
            </div>

            <!-- Skills Pills Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-5">
              {group.skills.map((skill) => (
                <div class="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-700/60 flex flex-col justify-between">
                  <span class="text-xs sm:text-sm font-bold text-slate-800 dark:text-slate-200 mb-2">
                    {skill.name}
                  </span>
                  <div class="flex items-center justify-between pt-1 border-t border-slate-200/60 dark:border-slate-700/60">
                    <span class="text-[10px] font-semibold text-cyan-700 dark:text-cyan-400 font-mono">
                      {skill.level}
                    </span>
                    <span class="text-[10px] text-emerald-500 font-bold">✓ Aktif</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA Bridge -->
    <div class="mt-12 text-center">
      <a
        href="https://wa.me/6282118313655?text=Halo%20Kang%20Apri,%20saya%20tertarik%20mendiskusikan%20arsitektur%20sistem%20otomasi%20tanpa%20biaya%20server."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-semibold text-xs sm:text-sm hover:bg-slate-800 dark:hover:bg-slate-100 shadow-sm transition-all"
      >
        <span>💡 Ingin arsitektur sistem serupa untuk bisnismu?</span>
        <span class="text-cyan-400 dark:text-cyan-600 font-bold">Ngobrol bareng Apri →</span>
      </a>
    </div>

  </div>
</section>
