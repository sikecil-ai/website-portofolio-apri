---
const comparisons = [
  {
    parameter: 'Kecepatan Pengerjaan',
    conventional: '2 – 4 Minggu (Birokrasi tim panjang & lambat)',
    madebyaapri: '3 – 5 Hari Kerja (Agile, langsung siap pakai & uji coba)',
  },
  {
    parameter: 'Biaya Server & Pemeliharaan',
    conventional: 'Wajib sewa cloud bulanan (Rp 300rb – Rp 2jt/bulan)',
    madebyaapri: 'Rp 0 / Bulan Seumur Hidup (Google Workspace Engine)',
  },
  {
    parameter: 'Pemahaman Masalah Lapangan',
    conventional: 'Berdasarkan asumsi meja & teori software steril',
    madebyaapri: 'Praktisi Lapangan Nyata (Teruji di lomba & kedai harian)',
  },
  {
    parameter: 'Fleksibilitas Alur Kerja',
    conventional: 'Tim Anda dipaksa tunduk pada aturan software yang kaku',
    madebyaapri: 'Sistem fleksibel dirancang mengikuti ritme kebiasaan tim Anda',
  },
  {
    parameter: 'Gaya Bahasa Komunikasi',
    conventional: 'Penuh istilah IT rumit & jargon yang membingungkan',
    madebyaapri: 'Bahasa Pemilik Bisnis (Lugas, to-the-point, gampil dipahami)',
  },
  {
    parameter: 'Pendampingan & SOP',
    conventional: 'Diserahkan begitu saja tanpa panduan cara pakai tim',
    madebyaapri: 'Pendampingan sampai lancar + Video panduan + Buku SOP',
  },
];
---

<section id="komparasi" class="py-24 sm:py-32 relative bg-slate-50/60 dark:bg-[#070b14]/60 border-t border-slate-200/60 dark:border-slate-800/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-cyan-50 dark:bg-cyan-950/60 border border-cyan-200 dark:border-cyan-800 text-cyan-700 dark:text-cyan-400 text-xs font-semibold uppercase tracking-wider mb-4">
        <span>⚖️</span>
        <span>Matriks Perbandingan Nilai</span>
      </div>
      
      <h2 class="type-h2 mb-4">
        Kenapa Memilih <span class="text-gradient-cyan">@madebyaapri?</span>
      </h2>
      
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Perbandingan nilai nyata antara menyewa vendor IT konvensional vs bermitra langsung dengan praktisi otomasi alur kerja.
      </p>
    </div>

    <!-- Comparison Table Container (Responsive Mobile Cards + Desktop Table) -->
    <div class="max-w-4xl mx-auto">
      
      <!-- Mobile View (< sm): Responsive Parameter Cards -->
      <div class="sm:hidden space-y-4">
        {comparisons.map((item) => (
          <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
            <h3 class="text-sm font-bold text-slate-900 dark:text-slate-100 mb-3 pb-2 border-b border-slate-100 dark:border-slate-800">
              {item.parameter}
            </h3>
            
            <div class="space-y-2.5 text-xs">
              <div class="p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700/60 text-slate-500 dark:text-slate-400">
                <span class="font-bold text-rose-500 block mb-0.5">✕ Vendor IT Konvensional:</span>
                <span>{item.conventional}</span>
              </div>
              <div class="p-3 rounded-xl bg-cyan-50/70 dark:bg-cyan-950/60 border border-cyan-200/80 dark:border-cyan-800/80 text-slate-900 dark:text-slate-100">
                <span class="font-bold text-cyan-700 dark:text-cyan-400 block mb-0.5">★ Solusi @madebyaapri:</span>
                <span class="font-semibold">{item.madebyaapri}</span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Desktop View (>= sm): 12-Column Grid Table -->
      <div class="hidden sm:block rounded-3xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm">
        <!-- Table Header -->
        <div class="grid grid-cols-12 p-5 lg:p-6 bg-slate-100/90 dark:bg-slate-800/90 border-b border-slate-200 dark:border-slate-700/80 text-xs sm:text-sm font-bold">
          <div class="col-span-4 text-slate-600 dark:text-slate-300">Parameter Kebutuhan</div>
          <div class="col-span-4 text-slate-500 dark:text-slate-400">Vendor IT Konvensional</div>
          <div class="col-span-4 text-cyan-600 dark:text-cyan-400 font-extrabold flex items-center gap-1.5">
            <span>★</span>
            <span>@madebyaapri</span>
          </div>
        </div>

        <!-- Table Rows -->
        <div class="divide-y divide-slate-100 dark:divide-slate-800/80">
          {comparisons.map((item, idx) => (
            <div class={`grid grid-cols-12 p-4 lg:p-6 items-center text-xs sm:text-sm transition-colors ${
              idx % 2 === 0 ? 'bg-transparent' : 'bg-slate-50/40 dark:bg-slate-800/20'
            }`}>
              <div class="col-span-4 font-bold text-slate-900 dark:text-slate-100 pr-2 leading-snug">
                {item.parameter}
              </div>
              <div class="col-span-4 text-slate-500 dark:text-slate-400 pr-2 leading-relaxed text-[11px] sm:text-xs">
                <span class="text-rose-500 font-bold mr-1 shrink-0">✕</span>
                <span>{item.conventional}</span>
              </div>
              <div class="col-span-4 font-medium text-slate-900 dark:text-slate-100 bg-cyan-50/60 dark:bg-cyan-950/40 p-2.5 sm:p-3.5 rounded-xl border border-cyan-100 dark:border-cyan-900/60 leading-relaxed text-[11px] sm:text-xs">
                <span class="text-emerald-500 font-bold mr-1 shrink-0">✓</span>
                <span class="font-semibold text-slate-900 dark:text-slate-100">{item.madebyaapri}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Bottom CTA Bridge -->
    <div class="mt-12 text-center">
      <a
        href="https://wa.me/6282118313655?text=Halo%20Apri,%20aku%20mau%20konsultasi%20upgrade%20alur%20kerja%20bisnis%20tanpa%20biaya%20server%20bulanan."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-semibold text-xs sm:text-sm hover:bg-slate-800 dark:hover:bg-slate-100 shadow-sm transition-all group"
      >
        <span>💡 Ingin upgrade alur kerja tanpa beban biaya server bulanan?</span>
        <span class="text-cyan-400 dark:text-cyan-600 font-bold group-hover:translate-x-1 transition-transform">Ngobrol bareng Apri →</span>
      </a>
    </div>

  </div>
</section>
