---
import { experiences } from '../data/experiences';
---

<section id="rekam-jejak" class="py-24 sm:py-32 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-semibold uppercase tracking-wider mb-4 border border-slate-200 dark:border-slate-700">
        Rekam Jejak &amp; Kredibilitas
      </div>
      <h2 class="type-h2 mb-4">
        Implementasi Nyata &amp; <span class="text-gradient">Dampak Sistem</span>
      </h2>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
        Studi kasus lapangan dan arsitektur otomasi yang terbukti memecahkan masalah operasional nyata.
      </p>
    </div>

    <!-- Timeline Grid -->
    <div class="relative border-l-2 border-slate-200 dark:border-slate-800 ml-4 md:ml-32 space-y-12">
      {experiences.map((item) => (
        <div class="relative pl-6 sm:pl-8 group">
          
          <!-- Timeline Node Dot -->
          <div class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-white dark:bg-slate-950 border-2 border-brand-500 group-hover:scale-125 group-hover:bg-brand-500 transition-all duration-300 shadow-sm"></div>

          <!-- Card Content -->
          <div class="glass-card rounded-2xl p-6 sm:p-7 border border-slate-200/80 dark:border-slate-800/80 bg-white/70 dark:bg-slate-900/60 transition-all duration-300 hover:border-brand-500/40">
            
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
              <div>
                <h3 class="type-h3">
                  {item.role}
                </h3>
                <div class="text-xs sm:text-sm font-semibold text-brand-600 dark:text-brand-400">
                  {item.company}
                </div>
              </div>
              <span class="inline-block px-3 py-1 text-xs font-mono font-medium rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 self-start sm:self-auto">
                {item.period}
              </span>
            </div>

            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
              {item.description}
            </p>

            <!-- Highlights -->
            {item.highlights && item.highlights.length > 0 && (
              <ul class="space-y-1.5 mb-4 text-xs sm:text-sm text-slate-600 dark:text-slate-400">
                {item.highlights.map((highlight) => (
                  <li class="flex items-start gap-2">
                    <span class="text-brand-500 font-bold">✓</span>
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            )}

            <!-- Tech Badges -->
            <div class="flex flex-wrap gap-1.5 pt-2 border-t border-slate-200/60 dark:border-slate-800/60">
              {item.technologies.map((tech) => (
                <span class="px-2.5 py-0.5 text-[11px] font-medium rounded-lg bg-slate-100 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60">
                  {tech}
                </span>
              ))}
            </div>

          </div>

        </div>
      ))}
    </div>

  </div>
</section>
